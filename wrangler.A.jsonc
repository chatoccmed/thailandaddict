{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thailandaddict",
  // Emergency path back to account A (chatmaliwan) during the zone move: npx wrangler deploy -c wrangler.A.jsonc
  "account_id": "46cdce4b7061ce5424b187cf9353ba92",
  "main": "worker.js",
  "compatibility_date": "2026-05-16",
  "assets": {
    "directory": "./astro/dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    // Old WP URLs that are also built pages: the Worker must answer first so their 301 still wins.
    // Kept in step by _internal/gen-legacy-redirects.mjs (it fails if one is missing).
    "run_worker_first": ["/top10-hotels-pattaya","/top10-hotels-pattaya/","/top10-hotels-phetchaburi","/top10-hotels-phetchaburi/","/top10-hotels-prachuap-khiri-khan","/top10-hotels-prachuap-khiri-khan/","/top5-krabi-airport-hotels","/top5-krabi-airport-hotels/"]
  },
  "ai": { "binding": "AI" },
  "kv_namespaces": [{ "binding": "TRIPS", "id": "fc95757f7ce54294a1b9af14f8f69c2f" }],
  "ratelimits": [
    { "name": "RL_PLAN", "namespace_id": "2001", "simple": { "limit": 15, "period": 60 } },
    { "name": "RL_WRITE", "namespace_id": "2002", "simple": { "limit": 40, "period": 60 } }
  ]
}
