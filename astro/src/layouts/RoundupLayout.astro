---
import '../styles/roundup.css';
import type { CollectionEntry } from 'astro:content';
import Analytics from '../components/Analytics.astro';
import editorial from '../data/editorial.json';
import webpManifest from '../data/webp-manifest.json';
// Serve a webp twin when one exists (pilot: top 150 most-referenced images, see _internal/DEVELOPMENT-PLAN-v4-revenue.md).
// Gated on the manifest so we never request a .webp that doesn't exist on R2 — <picture> falls back to the original if missing anyway,
// but the manifest avoids a doomed request for the ~14k images not yet converted.
const hasWebp = (p: string) => !!(p && (webpManifest as Record<string, number>)[String(p).replace(/^\//, '')]);
const webpOf = (p: string) => p.replace(/\.(jpg|jpeg|png)$/i, '.webp');

interface Props {
  data: CollectionEntry<'roundups'>['data'];
  lang?: 'th' | 'en';
}
const { data, lang = 'th' } = Astro.props;
const isEn = lang === 'en';

const SITE = 'https://thailandaddict.com';
const IMG_BASE = import.meta.env.PUBLIC_IMG_BASE || 'https://pub-65cf98dcb15e4c06a7a465ec411b870a.r2.dev';   // R2 public bucket (override via PUBLIC_IMG_BASE env)
const base = isEn ? `${SITE}/en` : SITE;
const url = `${base}/${data.slug}`;
const imgAbs = `${IMG_BASE || SITE}/${data.image}`;
// AEO answer block — derive an extractable, Speakable "#1 pick" answer from the TOC when there's no hand-written quickAnswerHtml.
const _n1 = (data.toc && data.toc[0]) ? data.toc[0] : null;
const _tocN = (data.toc || []).length;
const _derivedQA = (!(data as any).quickAnswerHtml && _n1 && _n1.name)
  ? (isEn
      ? `Our #1 pick is <strong>${_n1.name}</strong>${_n1.price ? ` (${_n1.price})` : ''} · from ${_tocN} places compared in this guide`
      : `อันดับ 1 คือ <strong>${_n1.name}</strong>${_n1.price ? ` (${_n1.price})` : ''} · คัดจากทั้งหมด ${_tocN} ที่ในบทความนี้`)
  : '';
const qaHtml = (data as any).quickAnswerHtml || _derivedQA;
// EEAT — named editor (gated: falls back to Organization author until editorial.json holds a real name).
const _ed = (editorial as any).editor || {};
const hasEditor = !!String(_ed.name || _ed.nameEn || '').trim();
const _edName = (isEn ? (_ed.nameEn || _ed.name) : (_ed.name || _ed.nameEn)) || '';
const _edRole = (isEn ? (_ed.roleEn || _ed.role) : (_ed.role || _ed.roleEn)) || '';
const authorNode: any = hasEditor
  ? { '@type': 'Person', name: _edName, jobTitle: _edRole, url: `${base}/about`, worksFor: { '@id': `${SITE}/#org` },
      ...(String(_ed.image || '').trim() ? { image: `${IMG_BASE || SITE}/${String(_ed.image).replace(/^\//, '')}` } : {}),
      ...(Array.isArray(_ed.sameAs) && _ed.sameAs.length ? { sameAs: _ed.sameAs } : {}) }
  : { '@type': 'Organization', name: 'ThailandAddict Editorial' };
// Prefer a real per-roundup date over the shared fallback — every roundup otherwise showed the identical stamp.
const today = (data as any).modifiedDate || '2026-05-17';

// Internal-link helper: Thai keeps the raw href, English gets an /en/ prefix
// and the .html suffix stripped (clean URL).
const link = (h: string) => {
  if (h === '/' || h === '') return isEn ? '/en/' : '/';
  if (/^(https?:)?\/\//.test(h) || h.startsWith('#')) return h;
  if (!isEn) return h;
  // Normalise then add a single /en/ prefix — robust to inputs already stored as
  // "/en/review-x" (avoids the /en//en/... double-prefix bug), "/review-x" or "review-x.html".
  let p = h.replace(/\.html$/, '').replace(/^\/en\//, '/');
  if (!p.startsWith('/')) p = '/' + p;
  return '/en' + p;
};

// Booking.com (Thailand publishers) pays ONLY via CJ (Commission Junction) — the legacy ?aid= programme
// does not credit. Entries keep canonical booking.com URLs; this wraps them into a CJ deep link at render
// time (single point of change). sid = page slug → per-page revenue attribution in CJ Reports.
const CJ_PID = '101809619';  // ThailandAddict website id on CJ · advertiser: Booking.com APAC (7854081)
const CJ_ADID = '17289009';  // active text-link id from our CJ account (click-format deep link, production-proven)
const cjSid = ((isEn ? 'en-' : '') + String(data.slug || 'site')).replace(/[^a-zA-Z0-9_-]/g, '').slice(0, 60);
const cjBooking = (u: string) => (u && /booking\.com/.test(u))
  ? `https://www.anrdoezrs.net/click-${CJ_PID}-${CJ_ADID}?sid=${cjSid}&url=${encodeURIComponent(u)}`
  : u;

// Domain-aware booking buttons (honesty-first): the label must match where the link actually goes.
// Rural stays not on any OTA carry their real booking channel (Facebook page / own site / Tripadvisor)
// in the agoda/booking/trip fields — so label each button by its destination domain, and de-duplicate
// identical hrefs. OTA hotels (the vast majority) render exactly as before: Agoda / Booking.com / Trip.com.
const bookButtons = (e: any) => {
  const out: any[] = [], seen = new Set();
  for (const u of [e.agodaUrl, e.bookingUrl, e.tripUrl]) {
    if (!u) continue;
    let b;
    if (/agoda\.com/.test(u))         b = { href: cjBooking(u), label: S.btnAgoda,   cls: 'btn-main', mark: 'a',  markCls: 'bk-mark r' };
    else if (/booking\.com/.test(u))  b = { href: cjBooking(u), label: 'Booking.com', cls: 'btn-sec',  mark: 'B.', markCls: 'bk-mark sq' };
    else if (/trip\.com/.test(u))     b = { href: cjBooking(u), label: 'Trip.com',    cls: 'btn-trip', mark: 't',  markCls: 'bk-mark sq' };
    else {
      const label = /facebook\.com/.test(u) ? S.btnFacebook
                  : /tripadvisor/.test(u)   ? 'Tripadvisor'
                  : /trivago/.test(u)       ? 'Trivago'
                  : /choowap/.test(u)       ? 'Choowap'
                  : /traveloka/.test(u)     ? 'Traveloka'
                  : S.btnDirect;
      b = { href: u, label, cls: 'btn-trip', mark: '↗', markCls: 'bk-mark sq' };
    }
    if (seen.has(b.href)) continue;
    seen.add(b.href);
    out.push(b);
  }
  return out;
};

// Asset (image) helper: force a root-absolute path so images resolve
// correctly from both / (Thai) and /en/ (English) pages.
const asset = (p: string) => (!p ? p : (/^(https?:)?\/\//.test(p) ? p : IMG_BASE + (/^\//.test(p) ? p : `/${p}`)));

// World Cup 2026 cross-link: connect host-city hotel roundups (themed + near-stadium)
// to the WC city guide + stadium transport page. City derived from the slug.
const WC_CITY: Record<string, {th:string;en:string;st:string;stn:string}> = {
  atlanta:{th:'แอตแลนตา',en:'Atlanta',st:'mercedes-benz-stadium',stn:'Mercedes-Benz Stadium'},
  boston:{th:'บอสตัน',en:'Boston',st:'gillette-stadium',stn:'Gillette Stadium'},
  dallas:{th:'ดัลลัส',en:'Dallas',st:'att-stadium',stn:'AT&T Stadium'},
  houston:{th:'ฮูสตัน',en:'Houston',st:'nrg-stadium',stn:'NRG Stadium'},
  'kansas-city':{th:'แคนซัสซิตี้',en:'Kansas City',st:'arrowhead-stadium',stn:'Arrowhead Stadium'},
  'los-angeles':{th:'ลอสแอนเจลิส',en:'Los Angeles',st:'sofi-stadium',stn:'SoFi Stadium'},
  miami:{th:'ไมอามี',en:'Miami',st:'hard-rock-stadium',stn:'Hard Rock Stadium'},
  'new-york':{th:'นิวยอร์ก',en:'New York',st:'metlife-stadium',stn:'MetLife Stadium'},
  philadelphia:{th:'ฟิลาเดลเฟีย',en:'Philadelphia',st:'lincoln-financial-field',stn:'Lincoln Financial Field'},
  'san-francisco':{th:'ซานฟรานซิสโก',en:'San Francisco',st:'levis-stadium',stn:"Levi's Stadium"},
  seattle:{th:'ซีแอตเทิล',en:'Seattle',st:'lumen-field',stn:'Lumen Field'},
  'mexico-city':{th:'เม็กซิโกซิตี้',en:'Mexico City',st:'estadio-azteca',stn:'Estadio Azteca'},
  guadalajara:{th:'กวาดาลาฮารา',en:'Guadalajara',st:'estadio-akron',stn:'Estadio Akron'},
  monterrey:{th:'มอนเตร์เรย์',en:'Monterrey',st:'estadio-bbva',stn:'Estadio BBVA'},
  toronto:{th:'โตรอนโต',en:'Toronto',st:'bmo-field',stn:'BMO Field'},
  vancouver:{th:'แวนคูเวอร์',en:'Vancouver',st:'bc-place-vancouver',stn:'BC Place'},
};
const WC_STAD: Record<string,string> = {
  'mercedes-benz-stadium-atlanta':'atlanta','gillette-stadium':'boston','att-stadium':'dallas',
  'nrg-stadium':'houston','arrowhead-stadium':'kansas-city','sofi-stadium':'los-angeles',
  'hard-rock-stadium':'miami','metlife-stadium':'new-york','lincoln-financial-field':'philadelphia',
  'levis-stadium':'san-francisco','lumen-field':'seattle','estadio-azteca':'mexico-city',
  'estadio-akron':'guadalajara','estadio-bbva':'monterrey','bmo-field':'toronto','bc-place-vancouver':'vancouver',
};
function wcFromSlug(s: string): string | null {
  const m = s.match(/^top\d+-(?:luxury|budget|family|mid-range|romantic|boutique)-hotels-(.+)$/);
  if (m && WC_CITY[m[1]]) return m[1];
  if (s.startsWith('hotels-near-')) return WC_STAD[s.slice('hotels-near-'.length)] || null;
  return null;
}
const wcCity = wcFromSlug(data.slug);
const wc = wcCity ? WC_CITY[wcCity] : null;

// UI strings
const S = {
  th: {
    navDest: 'จุดหมาย', navAbout: 'เกี่ยวกับเรา', navCta: 'ค้นหาโรงแรม',
    mmHome: 'หน้าแรก', mmContact: 'ติดต่อ',
    tocTitle: 'สารบัญ — คลิกเพื่อข้ามไปอ่านได้เลย!',
    priceLabel: 'ราคาเริ่มต้น',
    btnAgoda: 'จองผ่าน Agoda', btnFacebook: 'จองผ่าน Facebook', btnDirect: 'จองกับที่พักโดยตรง', btnText: '📖 อ่านรีวิวเต็ม →', imgBook: '🛏️ ดูห้องว่าง',
    prosTitle: '👍 จุดเด่น', consTitle: '👎 ข้อสังเกต',
    faqEyebrow: 'คำถามที่พบบ่อย',
    bylinePublished: 'เผยแพร่',
    bylineUpdated: 'อัปเดต',
    bylineReadTime: 'อ่าน',
    quickAnswerEyebrow: 'คำตอบสั้นๆ',
    methodologyLabel: 'วิธีการคัดเลือก · ตรวจสอบ · การเปิดเผย',
    wishWord: '🔖 เก็บลงแผน', wishSaved: '✓ เก็บแล้ว',
    sourcesTitle: 'แหล่งอ้างอิง · Sources & Citations',
    aboutAuthorTitle: 'เกี่ยวกับผู้เขียน',
    ftTag: 'Thailand, Done Right',
    ftDesc: 'รีวิวโรงแรมและที่เที่ยวทั่วโลก โดยผู้เชี่ยวชาญ พร้อมราคาจริงและลิงก์จองตรง ไม่มีโฆษณาแฝง',
    ftHeadDest: 'จุดหมาย', ftHeadReviews: 'รีวิวโรงแรม', ftHeadAbout: 'เกี่ยวกับ',
    ftR1: '12 Hostel ไทเป', ftR2: 'Top 10 ซีเหมินติง', ftR3: '5 ที่พักชิงจิ้ง',
    ftBottom: '© 2025–2026 thailandaddict.com — Thailand, Done Right · อัปเดตล่าสุด พ.ค. 2026',
    ftAff: '⚡ ThailandAddict เป็น affiliate partner ของ Agoda, Booking.com และ Trip.com — เราอาจได้รับค่าคอมมิชชั่นเมื่อคุณจองผ่านลิงก์ในเว็บ โดยไม่มีค่าใช้จ่ายเพิ่มสำหรับคุณ รีวิวและการจัดอันดับเป็นอิสระจากการสนับสนุนใดๆ',
    mbarBook: '🔴 จองผ่าน Agoda', mbarAll: 'ดูรีวิวทั้งหมด',
  },
  en: {
    navDest: 'Destinations', navAbout: 'About', navCta: 'Find a Hotel',
    mmHome: 'Home', mmContact: 'Contact',
    tocTitle: 'Contents — click to jump straight to a hotel!',
    priceLabel: 'Starting price',
    btnAgoda: 'Book via Agoda', btnFacebook: 'Book via Facebook', btnDirect: 'Book direct with the stay', btnText: '📖 Read the full review →', imgBook: '🛏️ Check availability',
    prosTitle: '👍 Pros', consTitle: '👎 Things to note',
    faqEyebrow: 'Frequently Asked Questions',
    bylinePublished: 'Published',
    bylineUpdated: 'Updated',
    bylineReadTime: 'Read time',
    quickAnswerEyebrow: 'Quick Answer',
    methodologyLabel: 'How we picked · Verification · Disclosure',
    wishWord: '🔖 Save to plan', wishSaved: '✓ Saved',
    sourcesTitle: 'Sources & Citations',
    aboutAuthorTitle: 'About the author',
    ftTag: 'Thailand, Done Right',
    ftDesc: 'Hotel and destination reviews worldwide, by experts — with real prices and direct booking links. No hidden ads.',
    ftHeadDest: 'Destinations', ftHeadReviews: 'Hotel Reviews', ftHeadAbout: 'About',
    ftR1: '12 Hostels in Taipei', ftR2: 'Top 10 Ximending', ftR3: '5 Cingjing Stays',
    ftBottom: '© 2025–2026 thailandaddict.com — Thailand, Done Right · Last updated May 2026',
    ftAff: '⚡ ThailandAddict is an affiliate partner of Agoda, Booking.com and Trip.com — we may earn a commission when you book through links on the site, at no extra cost to you. Our reviews and rankings remain independent of any sponsorship.',
    mbarBook: '🔴 Book via Agoda', mbarAll: 'See all reviews',
  },
}[lang];

const reviewAbs = (h: string) => `${base}/${h.replace(/\.html$/, '')}`;

// Trip-planner ("ta_wishlist") wiring — derive the province for each saved hotel
// from the breadcrumb. The "city-<slug>.html" crumb gives the province slug
// (data-city) + its display name (data-province), matching the shape that
// ReviewLayout's .btn-wish writes ({city: slug, province: displayName}).
const cityCrumb = data.breadcrumb.find((b) => /(?:^|\/)city-[a-z0-9-]+\.html$/i.test(b.href || ''));
const wishCitySlug = cityCrumb && cityCrumb.href
  ? cityCrumb.href.replace(/^.*\/?city-/i, '').replace(/\.html$/i, '')
  : '';
const wishProvince = cityCrumb ? cityCrumb.name : '';
// Strip a review href down to the bare slug used as the wishlist key:
// drop a leading "/" or "/en/" and the trailing ".html".
const wishSlug = (h: string) => (h || '').replace(/^\/?(?:en\/)?/, '').replace(/\.html$/i, '');

const itemList = {
  '@type': 'ItemList',
  '@id': url,
  name: data.metaDesc,
  url,
  numberOfItems: data.entries.length,
  itemListElement: data.entries.map((e, i) => ({
    '@type': 'ListItem', position: i + 1,
    url: e.reviewUrl ? reviewAbs(e.reviewUrl) : url, name: e.name,
  })),
};
const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: data.breadcrumbSchema.map((b, i) => ({
    '@type': 'ListItem', position: i + 1, name: b.name, item: b.item,
  })),
};
const article = {
  '@type': 'Article', headline: data.ogTitle, description: data.metaDesc, image: imgAbs,
  author: authorNode,
  publisher: { '@type': 'Organization', '@id': `${SITE}/#org`, name: 'ThailandAddict', url: SITE, logo: { '@type': 'ImageObject', url: `${SITE}/logo.png` } },
  datePublished: today, dateModified: today, inLanguage: lang, articleSection: 'Hotel Reviews',
};
const speakable = qaHtml ? [{ '@type': 'WebPage', '@id': `${url}#webpage`, url, speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.qa-body'] } }] : [];
const schema = { '@context': 'https://schema.org', '@graph': [itemList, breadcrumb, article, ...speakable] };
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: data.faq.map((f) => ({
    '@type': 'Question', name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const favSvg = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%2306B6D4'/%3E%3Ctext x='50' y='66' font-family='Georgia,serif' font-size='58' font-weight='bold' fill='white' text-anchor='middle'%3EW%3C/text%3E%3C/svg%3E";

// Author shape may vary — guard each field; bio prefers EN field for /en/ pages when available.
const author = (data as any).author;
const authorBio = author ? (isEn && author.bioEn ? author.bioEn : (author.bio || '')) : '';
// EEAT: always show an editorial byline + fact-checked badge on roundups, even without a named author.
// (The bottom author-bio box stays gated on a real `author` — no fabricated bio.)
const by = author || (hasEditor
  ? { name: _edName, jobTitle: _edRole, url: `${base}/about`, avatar: String(_ed.image || '').trim() }
  : { name: isEn ? 'ThailandAddict Editorial Team' : 'ทีมบรรณาธิการ ThailandAddict', jobTitle: isEn ? 'Hotel reviews & rankings' : 'รีวิว & จัดอันดับโรงแรม' });
const factCheckedL = isEn ? '✓ Fact-checked' : '✓ ตรวจสอบแล้ว';

// Faceted filter (budget / stars) — derived from existing entry fields, no content-file changes needed.
// Mirrors the .rfilter pattern already proven on eat-ranking pages (ArticleLayout), adapted to hotel data.
function starTier(stars: string): string { return String(stars || '').split('⭐').length - 1 + ''; }
function priceTier(priceBig: string): string {
  const n = +String(priceBig || '').replace(/[^\d]/g, '');
  if (!n) return '';
  if (n < 1500) return isEn ? '฿ Budget' : '฿ ประหยัด';
  if (n < 3500) return isEn ? '฿฿ Mid-range' : '฿฿ กลาง ๆ';
  if (n < 7000) return isEn ? '฿฿฿ Upscale' : '฿฿฿ ระดับสูง';
  return isEn ? '฿฿฿฿ Luxury' : '฿฿฿฿ หรู';
}
const PRICE_ORDER = [isEn ? '฿ Budget' : '฿ ประหยัด', isEn ? '฿฿ Mid-range' : '฿฿ กลาง ๆ', isEn ? '฿฿฿ Upscale' : '฿฿฿ ระดับสูง', isEn ? '฿฿฿฿ Luxury' : '฿฿฿฿ หรู'];
const entryStars = data.entries.map((e: any) => starTier(e.stars));
const entryPrices = data.entries.map((e: any) => priceTier(e.priceBig));
const starOpts = [...new Set(entryStars.filter(Boolean))].sort((a, b) => +b - +a);
const priceOpts = PRICE_ORDER.filter((p) => entryPrices.includes(p));
const showRoundupFilter = data.entries.length >= 4 && (starOpts.length >= 2 || priceOpts.length >= 2);
const RF_S = { th: { star: 'ดาว', price: 'งบ', all: 'ทั้งหมด', countTpl: 'แสดง {s} จาก {t} ที่' }, en: { star: 'Stars', price: 'Budget', all: 'All', countTpl: 'Showing {s} of {t}' } }[isEn ? 'en' : 'th'];
// Normalize sources into array of strings (the schema allows any · pilot uses string[]).
const sources: any[] = Array.isArray((data as any).sourcesAndCitations) ? (data as any).sourcesAndCitations : [];
// Helper: split "Label — URL" into { label, url } if separator found; else treat full string as label only.
const splitSource = (s: any): { label: string; url: string | null } => {
  if (typeof s !== 'string') {
    // object form: { label, url } passthrough
    if (s && typeof s === 'object' && (s.url || s.label)) return { label: String(s.label || s.url), url: s.url || null };
    return { label: String(s), url: null };
  }
  const m = s.match(/^(.*?)\s+—\s+(https?:\/\/\S+)$/);
  if (m) return { label: m[1].trim(), url: m[2].trim() };
  const mUrl = s.match(/(https?:\/\/\S+)/);
  if (mUrl) return { label: s.replace(mUrl[1], '').replace(/[—\-:]+\s*$/, '').trim() || mUrl[1], url: mUrl[1] };
  return { label: s, url: null };
};
---
<!DOCTYPE html>
<html lang={lang}>
<head>
<meta charset="UTF-8" />
<Analytics />
<meta name="viewport" content="width=device-width,initial-scale=1.0" />
<title>{data.title}</title>
<meta name="description" content={data.metaDesc} />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={url} />
<link rel="alternate" hreflang="th" href={`${SITE}/${data.slug}`} />
<link rel="alternate" hreflang="en" href={`${SITE}/en/${data.slug}`} />
<link rel="alternate" hreflang="x-default" href={`${SITE}/${data.slug}`} />
<meta property="og:type" content="article" />
<meta property="og:title" content={data.ogTitle} />
<meta property="og:description" content={data.ogDesc} />
<meta property="og:url" content={url} />
<meta property="og:site_name" content="ThailandAddict" />
<meta property="og:image" content={imgAbs} />
<meta property="og:locale" content={isEn ? 'en_US' : 'th_TH'} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="theme-color" content="#06B6D4" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
<link rel="icon" type="image/svg+xml" href={favSvg} />
<link rel="preload" as="image" href={asset(data.heroImg)} fetchpriority="high" />
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
{(data as any).jsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify((data as any).jsonLd)} />
)}
<style>
.lang-sw{display:inline-flex;align-items:center;border-radius:999px;overflow:hidden;border:1.5px solid #06B6D4;font-family:'Outfit',sans-serif;font-size:12px;font-weight:700;flex-shrink:0;}
.lang-sw a,.lang-sw .dis{padding:5px 9px;text-decoration:none;line-height:1.5;}
.lang-sw a{color:#06B6D4;background:#ffffff;transition:background .15s;}
.lang-sw a:hover{background:rgba(6,182,212,.08);}
.lang-sw a.on{background:#06B6D4;color:#fff;}
.lang-sw a.on:hover{background:#0891b2;}
.lang-sw .dis{color:#94a3b8;background:#f1fbfd;cursor:not-allowed;}
.mm-lang{margin:10px 0 4px;font-size:13px;align-self:flex-start;flex-wrap:wrap;}
.mm-lang a,.mm-lang .dis{padding:8px 13px;}

/* ===== Skill-compliant additions (Wave 2026+) ===== */
/* All rules below are SCOPED to new classes; existing roundup CSS is untouched. */

/* Byline strip */
.byline-strip{display:flex;align-items:center;flex-wrap:wrap;gap:14px;background:#ffffff;border:1px solid var(--bdr,#e6eef2);border-radius:18px;padding:13px 18px;margin:22px 0 18px;box-shadow:0 6px 20px rgba(6,182,212,.07)}
.byline-avatar{width:46px;height:46px;border-radius:50%;background:linear-gradient(135deg,#06B6D4,#FBBF24);display:flex;align-items:center;justify-content:center;color:#fff;font-family:'Outfit',sans-serif;font-size:20px;font-weight:800;flex-shrink:0;overflow:hidden}
.byline-avatar img{width:100%;height:100%;object-fit:cover}
.byline-text{flex:1;min-width:170px}
.byline-name{font-family:'Outfit',sans-serif;font-size:14.5px;font-weight:700;color:#0F172A;line-height:1.3}
.byline-name a{color:#0F172A;border-bottom:1px dotted #94a3b8}
.byline-name a:hover{color:#06B6D4;border-bottom-color:#06B6D4}
.byline-job{font-size:12px;color:#94a3b8;font-family:'Outfit',sans-serif;margin-top:2px}
.fact-badge{display:inline-block;margin-left:8px;font-family:'Outfit',sans-serif;font-size:10.5px;font-weight:700;color:#0891b2;background:#cffafe;border:1px solid #a5f3fc;border-radius:999px;padding:2px 9px;vertical-align:middle;white-space:nowrap}
.byline-meta{font-family:'Outfit',sans-serif;font-size:12px;color:#64748b;display:flex;flex-wrap:wrap;gap:6px 14px}
.byline-meta span strong{color:#0F172A;font-weight:600}

/* Quick-answer (P4 direct answer · above the fold) */
.quick-answer{background:linear-gradient(180deg,#f1fbfd 0%,#ffffff 100%);border:1px solid #cbeef5;border-left:5px solid #06B6D4;border-radius:18px;padding:20px 24px;margin:18px 0 22px;box-shadow:0 8px 24px rgba(6,182,212,.10)}
.qa-eyebrow{display:inline-block;font-family:'Outfit',sans-serif;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:#0891b2;font-weight:700;background:#ffffff;padding:3px 11px;border-radius:999px;border:1px solid #cbeef5;margin-bottom:10px}
.quick-answer h2{font-family:'Outfit',sans-serif;font-size:22px;font-weight:800;color:#0F172A;line-height:1.25;margin-bottom:10px}
.qa-body{font-size:15.5px;line-height:1.8;color:#0F172A}
.qa-body strong{color:#0891b2;font-weight:700}
.qa-body a{color:#0891b2;text-decoration:underline;text-decoration-color:rgba(6,182,212,.4);text-underline-offset:2px}
.qa-body a:hover{text-decoration-color:#06B6D4}

/* Article meta / EEAT box (methodology + last verified + disclosure) */
.article-meta-box{background:#f1fbfd;border:1px solid #e6eef2;border-radius:18px;padding:16px 20px;margin:20px 0 26px;font-size:13.25px;line-height:1.75;color:#64748b}
.article-meta-label{font-family:'Outfit',sans-serif;font-size:10.5px;letter-spacing:1.5px;text-transform:uppercase;color:#94a3b8;font-weight:700;margin-bottom:10px;display:block}
.article-meta-row{padding:7px 0;border-top:1px solid #e6eef2}
.article-meta-row:first-of-type{border-top:none;padding-top:2px}
.article-meta-row strong{color:#0F172A;font-weight:700}
.article-meta-row a{color:#06B6D4;text-decoration:underline;text-underline-offset:2px}

/* Comparison table — top (above entries · at-a-glance) */
.compare-top{margin:8px 0 32px}
.compare-top .compare-title{font-family:'Outfit',sans-serif;font-size:22px;font-weight:800;color:#0F172A;margin-bottom:14px;display:flex;align-items:center;gap:10px}
.compare-top .compare-title::before{content:'⚡';font-size:20px}
.compare-top .table-wrap{background:#ffffff;border:1px solid #e6eef2;border-radius:18px;overflow:hidden;overflow-x:auto;box-shadow:0 8px 28px rgba(6,182,212,.08)}
.compare-top table{width:100%;border-collapse:collapse;font-size:13.25px}
.compare-top th{background:linear-gradient(90deg,#0891b2,#06B6D4);padding:12px 14px;text-align:left;font-family:'Outfit',sans-serif;font-size:11px;letter-spacing:1px;text-transform:uppercase;color:#fff;font-weight:700;white-space:nowrap}
.compare-top td{padding:11px 14px;border-bottom:1px solid #e6eef2;vertical-align:middle}
.compare-top tr:last-child td{border-bottom:none}
.compare-top tbody tr:nth-child(even) td{background:#f1fbfd}
.compare-top tbody tr:hover td{background:rgba(6,182,212,.08)}
.compare-top .ct-rank{font-family:'Outfit',sans-serif;font-weight:800;color:#0F172A;white-space:nowrap}
.compare-top .ct-book{display:inline-flex;align-items:center;gap:5px;background:linear-gradient(135deg,#FB7185,#f43f5e);color:#fff;font-family:'Outfit',sans-serif;font-size:11.5px;font-weight:700;padding:5px 10px;border-radius:999px;white-space:nowrap;box-shadow:0 4px 12px rgba(251,113,133,.3)}
.compare-top .ct-book:hover{background:linear-gradient(135deg,#f43f5e,#e11d48);transform:translateY(-1px)}

/* Comparison insights (P4 sentences for AI extraction) */
.compare-insights{background:#ffffff;border:1px solid #e6eef2;border-left:4px solid #FBBF24;border-radius:18px;padding:22px 26px;margin:22px 0 18px;box-shadow:0 6px 22px rgba(6,182,212,.07)}
.compare-insights h2{font-family:'Outfit',sans-serif;font-size:21px;font-weight:800;color:#0F172A;margin-bottom:12px;display:flex;align-items:center;gap:8px}
.compare-insights h2::before{content:'🧠';font-size:18px}
.compare-insights-body{font-size:14.75px;line-height:1.85;color:#64748b}
.compare-insights-body p{margin:0 0 10px}
.compare-insights-body p:last-child{margin-bottom:0}
.compare-insights-body strong{color:#0F172A;font-weight:700}

/* Persona closing (Dr Chat conversational summary) */
.persona-closing{background:linear-gradient(180deg,#f1fbfd 0%,#ffffff 100%);border:1px solid #cbeef5;border-radius:18px;padding:26px 28px;margin:30px 0 18px;box-shadow:0 8px 26px rgba(6,182,212,.09)}
.persona-closing h2{font-family:'Outfit',sans-serif;font-size:22px;font-weight:800;color:#0F172A;margin-bottom:12px;display:flex;align-items:center;gap:10px}
.persona-closing h2::before{content:'💬';font-size:20px}
.persona-body{font-size:14.75px;line-height:1.85;color:#0F172A}
.persona-body p{margin:0 0 12px}
.persona-body ul{list-style:none;padding:0;margin:0 0 12px;display:flex;flex-direction:column;gap:8px}
.persona-body ul li{position:relative;padding:9px 14px 9px 32px;background:#f1fbfd;border:1px solid #cbeef5;border-radius:12px;font-size:14px;line-height:1.7;color:#0F172A}
.persona-body ul li::before{content:'→';position:absolute;left:11px;top:9px;color:#06B6D4;font-weight:800;font-family:'Outfit',sans-serif}
.persona-body strong{color:#0891b2;font-weight:700}
.persona-body a{color:#0891b2;text-decoration:underline}

/* Sources & citations */
.sources-box{background:#ffffff;border:1px solid #e6eef2;border-radius:18px;padding:20px 24px;margin:26px 0 8px;box-shadow:0 6px 20px rgba(6,182,212,.07)}
.sources-box h2{font-family:'Outfit',sans-serif;font-size:12.5px;letter-spacing:1.5px;text-transform:uppercase;color:#94a3b8;font-weight:700;margin-bottom:12px;display:flex;align-items:center;gap:8px}
.sources-box h2::before{content:'📚'}
.sources-list{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:5px}
.sources-list li{font-size:12.5px;line-height:1.7;color:#64748b;padding:4px 0;border-bottom:1px dashed #e6eef2}
.sources-list li:last-child{border-bottom:none}
.sources-list a{color:#06B6D4;text-decoration:none;word-break:break-all}
.sources-list a:hover{text-decoration:underline}
.sources-list .src-label{color:#0F172A;font-weight:600}

/* Author bio (bottom of article) */
.author-bio-box{background:linear-gradient(180deg,#ffffff 0%,#f1fbfd 100%);border:1px solid #e6eef2;border-radius:18px;padding:22px 26px;margin:30px 0 14px;display:flex;gap:18px;align-items:flex-start;box-shadow:0 8px 26px rgba(6,182,212,.08)}
@media(max-width:520px){.author-bio-box{flex-direction:column;gap:14px;align-items:center;text-align:center}}
.author-bio-avatar{width:78px;height:78px;border-radius:50%;background:linear-gradient(135deg,#06B6D4,#FBBF24);display:flex;align-items:center;justify-content:center;color:#fff;font-family:'Outfit',sans-serif;font-size:32px;font-weight:800;flex-shrink:0;overflow:hidden;box-shadow:0 6px 18px rgba(6,182,212,.28)}
.author-bio-avatar img{width:100%;height:100%;object-fit:cover}
.author-bio-content{flex:1}
.author-bio-eyebrow{font-family:'Outfit',sans-serif;font-size:10.5px;letter-spacing:1.5px;text-transform:uppercase;color:#94a3b8;font-weight:700;margin-bottom:4px}
.author-bio-name{font-family:'Outfit',sans-serif;font-size:21px;font-weight:800;color:#0F172A;line-height:1.3;margin-bottom:3px}
.author-bio-name a{color:#0F172A}
.author-bio-name a:hover{color:#06B6D4}
.author-bio-job{font-family:'Outfit',sans-serif;font-size:12px;color:#94a3b8;margin-bottom:8px}
.author-bio-text{font-size:13.5px;line-height:1.75;color:#64748b;margin-bottom:10px}
.author-bio-tagline{font-style:italic;font-size:12.5px;color:#64748b;border-left:3px solid #FBBF24;padding-left:10px;margin-top:6px}
.author-bio-link{display:inline-block;margin-top:8px;font-family:'Outfit',sans-serif;font-size:12.5px;font-weight:600;color:#06B6D4;border-bottom:1px solid transparent;transition:border-color .2s}
.author-bio-link:hover{border-bottom-color:#06B6D4}

/* Per-hotel "save to plan" button (entry card → ta_wishlist · shared with FAB + /trip) */
.entry-save{display:inline-flex;align-items:center;justify-content:center;gap:6px;width:100%;margin-top:8px;font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;color:#0891b2;background:#ffffff;border:1.5px solid #06B6D4;border-radius:12px;padding:10px 16px;cursor:pointer;transition:all .18s;white-space:nowrap;box-shadow:0 2px 8px rgba(6,182,212,.1)}
.entry-save:hover{background:#f1fbfd;transform:translateY(-1px);box-shadow:0 6px 16px rgba(6,182,212,.22)}
.entry-save.saved{color:#fff;background:linear-gradient(135deg,#06B6D4,#0891b2);border-color:transparent;box-shadow:0 7px 16px rgba(6,182,212,.36)}

/* Faceted filter (budget / stars) — ported from the eat-ranking .rfilter pattern to hotel roundups */
.rfilter{display:flex;flex-direction:column;gap:9px;margin:0 0 22px;padding:14px 16px;background:#f1fbfd;border:1px solid #e6eef2;border-radius:16px}
.rfg{display:flex;align-items:center;flex-wrap:wrap;gap:7px}
.rfg-l{font-family:'Outfit',sans-serif;font-weight:800;font-size:11px;color:#64748b;text-transform:uppercase;letter-spacing:.5px;min-width:50px}
.rchip{font-family:'Outfit',sans-serif;font-weight:700;font-size:12.5px;color:#64748b;background:#fff;border:1.5px solid #e6eef2;border-radius:999px;padding:6px 13px;cursor:pointer;transition:.15s}
.rchip:hover{border-color:#06B6D4;color:#0891b2}
.rchip.on{background:linear-gradient(135deg,#06B6D4,#0891b2);border-color:transparent;color:#fff}
.rfilter-count{font-family:'Outfit',sans-serif;font-weight:700;font-size:12px;color:#0891b2}
.hotel-entry.rf-hide{display:none}
</style>
<!-- ad/monetization tag removed — add ThailandAddict's own here later -->
</head>
<body class="rl-page">

<nav class="nav" id="nav">
  <a href={link('/')} class="logo">Thailand<em>Addict</em></a>
  <div class="nav-mid">
    <a href={link('country-thailand.html')}>{S.navDest}</a>
    <a href={link(data.navReviewHref)}>{data.navReviewLabel}</a>
    <a href="/trip" style="font-weight:700">{isEn ? 'Plan trip' : 'วางแผนทริป'}</a>
    <a href={link('about.html')}>{S.navAbout}</a>
  </div>
  <div class="nav-r">
    <span class="lang-sw">
      <a href={`${SITE}/${data.slug}`} class={isEn ? '' : 'on'} hreflang="th" aria-label="ภาษาไทย">TH</a>
      <a href={`${SITE}/en/${data.slug}`} class={isEn ? 'on' : ''} hreflang="en" aria-label="English">EN</a>
      <span class="dis" title="เร็วๆ นี้ · Coming soon">中文</span>
      <span class="dis" title="เร็วๆ นี้ · Coming soon">ES</span>
      <span class="dis" title="เร็วๆ นี้ · Coming soon">FR</span>
    </span>
    <button class="nav-cta" onclick="window.open('https://www.agoda.com/?cid=1965862','_blank')">{S.navCta}</button>
    <button class="hb" id="hb">☰</button>
  </div>
</nav>
<div class="mm" id="mm">
  <div class="mm-top">
    <a href={link('/')} class="logo">Thailand<em>Addict</em></a>
    <button class="mm-x" id="mmx">✕</button>
  </div>
  <a href={link('/')}>{S.mmHome}</a>
  <a href={link('country-thailand.html')}>{S.navDest}</a>
  <a href={link(data.navReviewHref)}>{data.navReviewLabel}</a>
  <a href="/trip">{isEn ? 'Plan trip' : 'วางแผนทริป'}</a>
  <a href={link('about.html')}>{S.navAbout}</a>
  <a href={link('contact.html')}>{S.mmContact}</a>
  <span class="lang-sw mm-lang">
    <a href={`${SITE}/${data.slug}`} class={isEn ? '' : 'on'} hreflang="th">🇹🇭 ไทย</a>
    <a href={`${SITE}/en/${data.slug}`} class={isEn ? 'on' : ''} hreflang="en">🇬🇧 English</a>
    <span class="dis">🇨🇳 中文</span>
    <span class="dis">🇪🇸 Español</span>
    <span class="dis">🇫🇷 Français</span>
  </span>
  <button class="mm-cta" onclick="window.open('https://www.agoda.com/?cid=1965862','_blank')">{S.navCta}</button>
</div>

<div class="bc">
  {data.breadcrumb.map((b, i) => (
    <>
      {b.href ? <a href={link(b.href)}>{b.name}</a> : <span>{b.name}</span>}
      {i < data.breadcrumb.length - 1 ? ' › ' : ''}
    </>
  ))}
</div>

<div class="hero">
  <div class="hero-bg" style={`background-image:url('${asset(data.heroImg)}')`}></div>
  <div class="hero-ov"></div>
  <div class="hero-inner">
    <div class="hero-eyebrow">{data.heroEyebrow}</div>
    <h1 set:html={data.h1}></h1>
    <p class="hero-sub">{data.heroSub}</p>
    <div class="hero-stats">
      {data.heroStats.map((s) => <div class="stat-pill" set:html={s}></div>)}
    </div>
  </div>
</div>

<div class="page-wrap">

  {by && (
    <div class="byline-strip rv">
      <div class="byline-avatar">
        {by.avatar
          ? <img src={asset(by.avatar)} alt={by.name || 'Author'} loading="lazy" onerror="this.parentElement.innerHTML=(this.parentElement.dataset.fallback||'T')" data-fallback={(by.name || 'T').charAt(0)} />
          : <span>{(by.name || 'T').charAt(0)}</span>}
      </div>
      <div class="byline-text">
        <div class="byline-name">
          {by.url
            ? <a href={link(by.url.replace(/^https?:\/\/[^/]+/, ''))}>{by.name}</a>
            : <span>{by.name}</span>}
          <span class="fact-badge">{factCheckedL}</span>
        </div>
        {by.jobTitle && <div class="byline-job">{by.jobTitle}</div>}
      </div>
      <div class="byline-meta">
        {(data as any).publishedDate && <span><strong>{S.bylinePublished}:</strong> {(data as any).publishedDate}</span>}
        {(data as any).modifiedDate && <span><strong>{S.bylineUpdated}:</strong> {(data as any).modifiedDate}</span>}
        {(data as any).readTime && <span><strong>{S.bylineReadTime}:</strong> {(data as any).readTime}</span>}
      </div>
    </div>
  )}

  {qaHtml && (
    <aside class="quick-answer rv">
      <div class="qa-eyebrow">{S.quickAnswerEyebrow}</div>
      {(data as any).quickAnswerH2 && <h2>{(data as any).quickAnswerH2}</h2>}
      <div class="qa-body" set:html={qaHtml}></div>
    </aside>
  )}

  <div class="intro-block rv">
    <h2 set:html={data.introH2}></h2>
    <p set:html={data.introHtml}></p>
  </div>

  {((data as any).methodologyHtml || (data as any).lastVerifiedHtml || (data as any).disclosureHtml) && (
    <div class="article-meta-box rv">
      <span class="article-meta-label">{S.methodologyLabel}</span>
      {(data as any).methodologyHtml && (
        <div class="article-meta-row" set:html={(data as any).methodologyHtml}></div>
      )}
      {(data as any).lastVerifiedHtml && (
        <div class="article-meta-row" set:html={(data as any).lastVerifiedHtml}></div>
      )}
      {(data as any).disclosureHtml && (
        <div class="article-meta-row" set:html={(data as any).disclosureHtml}></div>
      )}
    </div>
  )}

  {(data as any).compareTopRows && (data as any).compareTopRows.length > 0 && (
    <section class="compare-top rv">
      {(data as any).compareTitleTop && <div class="compare-title">{(data as any).compareTitleTop}</div>}
      <div class="table-wrap">
        <table>
          {(data as any).compareTopCols && (data as any).compareTopCols.length > 0 && (
            <thead>
              <tr>{(data as any).compareTopCols.map((c: string) => <th>{c}</th>)}</tr>
            </thead>
          )}
          <tbody>
            {(data as any).compareTopRows.map((r: any) => (
              <tr>
                {r.rank !== undefined && <td><span class="ct-rank">{r.rank}</span></td>}
                {r.name !== undefined && <td><strong set:html={r.name}></strong>{r.type ? <div style="font-size:11.5px;color:#94a3b8;margin-top:2px">{r.type}</div> : null}</td>}
                {r.score !== undefined && <td style="font-weight:700;color:#f43f5e;white-space:nowrap">{r.score}</td>}
                {r.price !== undefined && <td style="font-weight:700;color:#0891b2;white-space:nowrap">{r.price}</td>}
                {(r.bestFor !== undefined || r.access !== undefined) && <td style="font-size:12.25px;color:#64748b">{r.bestFor || r.access}</td>}
                {r.badge !== undefined && !r.url && <td>{r.badge ? <span class="best-badge" style={r.badgeStyle}>{r.badge}</span> : ''}</td>}
                {r.url !== undefined && <td><a class="ct-book" href={r.url} target="_blank" rel="sponsored noopener nofollow">Book →</a></td>}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <div class="mrt-box">
    <div class="mrt-icon">🚇</div>
    <div class="mrt-content" set:html={data.mrtHtml}></div>
  </div>

  <div class="toc-wrap">
    <div class="toc-title">{S.tocTitle}</div>
    <div class="toc-grid">
      {data.toc.map((t, i) => (
        <a href={`#${data.entries[i].id}`} class="toc-item">
          <span class="toc-n" style={`background:${t.color}`}>{t.n}</span>
          <span class="toc-nm" set:html={t.name}></span>
          <span class="toc-p">{t.price}</span>
        </a>
      ))}
    </div>
  </div>

  {showRoundupFilter && (
    <div class="rfilter" id="rrfilter">
      {starOpts.length >= 2 && (
        <div class="rfg"><span class="rfg-l">{RF_S.star}</span>
          <button class="rchip on" type="button" data-axis="star" data-val="">{RF_S.all}</button>
          {starOpts.map((s) => <button class="rchip" type="button" data-axis="star" data-val={s}>{s}⭐</button>)}
        </div>
      )}
      {priceOpts.length >= 2 && (
        <div class="rfg"><span class="rfg-l">{RF_S.price}</span>
          <button class="rchip on" type="button" data-axis="price" data-val="">{RF_S.all}</button>
          {priceOpts.map((p) => <button class="rchip" type="button" data-axis="price" data-val={p}>{p}</button>)}
        </div>
      )}
      <span class="rfilter-count" id="rrfilter-count" data-tpl={RF_S.countTpl}></span>
    </div>
  )}

  <div class="sec-label"><span>{data.secLabel}</span></div>

  {data.entries.map((e, ei) => (
    <article class="hotel-entry rv" id={e.id} data-star={entryStars[ei]} data-price={entryPrices[ei]}>
      <div class="entry-header">
        <div class="rank-num" style={`background:${e.rankColor}`}>{e.rank}</div>
        <div class="entry-header-info">
          <div class="entry-type">{e.type}</div>
          <h2 class="entry-name" set:html={e.name}></h2>
          <div class="entry-meta-row">
            <span class="score-pill">★ {e.score}/10</span>
            <span class="stars-text">{e.stars}</span>
            <span class="rev-count">{e.revCount}</span>
          </div>
        </div>
        {e.badge && <div class="entry-badge" style={`background:${e.badgeColor}`}>{e.badge}</div>}
      </div>
      <div class="entry-body">
        <div class="entry-img-col">
          <div class="img-wrap">
            {hasWebp(e.img) ? (
              <picture>
                <source srcset={asset(webpOf(e.img))} type="image/webp" />
                <img src={asset(e.img)} alt={e.name} loading="lazy" onerror="this.closest('.img-wrap').style.background='#2d2416'" />
              </picture>
            ) : (
              <img src={asset(e.img)} alt={e.name} loading="lazy" onerror="this.closest('.img-wrap').style.background='#2d2416'" />
            )}
            <div class="img-overlay"><div class="mrt-tag">{e.mrtTag}</div></div>
            <a class="rd-img-book" href={cjBooking(e.tripUrl)} target="_blank" rel="sponsored noopener nofollow" aria-label={e.name}><span>{S.imgBook}</span></a>
          </div>
          <div class="price-block">
            <div class="price-label-sm">{S.priceLabel}</div>
            <div class="price-big">{e.priceBig}</div>
            <div class="price-sub">{e.priceSub}</div>
