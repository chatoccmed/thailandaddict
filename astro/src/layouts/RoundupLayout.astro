<script is:inline>
(function(){
  var hb=document.getElementById('hb'),mm=document.getElementById('mm'),mmx=document.getElementById('mmx');
  if(hb&&mm&&mmx){hb.addEventListener('click',function(){mm.classList.add('open')});mmx.addEventListener('click',function(){mm.classList.remove('open')});}
  var nav=document.getElementById('nav');
  if(nav){
    var toggle=function(){nav.classList.toggle('solid',window.scrollY>80);};
    toggle();
    window.addEventListener('scroll',toggle,{passive:true});
  }
  var io=new IntersectionObserver(function(e){e.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target);}});},{threshold:.07});
  document.querySelectorAll('.rv').forEach(function(el){io.observe(el);});
  // Faceted filter (budget / stars) — single-select per axis, AND-combined.
  var rfbar=document.getElementById('rrfilter');
  if(rfbar){
    var rsel={star:'',price:''};
    var rcnt=document.getElementById('rrfilter-count');
    function rapply(){
      var shown=0,total=0,active=rsel.star||rsel.price;
      document.querySelectorAll('.hotel-entry').forEach(function(card){
        total++;
        var ok=(!rsel.star||card.getAttribute('data-star')===rsel.star)&&(!rsel.price||card.getAttribute('data-price')===rsel.price);
        card.classList.toggle('rf-hide',!ok); if(ok)shown++;
      });
      if(rcnt)rcnt.textContent=active?(rcnt.getAttribute('data-tpl')||'').replace('{s}',shown).replace('{t}',total):'';
    }
    rfbar.addEventListener('click',function(e){
      var b=e.target.closest('button'); if(!b)return;
      var ax=b.getAttribute('data-axis'); if(!ax)return;
      rsel[ax]=b.getAttribute('data-val');
      b.parentNode.querySelectorAll('[data-axis="'+ax+'"]').forEach(function(x){x.classList.remove('on');});
      b.classList.add('on');
      rapply();
    });
  }
})();
</script>
<script is:inline>
(function(){
  // Per-hotel save-to-plan buttons (entry cards → ta_wishlist localStorage · shared with the FAB + /trip planner)
  var KEY='ta_wishlist';
  function get(){try{return JSON.parse(localStorage.getItem(KEY)||'[]')}catch(e){return[]}}
  document.querySelectorAll('.entry-save').forEach(function(btn){
    var slug=btn.dataset.slug;
    function render(){var on=get().some(function(x){return x.slug===slug});btn.classList.toggle('saved',on);btn.textContent=on?btn.dataset.saved:btn.dataset.word;}
    render();
    btn.addEventListener('click',function(){
      var l=get(), i=-1; for(var k=0;k<l.length;k++){if(l[k].slug===slug){i=k;break;}}
      var added=i<0;
      if(i>=0){l.splice(i,1);}else{l.push({slug:slug,name:btn.dataset.name,img:btn.dataset.img,url:btn.dataset.url,type:btn.dataset.type||'stay',city:btn.dataset.city||'',province:btn.dataset.province||''});}
      try{localStorage.setItem(KEY,JSON.stringify(l));}catch(e){}
      render();
      if(window.taSyncFab)taSyncFab();
      if(window.taPlanToast)taPlanToast(added,btn.dataset.name,l.length);
    });
  });
})();
</script>
<a href="/trip" class="ta-tripfab" id="taTripFab" aria-label="แผนการเดินทางของฉัน" style="display:none">🧳<span class="tf-l">แผนของฉัน</span><b id="taTripN">0</b></a>
