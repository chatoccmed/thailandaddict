    b.kind === 'heatmap' ? <div class="hmap-wrap">{b.caption && <div class="hmap-cap" set:html={b.caption} />}<div class="hmap-scroll"><table class="hmap"><thead><tr><th class="hmap-corner"></th>{b.regions.map((r) => <th set:html={r} />)}</tr></thead><tbody>{b.rows.map((row) => <tr><th class="hmap-m" set:html={row.m} />{row.cells.map((c) => <td class={`hmc ${c.s ?? ''}`}><span set:html={c.e} /></td>)}</tr>)}</tbody></table></div>{b.legend && <div class="hmap-legend">{b.legend.map((l) => <span set:html={l} />)}</div>}{b.cta && <a class="hmap-cta" href={b.cta.href} set:html={b.cta.label} />}</div> :
