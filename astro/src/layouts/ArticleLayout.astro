const nearestOf = (b) => { let best = null, bd = Infinity; for (const o of geoRestos) { if (o.rank === b.rank) continue; const d = haversineKm(b, o); if (d < bd) { bd = d; best = o; } } return best ? { name: strip(best.name), km: bd } : null; };
const distLabel = (km) => (km < 1 ? `~${Math.max(50, Math.round(km * 1000 / 50) * 50)} ${!isTh ? 'm' : 'ม.'}` : `~${km.toFixed(1)} ${!isTh ? 'km' : 'กม.'}`);
const mapPins = geoRestos.map((b) => { const nr = nearestOf(b); return { rank: b.rank, name: strip(b.name), lat: b.lat, lng: b.lng, stayHref: b.stayHref ? link(b.stayHref) : '', stayLabel: b.stayLabel || S.mapStay, near: nr ? `${nr.name} · ${distLabel(nr.km)}` : '' }; });
const showMap = isResto && mapPins.length >= 3;
// v3 filters: zone / food-type / price-tier axes + diet toggles. Each group is conditional on data.
const priceTier = (u) => { const m = String(u || '').match(/([\d.]+)/); if (!m) return ''; const n = parseFloat(m[1]); return n < 5 ? '฿' : n <= 12 ? '฿฿' : '฿฿฿'; };
const zones = [...new Set(restos.map((b) => b.zone).filter(Boolean))];
const types = [...new Set(restos.map((b) => b.foodType).filter(Boolean))];
const prices = [...new Set(restos.map((b) => priceTier(b.priceUsd)).filter(Boolean))].sort((a, b) => a.length - b.length);
const hasVeg = restos.some((b) => b.veg);
const hasHalal = restos.some((b) => b.halal);
const showFilters = isResto && (zones.length >= 2 || types.length >= 2 || prices.length >= 2 || hasVeg || hasHalal);
// Sticky right-rail (desktop only): featured hotel roundups + the food-tour module, both follow scroll.
const railItems = (data.rail && data.rail.length ? data.rail : []);
const foodBlock = isResto ? (data.blocks.find((b) => b.kind === 'foodexp') || null) : null;
const hasRail = isResto && (railItems.length > 0 || !!foodBlock);
// EEAT — named editor (gated: falls back to Organization author until editorial.json holds a real name).
const _ed = (editorial as any).editor || {};
const hasEditor = !!String(_ed.name || _ed.nameEn || '').trim();
const _edName = (!isTh ? (_ed.nameEn || _ed.name) : (_ed.name || _ed.nameEn)) || '';
const _edRole = (!isTh ? (_ed.roleEn || _ed.role) : (_ed.role || _ed.roleEn)) || '';
const authorNode: any = hasEditor
  ? { '@type': 'Person', name: _edName, jobTitle: _edRole, url: `${SITE}${pfx}/about`, worksFor: { '@id': `${SITE}/#org` },
      ...(String(_ed.image || '').trim() ? { image: asset(_ed.image) } : {}),
      ...(Array.isArray(_ed.sameAs) && _ed.sameAs.length ? { sameAs: _ed.sameAs } : {}) }
  : { '@type': 'Organization', name: 'ThailandAddict' };
// Visible EEAT byline — a real named editor when editorial.json has one, else the honest editorial-team
// attribution (never a fabricated personal byline).
const byName = data.author?.name || (hasEditor ? _edName : S.byTeam);
const jsonld = {
  '@context': 'https://schema.org', '@graph': [
    { '@type': 'Article', headline: data.title, description: data.metaDesc, inLanguage: lang,
      author: authorNode,
      publisher: { '@type': 'Organization', '@id': `${SITE}/#org`, name: 'ThailandAddict', url: SITE, logo: { '@type': 'ImageObject', url: `${SITE}/logo.png` } },
      datePublished: published, dateModified: updated,
      ...((data.heroImg || data.image) ? { image: asset(data.heroImg || data.image) } : {}),
      mainEntityOfPage: canonical },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: S.home, item: `${SITE}${pfx}/` },
      { '@type': 'ListItem', position: 2, name: S.th, item: `${SITE}${pfx}/country-thailand` },
      { '@type': 'ListItem', position: 3, name: data.crumbCity, item: `${SITE}${pfx}/${data.crumbCityHref.replace(/\.html$/, '')}` },
      { '@type': 'ListItem', position: 4, name: data.title, item: canonical } ] },
    // Honest ItemList + Restaurant graph (no fabricated ratings) → rich results + AI answer-engine citations.
    ...(isResto ? [{ '@type': 'ItemList', name: strip(data.title), numberOfItems: restos.length,
      itemListElement: restos.map((b) => ({ '@type': 'ListItem', position: Number(b.rank),
        item: { '@type': (isAttractionList || isActivity) ? 'TouristAttraction' : 'Restaurant', name: strip(b.name),
          ...(b.cuisine && !isAttractionList && !isActivity ? { servesCuisine: strip(b.cuisine) } : {}),
          ...(b.priceRange ? { priceRange: strip(b.priceRange) } : {}),
          ...(b.lat && b.lng ? { geo: { '@type': 'GeoCoordinates', latitude: b.lat, longitude: b.lng } } : {}),
          ...(b.area ? { address: { '@type': 'PostalAddress', addressLocality: strip(b.area), addressRegion: data.crumbCity, addressCountry: 'TH' } } : {}),
          ...(b.img ? { image: b.img.startsWith('http') ? b.img : `${IMG_BASE || SITE}${b.img}` } : {}),
          ...(b.rating && b.ratingCount ? { aggregateRating: { '@type': 'AggregateRating', ratingValue: b.rating, reviewCount: b.ratingCount, bestRating: 5, worstRating: 1 } } : {}),
          url: `${canonical}#r${b.rank}` } })) }] : []),
    // Entity schema for AI answer-engines + Google knowledge graph (derived from existing data, nothing fabricated).
    ...(data.type === 'attraction' ? [{ '@type': 'TouristAttraction', name: strip(data.h1 || data.title), description: data.metaDesc,
      ...((data.heroImg || data.image) ? { image: asset(data.heroImg || data.image) } : {}),
      address: { '@type': 'PostalAddress', addressLocality: data.crumbCity, addressRegion: data.crumbCity, addressCountry: 'TH' },
      ...(data.lat && data.lng ? { geo: { '@type': 'GeoCoordinates', latitude: data.lat, longitude: data.lng } } : {}), url: canonical }] : []),
    ...(data.type === 'itinerary' ? [{ '@type': 'TouristTrip', name: strip(data.h1 || data.title), description: data.metaDesc,
      ...((data.heroImg || data.image) ? { image: asset(data.heroImg || data.image) } : {}), url: canonical }] : []),
    // HowTo for procedural articles (getting-around, transport routes, visa/eSIM how-tos) — steps from the h2 sections.
    ...(showHowTo ? [{ '@type': 'HowTo', name: strip(data.h1 || data.title), description: data.metaDesc,
      ...((data.heroImg || data.image) ? { image: asset(data.heroImg || data.image) } : {}), step: howtoSteps }] : []),
    ...(faq.length ? [{ '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []),
    // Speakable (AEO/voice): points answer-engines at the quick-answer block as the citable sentence.
    ...(quickAnswerHtml ? [{ '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.qa-body'] } }] : []),
  ],
};
const favSvg = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='24' fill='%2306B6D4'/%3E%3Ctext x='50' y='68' font-family='Outfit,sans-serif' font-size='60' font-weight='bold' fill='white' text-anchor='middle'%3ET%3C/text%3E%3C/svg%3E";
---
<!doctype html>
<html lang={lang} dir={isRtl ? 'rtl' : 'ltr'}>
<head>
<meta charset="UTF-8" />
<Analytics />
<meta name="viewport" content="width=device-width,initial-scale=1.0" />
<title>{data.title}</title>
<meta name="description" content={data.metaDesc} />
{data.keywords && <meta name="keywords" content={data.keywords} />}
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href={favSvg} />
<meta property="og:site_name" content="ThailandAddict" />
<meta property="og:title" content={data.ogTitle ?? data.title} />
<meta property="og:description" content={data.ogDesc ?? data.metaDesc} />
<meta property="og:type" content="article" />
<meta property="og:url" content={canonical} />
{(data.image || data.heroImg) && <meta property="og:image" content={asset(data.image || data.heroImg)} />}
{data.heroImg && <link rel="preload" as="image" href={asset(data.heroImg)} fetchpriority="high" />}
<meta property="og:locale" content={({th:'th_TH',en:'en_US',zh:'zh_CN',ru:'ru_RU',ko:'ko_KR',ja:'ja_JP',hi:'hi_IN',he:'he_IL',ar:'ar_AR'} as Record<string,string>)[lang]} />
<link rel="alternate" hreflang="th" href={`${SITE}/${data.slug}`} />
{hasEn && <link rel="alternate" hreflang="en" href={`${SITE}/en/${data.slug}`} />}
{lang === 'zh' && <link rel="alternate" hreflang="zh" href={`${SITE}/zh/${data.slug}`} />}
{lang === 'ru' && <link rel="alternate" hreflang="ru" href={`${SITE}/ru/${data.slug}`} />}
{lang === 'ko' && <link rel="alternate" hreflang="ko" href={`${SITE}/ko/${data.slug}`} />}
{lang === 'ja' && <link rel="alternate" hreflang="ja" href={`${SITE}/ja/${data.slug}`} />}
{lang === 'hi' && <link rel="alternate" hreflang="hi" href={`${SITE}/hi/${data.slug}`} />}
{lang === 'he' && <link rel="alternate" hreflang="he" href={`${SITE}/he/${data.slug}`} />}
{lang === 'ar' && <link rel="alternate" hreflang="ar" href={`${SITE}/ar/${data.slug}`} />}
<link rel="alternate" hreflang="x-default" href={`${SITE}/${data.slug}`} />
<meta name="theme-color" content="#06B6D4" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href={IMG_BASE} crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Sarabun:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
<noscript><link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Sarabun:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" /></noscript>
<script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
{showMap && <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />}
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{--teal:#06B6D4;--teal-dk:#0891b2;--coral:#FB7185;--coral-dk:#f43f5e;--mango:#FBBF24;--ink:#0F172A;--sub:#64748b;--bg:#ffffff;--soft:#f1fbfd;--bdr:#e6eef2}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{font-family:'Sarabun',sans-serif;background:var(--bg);color:var(--ink);line-height:1.75;-webkit-font-smoothing:antialiased}
/* review.css + roundup.css ship body{overflow-x:hidden}; Astro bundles them into this page's CSS too → body becomes a scroll-container → the sticky rail never pins. Override with higher specificity (html body beats body). No real horizontal overflow on this page (verified docW==viewport). */
html body{overflow:visible}
/* belt-and-braces: clip h-overflow only on full-bleed sections (NOT ancestors of .rrail, so sticky stays intact) */
.nav,.hero,.rhero,.qnav{overflow-x:clip}
a{color:inherit;text-decoration:none}img{display:block;max-width:100%}
.wrap{max-width:820px;margin:0 auto;padding:0 24px}
.nav{display:flex;align-items:center;justify-content:space-between;padding:16px 28px;border-bottom:1px solid var(--bdr);position:sticky;top:0;background:rgba(255,255,255,.85);backdrop-filter:blur(14px);z-index:99}
.logo{font-family:'Outfit';font-size:24px;font-weight:800;letter-spacing:-.5px;color:var(--ink)}.logo em{font-style:normal;color:var(--teal)}
.nmid{display:flex;gap:6px}@media(max-width:820px){.nmid{display:none}}
.nmid a{font-family:'Outfit';font-size:14px;font-weight:600;color:var(--sub);padding:8px 13px;border-radius:999px}.nmid a:hover{color:var(--teal);background:var(--soft)}
.nr{display:flex;align-items:center;gap:12px}
/* language flag-bar (circular SVG flags; active enlarged) — shows only the locales this page exists in */
.flagbar{display:inline-flex;align-items:center;flex-wrap:wrap;gap:3px;background:var(--soft);border:1px solid var(--bdr);border-radius:30px;padding:4px 6px;max-width:272px}
.flagbar a{display:block;width:24px;height:24px;border-radius:50%;overflow:hidden;opacity:.7;transition:transform .16s,opacity .16s;flex:0 0 auto;box-shadow:0 0 0 1px rgba(0,0,0,.06)}
.flagbar a:hover{opacity:1;transform:scale(1.12)}
.flagbar a.on{opacity:1;transform:scale(1.2);box-shadow:0 0 0 2px #fff,0 3px 9px rgba(15,40,70,.22);position:relative;z-index:1}
.flg{width:100%;height:100%;background-size:cover;background-position:center;display:block}
.flg-th{background-image:url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI5MDAiIGhlaWdodD0iNjAwIj48cGF0aCBmaWxsPSIjQTUxOTMxIiBkPSJNMCAwaDkwMHY2MDBIMHoiLz48cGF0aCBmaWxsPSIjRjRGNUY4IiBkPSJNMCAxMDBoOTAwdjQwMEgweiIvPjxwYXRoIGZpbGw9IiMyRDJBNEEiIGQ9Ik0wIDIwMGg5MDB2MjAwSDB6Ii8+PC9zdmc+")}
.flg-en{background-image:url("data:image/svg+xml;base64,")}
.flg-zh{background-image:url("data:image/svg+xml;base64,")}
.flg-ru{background-image:url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCA5IDYiIHdpZHRoPSI5MDAiIGhlaWdodD0iNjAwIj48cGF0aCBmaWxsPSIjZmZmIiBkPSJNMCAwaDl2M0gweiIvPjxwYXRoIGZpbGw9IiNkNTJiMWUiIGQ9Ik0wIDNoOXYzSDB6Ii8+PHBhdGggZmlsbD0iIzAwMzlhNiIgZD0iTTAgMmg5djJIMHoiLz48L3N2Zz4=")}
.flg-ko{background-image:url("data:image/svg+xml;base64,")}
.flg-ja{background-image:url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI5MDAiIGhlaWdodD0iNjAwIj48cGF0aCBmaWxsPSIjZmZmIiBkPSJNMCAwaDkwMHY2MDBIMHoiLz48Y2lyY2xlIGZpbGw9IiNiYzAwMmQiIGN4PSI0NTAiIGN5PSIzMDAiIHI9IjE4MCIvPjwvc3ZnPg==")}
.flg-hi{background-image:url("data:image/svg+xml;base64,")}
.flg-he{background-image:url("data:image/svg+xml;base64,")}
.flg-ar{background-image:url("data:image/svg+xml;base64,")}
@media(max-width:600px){.flagbar{max-width:134px;gap:2px}.flagbar a{width:22px;height:22px}}
html[dir="rtl"] .flagbar{flex-direction:row-reverse}
/* RTL (he/ar) — mirror text flow + accent borders + slide-in menu for the article-page components. */
html[dir="rtl"] .crumb,html[dir="rtl"] p,html[dir="rtl"] h1,html[dir="rtl"] h2,html[dir="rtl"] h3,html[dir="rtl"] li,html[dir="rtl"] td,html[dir="rtl"] th,html[dir="rtl"] .intro,html[dir="rtl"] .lead,html[dir="rtl"] .day h3,html[dir="rtl"] .cd h3,html[dir="rtl"] .cd p,html[dir="rtl"] .faq summary{text-align:right}
html[dir="rtl"] ul,html[dir="rtl"] ol{padding-right:1.1em;padding-left:0}
/* left accent borders → right in RTL */
html[dir="rtl"] .quick-answer{border-left:1px solid #cbeef5;border-right:5px solid #06B6D4}
html[dir="rtl"] .day{border-left:1px solid var(--bdr);border-right:5px solid var(--teal)}
/* FAQ +/– marker floats right in LTR → float left in RTL */
html[dir="rtl"] .faq summary::after{float:left}
/* mobile menu slides in from the left in RTL (from the right in LTR) */
html[dir="rtl"] .mm{transform:translateX(-100%)}
html[dir="rtl"] .mm.open{transform:translateX(0)}
.lang a{padding:5px 10px;color:var(--teal);border-radius:999px}.lang a.on{background:var(--teal);color:#fff}
.cta{font-family:'Outfit';font-size:13px;font-weight:800;background:linear-gradient(135deg,var(--coral),var(--coral-dk));color:#fff;padding:11px 20px;border-radius:999px;box-shadow:0 10px 22px rgba(244,63,94,.32);border:none;cursor:pointer}@media(max-width:820px){.cta{display:none}}
.hb{display:none;background:none;border:none;font-size:24px;color:var(--ink);cursor:pointer}@media(max-width:820px){.hb{display:block}}
.mm{position:fixed;inset:0;z-index:1000;background:#fff;transform:translateX(100%);transition:.3s;display:flex;flex-direction:column;padding:24px;overflow-y:auto}.mm.open{transform:translateX(0)}
.mm-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.mm-x{background:none;border:none;font-size:28px;cursor:pointer}
.mm a{font-family:'Outfit';font-size:19px;font-weight:700;padding:14px 0;border-bottom:1px solid var(--bdr)}
.crumb{max-width:820px;margin:0 auto;padding:18px 24px 0;font-family:'Outfit';font-size:12.5px;color:var(--sub)}.crumb a:hover{color:var(--teal)}
.hero{padding:34px 0 26px;position:relative;overflow:hidden;background:linear-gradient(135deg,#ecfeff,#fff 55%,#fff5f7);height:auto;min-height:0}
.hero .eyebrow{display:inline-block;font-family:'Outfit';font-size:12.5px;font-weight:800;letter-spacing:.5px;color:var(--teal-dk);background:#cffafe;padding:6px 14px;border-radius:999px;margin-bottom:14px}
.hero h1{font-family:'Outfit';font-size:clamp(30px,5vw,46px);font-weight:900;line-height:1.1;letter-spacing:-1px}
.hero .lead{font-size:17px;color:var(--sub);margin-top:14px}
.chips{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}
.chip{font-family:'Outfit';font-size:12.5px;font-weight:700;background:#fff;border:2px solid var(--bdr);border-radius:999px;padding:7px 14px}
.heroimg{display:block;width:100%;max-width:820px;margin:22px auto 0;border-radius:20px;aspect-ratio:16/9;object-fit:cover;box-shadow:0 16px 40px rgba(15,23,42,.12)}
.heroimg-fig{margin:0}.heroimg-fig .heroimg{margin-bottom:0}.heroimg-cred{display:block;max-width:820px;margin:5px auto 0;text-align:right;font-size:11px;color:var(--sub)}.heroimg-cred a{color:var(--sub)}
.body{padding:30px 0 10px}
.body h2{font-family:'Outfit';font-size:24px;font-weight:800;letter-spacing:-.4px;margin:34px 0 12px;scroll-margin-top:80px}
.body h2:first-child{margin-top:0}
.body p{font-size:16px;color:#1e293b;margin:0 0 14px}.body p strong{color:var(--ink);font-weight:700}
.body ul{margin:0 0 16px;padding-left:4px;list-style:none}
.body ul li{position:relative;padding:6px 0 6px 26px;font-size:15.5px;color:#1e293b}
.body ul li::before{content:'';position:absolute;left:4px;top:14px;width:8px;height:8px;border-radius:50%;background:linear-gradient(135deg,var(--teal),var(--coral))}
/* ===== Restaurant roundup — editorial "award" layout ===== */
.quick-answer{background:linear-gradient(180deg,#f1fbfd 0%,#ffffff 100%);border:1px solid #cbeef5;border-left:5px solid #06B6D4;border-radius:18px;padding:18px 22px;margin:6px 0 24px;box-shadow:0 8px 24px rgba(6,182,212,.10)}
.qa-eyebrow{display:inline-block;font-family:'Outfit',sans-serif;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:#0891b2;font-weight:700;background:#fff;padding:3px 11px;border-radius:999px;border:1px solid #cbeef5;margin-bottom:9px}
.qa-body{font-size:15.5px;line-height:1.8;color:#0F172A}
.qa-body strong{color:#0891b2;font-weight:700}
.qa-body a{color:#0891b2}
.rhero{background-size:cover;background-position:center;color:#fff;padding:clamp(72px,12vw,118px) 0 clamp(56px,7vw,76px);position:relative;min-height:clamp(440px,58vh,620px);display:flex;flex-direction:column;justify-content:flex-end}
.rhero-kick{font-family:'Outfit';font-weight:700;font-size:12.5px;letter-spacing:.13em;text-transform:uppercase;color:rgba(255,255,255,.92);margin-bottom:16px;display:flex;align-items:center;gap:9px;text-shadow:0 1px 10px rgba(0,0,0,.4)}
.rhero-kick::before{content:"";width:28px;height:2px;background:var(--mango);border-radius:2px;flex-shrink:0}
.rhero-scroll{position:absolute;bottom:18px;right:clamp(18px,4vw,40px);display:inline-flex;align-items:center;gap:9px;color:#fff;font-family:'Outfit';font-weight:700;font-size:12.5px;opacity:.92;text-shadow:0 1px 10px rgba(0,0,0,.5)}
.rhero-scroll em{font-style:normal;font-size:17px;animation:rhBounce 1.6s ease-in-out infinite}
@keyframes rhBounce{0%,100%{transform:translateY(0)}50%{transform:translateY(5px)}}
.rhero-cred{position:absolute;bottom:8px;left:14px;font-size:10px;color:rgba(255,255,255,.6)}.rhero-cred a{color:rgba(255,255,255,.6);text-decoration:underline}
.rhero .wrap{max-width:860px}
.rhero .eyebrow{background:rgba(255,255,255,.16);color:#fff;border:1px solid rgba(255,255,255,.28);backdrop-filter:blur(6px)}
.rhero h1{font-family:'Outfit';font-size:clamp(33px,6.2vw,56px);font-weight:900;line-height:1.07;letter-spacing:-1.2px;text-shadow:0 2px 30px rgba(0,0,0,.4)}
.rhero h1 .hi{color:var(--mango)}.rhero h1 .hi2{color:#fff}
.rhero .lead{color:rgba(255,255,255,.93);font-size:clamp(16px,2.3vw,19px);max-width:700px;margin-top:16px;text-shadow:0 1px 14px rgba(0,0,0,.45)}
.rhero .chips{margin-top:22px}
.rhero .chip{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.3);color:#fff;backdrop-filter:blur(8px);font-size:12px;padding:6px 13px;font-weight:600}
