---
// ThailandAddict — ArticleLayout (Vibrant Island Pop / Direction C)
// Renders food / attraction / itinerary / prep / guide articles from a flexible block list.
const { data, lang = 'th' } = Astro.props;
const isEn = lang === 'en';
const SITE = 'https://thailandaddict.com';
const IMG_BASE = import.meta.env.PUBLIC_IMG_BASE || 'https://pub-65cf98dcb15e4c06a7a465ec411b870a.r2.dev';   // R2 public bucket (override via PUBLIC_IMG_BASE env)
const link = (href: string) => (isEn ? `/en/${href}`.replace(/\/+/g, '/') : `/${href}`.replace(/\/+/g, '/'));
const asset = (p: string) => (!p ? p : (/^(https?:)?\/\//.test(p) ? p : IMG_BASE + (p.startsWith('/') ? p : `/${p}`)));
const S = isEn
  ? { home: 'Home', th: 'Thailand', nav: ['Destinations','Stays','See','Eat','About'], cta: 'Find a hotel', faqH: 'FAQ', relH: 'Related', ftTag: 'Thailand, Done Right',
      priceLabel: 'Approx. price', sigLabel: 'Signature', mustLabel: 'Must-try', stayDefault: 'Stay nearby', mapLabel: 'View map', fbLabel: 'Facebook page',
      hoursL: 'Hours', halalL: 'Halal', vegL: 'Veg options', enMenuL: 'English menu', spiceL: 'Spice', usdL: '≈',
      mapTitle: 'All restaurants on the map', mapSub: 'Tap a pin for the spot + nearby stays', mapStay: 'Stays near here', railH: 'Where to stay nearby', railFoodH: 'Food tours & classes', railFoodSub: 'Guided tastings & hands-on classes · via Klook', railFoodAll: 'See all experiences',
      copyTitle: 'Copyright & Image Takedown Policy', copyA: 'Thailandaddict is created to review and share travel experiences. Where an image is sourced from elsewhere, we credit the source. If you are the copyright owner and prefer that your image not appear on this site, please ', copyLink: 'contact us', copyB: ' and we will gladly remove the image or correct the information.',
      ftDesc: 'A Thailand travel guide from real travelers — honest reviews of stays, things to do and food across the country.', ftDestH: 'Destinations', ftThai: '🇹🇭 Explore Thailand', ftContentH: 'Content', ftEat: 'Where to eat', ftSee: 'Things to do', ftStay: 'Where to stay', ftAboutH: 'About', ftAboutUs: 'About us', ftEditorial: 'Editorial Policy', ftContact: 'Contact', ftPrivacy: 'Privacy', ftCopy: '© 2026 thailandaddict.com — Thailand, done right',
      freshL: 'Last checked', freshNote: ' · details and hours can change — check the venue before you go', fType: 'Type', fAll: 'All', fZone: 'Area', fPrice: 'Price', fVeg: '🥗 Veg', fHalal: '🕌 Halal', fCountTpl: 'Showing {s}/{t} places', bestForL: '👍 Best for', reviewsL: 'reviews', nearL: 'Nearest: ' }
  : { home: 'หน้าแรก', th: 'ประเทศไทย', nav: ['จุดหมาย','ที่พัก','ที่เที่ยว','ของกิน','เกี่ยวกับเรา'], cta: 'ค้นหาที่พัก', faqH: 'คำถามที่พบบ่อย', relH: 'อ่านต่อ', ftTag: 'Thailand, Done Right',
      priceLabel: 'ราคาโดยประมาณ', sigLabel: 'ซิกเนเจอร์', mustLabel: 'ต้องลอง', stayDefault: 'ที่พักใกล้ร้านนี้', mapLabel: 'ดูแผนที่', fbLabel: 'เพจร้าน',
      hoursL: 'เวลาเปิด', halalL: 'ฮาลาล', vegL: 'มีเมนูเจ/มังสวิรัติ', enMenuL: 'เมนูอังกฤษ', spiceL: 'ความเผ็ด', usdL: '≈',
      mapTitle: 'แผนที่ร้านทั้งหมด', mapSub: 'แตะหมุดเพื่อดูร้าน + ที่พักย่านนั้น', mapStay: 'ที่พักย่านนี้', railH: 'รีวิวที่พักน่าสนใจแถวนี้', railFoodH: 'ฟู้ดทัวร์ & คลาสทำอาหาร', railFoodSub: 'มีไกด์พาไป / ลงมือทำเอง · จองผ่าน Klook', railFoodAll: 'ดูประสบการณ์ทั้งหมด',
      copyTitle: 'นโยบายลิขสิทธิ์และการแจ้งลบภาพ', copyA: 'เว็บไซต์ Thailandaddict จัดทำขึ้นเพื่อรีวิวและแบ่งปันประสบการณ์ หากภาพใดนำมาจากแหล่งข้อมูลอื่น เราได้ระบุแหล่งที่มาไว้แล้ว หากท่านเป็นเจ้าของลิขสิทธิ์และไม่ประสงค์ให้ปรากฏภาพบนเว็บไซต์ โปรด', copyLink: 'ติดต่อเรา', copyB: 'ได้ทันที ทางเรายินดีดำเนินการลบภาพหรือแก้ไขข้อมูลให้ถูกต้องครับ',
      ftDesc: 'คู่มือเที่ยวไทยจากคนเที่ยวจริง รีวิวที่พัก ที่เที่ยว และของกินทั่วประเทศ', ftDestH: 'จุดหมาย', ftThai: '🇹🇭 เที่ยวไทย', ftContentH: 'คอนเทนต์', ftEat: 'ที่กิน', ftSee: 'ที่เที่ยว', ftStay: 'ที่พัก', ftAboutH: 'เกี่ยวกับ', ftAboutUs: 'เกี่ยวกับเรา', ftEditorial: 'นโยบายบรรณาธิการ', ftContact: 'ติดต่อ', ftPrivacy: 'ความเป็นส่วนตัว', ftCopy: '© 2026 thailandaddict.com — เที่ยวไทยแบบรู้จริง',
      freshL: 'ตรวจสอบล่าสุด', freshNote: ' · ข้อมูลร้าน/เวลาเปิดอาจเปลี่ยน เช็กกับเพจร้านก่อนไปอีกที', fType: 'ประเภท', fAll: 'ทั้งหมด', fZone: 'ย่าน', fPrice: 'ราคา', fVeg: '🥗 มังสวิรัติ', fHalal: '🕌 ฮาลาล', fCountTpl: 'แสดง {s}/{t} ร้าน', bestForL: '👍 เหมาะสุดสำหรับ', reviewsL: 'รีวิว', nearL: 'ร้านใกล้สุด: ' };

const canonical = `${SITE}${isEn ? '/en' : ''}/${data.slug}`;
const faq = data.faq ?? [];
const strip = (s) => (s || '').replace(/<[^>]+>/g, '').trim();
const comma = (n) => (typeof n === 'number' ? n.toLocaleString('en-US') : n);
const TH_MON = ['ม.ค.','ก.พ.','มี.ค.','เม.ย.','พ.ค.','มิ.ย.','ก.ค.','ส.ค.','ก.ย.','ต.ค.','พ.ย.','ธ.ค.'];
const thaiDate = (iso) => { const p = String(iso || '').split('-'); return p.length === 3 ? `${parseInt(p[2],10)} ${TH_MON[parseInt(p[1],10)-1]} ${p[0]}` : (iso || ''); };
const EN_MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const fmtDate = (iso) => { const p = String(iso || '').split('-'); return p.length === 3 ? (isEn ? `${parseInt(p[2],10)} ${EN_MON[parseInt(p[1],10)-1]} ${p[0]}` : `${parseInt(p[2],10)} ${TH_MON[parseInt(p[1],10)-1]} ${p[0]}`) : (iso || ''); };
// Restaurant-roundup mode: rich editorial cards + immersive hero + quick-nav (only when restaurant blocks present)
const restos = (data.blocks ?? []).filter((b) => b.kind === 'restaurant');
const isResto = restos.length > 0;
// Map pins (only restaurants with real coordinates). Map renders only when ≥3 pins are available.
const geoRestos = restos.filter((b) => typeof b.lat === 'number' && typeof b.lng === 'number');
const haversineKm = (a, b) => { const R = 6371, toR = (d) => d * Math.PI / 180, dLa = toR(b.lat - a.lat), dLo = toR(b.lng - a.lng); const x = Math.sin(dLa/2)**2 + Math.cos(toR(a.lat)) * Math.cos(toR(b.lat)) * Math.sin(dLo/2)**2; return 2 * R * Math.asin(Math.sqrt(x)); };
const nearestOf = (b) => { let best = null, bd = Infinity; for (const o of geoRestos) { if (o.rank === b.rank) continue; const d = haversineKm(b, o); if (d < bd) { bd = d; best = o; } } return best ? { name: strip(best.name), km: bd } : null; };
const distLabel = (km) => (km < 1 ? `~${Math.max(50, Math.round(km * 1000 / 50) * 50)} ${isEn ? 'm' : 'ม.'}` : `~${km.toFixed(1)} ${isEn ? 'km' : 'กม.'}`);
const mapPins = geoRestos.map((b) => { const nr = nearestOf(b); return { rank: b.rank, name: strip(b.name), lat: b.lat, lng: b.lng, stayHref: b.stayHref ? link(b.stayHref) : '', stayLabel: b.stayLabel || S.mapStay, near: nr ? `${nr.name} · ${distLabel(nr.km)}` : '' }; });
const showMap = isResto && mapPins.length >= 3;
// v3 filters: zone / food-type / price-tier axes + diet toggles. Each group is conditional on data.
const priceTier = (u) => { const m = String(u || '').match(/([\d.]+)/); if (!m) return ''; const n = parseFloat(m[1]); return n < 5 ? '฿' : n <= 12 ? '฿฿' : '฿฿฿'; };
const zones = [...new Set(restos.map((b) => b.zone).filter(Boolean))];
const types = [...new Set(restos.map((b) => b.foodType).filter(Boolean))];
const prices = [...new Set(restos.map((b) => priceTier(b.priceUsd)).filter(Boolean))].sort((a, b) => a.length - b.length);
const hasVeg = restos.some((b) => b.veg);
const hasHalal = restos.some((b) => b.halal);
const showFilters = isResto && (zones.length >= 2 || types.length >= 2 || prices.length >= 2 || hasVeg || hasHalal);
// Sticky right-rail (desktop only): featured hotel roundups + the food-tour module, both follow scroll.
const railItems = (data.rail && data.rail.length ? data.rail : []);
const foodBlock = isResto ? (data.blocks.find((b) => b.kind === 'foodexp') || null) : null;
const hasRail = isResto && (railItems.length > 0 || !!foodBlock);
const jsonld = {
  '@context': 'https://schema.org', '@graph': [
    { '@type': 'Article', headline: data.title, description: data.metaDesc, inLanguage: isEn ? 'en' : 'th',
      author: { '@type': 'Organization', name: 'ThailandAddict' },
      publisher: { '@type': 'Organization', name: 'ThailandAddict', url: SITE },
      ...(data.publishedDate ? { datePublished: data.publishedDate } : {}),
      ...(data.modifiedDate ? { dateModified: data.modifiedDate } : {}),
      ...((data.heroImg || data.image) ? { image: asset(data.heroImg || data.image) } : {}),
      mainEntityOfPage: canonical },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: S.home, item: `${SITE}${isEn ? '/en/' : '/'}` },
      { '@type': 'ListItem', position: 2, name: S.th, item: `${SITE}${isEn ? '/en' : ''}/country-thailand` },
      { '@type': 'ListItem', position: 3, name: data.crumbCity, item: `${SITE}${isEn ? '/en' : ''}/${data.crumbCityHref.replace(/\.html$/, '')}` },
      { '@type': 'ListItem', position: 4, name: data.title, item: canonical } ] },
    // Honest ItemList + Restaurant graph (no fabricated ratings) → rich results + AI answer-engine citations.
    ...(isResto ? [{ '@type': 'ItemList', name: strip(data.title), numberOfItems: restos.length,
      itemListElement: restos.map((b) => ({ '@type': 'ListItem', position: Number(b.rank),
        item: { '@type': 'Restaurant', name: strip(b.name),
          ...(b.cuisine ? { servesCuisine: strip(b.cuisine) } : {}),
          ...(b.priceRange ? { priceRange: strip(b.priceRange) } : {}),
          ...(b.lat && b.lng ? { geo: { '@type': 'GeoCoordinates', latitude: b.lat, longitude: b.lng } } : {}),
          ...(b.area ? { address: { '@type': 'PostalAddress', addressLocality: strip(b.area), addressRegion: data.crumbCity, addressCountry: 'TH' } } : {}),
          ...(b.img ? { image: b.img.startsWith('http') ? b.img : `${IMG_BASE || SITE}${b.img}` } : {}),
          ...(b.rating && b.ratingCount ? { aggregateRating: { '@type': 'AggregateRating', ratingValue: b.rating, reviewCount: b.ratingCount, bestRating: 5, worstRating: 1 } } : {}),
          url: `${canonical}#r${b.rank}` } })) }] : []),
    // Entity schema for AI answer-engines + Google knowledge graph (derived from existing data, nothing fabricated).
    ...(data.type === 'attraction' ? [{ '@type': 'TouristAttraction', name: strip(data.h1 || data.title), description: data.metaDesc,
      ...((data.heroImg || data.image) ? { image: asset(data.heroImg || data.image) } : {}),
      address: { '@type': 'PostalAddress', addressLocality: data.crumbCity, addressRegion: data.crumbCity, addressCountry: 'TH' },
      ...(data.lat && data.lng ? { geo: { '@type': 'GeoCoordinates', latitude: data.lat, longitude: data.lng } } : {}), url: canonical }] : []),
    ...(data.type === 'itinerary' ? [{ '@type': 'TouristTrip', name: strip(data.h1 || data.title), description: data.metaDesc,
      ...((data.heroImg || data.image) ? { image: asset(data.heroImg || data.image) } : {}), url: canonical }] : []),
    ...(faq.length ? [{ '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []),
  ],
};
const favSvg = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='24' fill='%2306B6D4'/%3E%3Ctext x='50' y='68' font-family='Outfit,sans-serif' font-size='60' font-weight='bold' fill='white' text-anchor='middle'%3ET%3C/text%3E%3C/svg%3E";
---
<!doctype html>
<html lang={isEn ? 'en' : 'th'}>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1.0" />
<title>{data.title}</title>
<meta name="description" content={data.metaDesc} />
{data.keywords && <meta name="keywords" content={data.keywords} />}
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href={favSvg} />
<meta property="og:site_name" content="ThailandAddict" />
<meta property="og:title" content={data.ogTitle ?? data.title} />
<meta property="og:description" content={data.ogDesc ?? data.metaDesc} />
<meta property="og:type" content="article" />
<meta property="og:url" content={canonical} />
{(data.image || data.heroImg) && <meta property="og:image" content={asset(data.image || data.heroImg)} />}
<meta property="og:locale" content={isEn ? 'en_US' : 'th_TH'} />
<link rel="alternate" hreflang="th" href={`${SITE}/${data.slug}`} />
<link rel="alternate" hreflang="en" href={`${SITE}/en/${data.slug}`} />
<meta name="theme-color" content="#06B6D4" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Sarabun:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
<script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
{showMap && <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />}
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{--teal:#06B6D4;--teal-dk:#0891b2;--coral:#FB7185;--coral-dk:#f43f5e;--mango:#FBBF24;--ink:#0F172A;--sub:#64748b;--bg:#ffffff;--soft:#f1fbfd;--bdr:#e6eef2}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{font-family:'Sarabun',sans-serif;background:var(--bg);color:var(--ink);line-height:1.75;-webkit-font-smoothing:antialiased;overflow-x:clip}
a{color:inherit;text-decoration:none}img{display:block;max-width:100%}
.wrap{max-width:820px;margin:0 auto;padding:0 24px}
.nav{display:flex;align-items:center;justify-content:space-between;padding:16px 28px;border-bottom:1px solid var(--bdr);position:sticky;top:0;background:rgba(255,255,255,.85);backdrop-filter:blur(14px);z-index:99}
.logo{font-family:'Outfit';font-size:24px;font-weight:800;letter-spacing:-.5px;color:var(--ink)}.logo em{font-style:normal;color:var(--teal)}
.nmid{display:flex;gap:6px}@media(max-width:820px){.nmid{display:none}}
.nmid a{font-family:'Outfit';font-size:14px;font-weight:600;color:var(--sub);padding:8px 13px;border-radius:999px}.nmid a:hover{color:var(--teal);background:var(--soft)}
.nr{display:flex;align-items:center;gap:12px}
.lang{font-family:'Outfit';font-size:12px;font-weight:700;background:var(--soft);border-radius:999px;display:inline-flex;padding:2px}
.lang a{padding:5px 10px;color:var(--teal);border-radius:999px}.lang a.on{background:var(--teal);color:#fff}
.cta{font-family:'Outfit';font-size:13px;font-weight:800;background:linear-gradient(135deg,var(--coral),var(--coral-dk));color:#fff;padding:11px 20px;border-radius:999px;box-shadow:0 10px 22px rgba(244,63,94,.32);border:none;cursor:pointer}@media(max-width:820px){.cta{display:none}}
.hb{display:none;background:none;border:none;font-size:24px;color:var(--ink);cursor:pointer}@media(max-width:820px){.hb{display:block}}
.mm{position:fixed;inset:0;z-index:1000;background:#fff;transform:translateX(100%);transition:.3s;display:flex;flex-direction:column;padding:24px;overflow-y:auto}.mm.open{transform:translateX(0)}
.mm-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.mm-x{background:none;border:none;font-size:28px;cursor:pointer}
.mm a{font-family:'Outfit';font-size:19px;font-weight:700;padding:14px 0;border-bottom:1px solid var(--bdr)}
.crumb{max-width:820px;margin:0 auto;padding:18px 24px 0;font-family:'Outfit';font-size:12.5px;color:var(--sub)}.crumb a:hover{color:var(--teal)}
.hero{padding:34px 0 26px;position:relative;overflow:hidden;background:linear-gradient(135deg,#ecfeff,#fff 55%,#fff5f7);height:auto;min-height:0}
.hero .eyebrow{display:inline-block;font-family:'Outfit';font-size:12.5px;font-weight:800;letter-spacing:.5px;color:var(--teal-dk);background:#cffafe;padding:6px 14px;border-radius:999px;margin-bottom:14px}
.hero h1{font-family:'Outfit';font-size:clamp(30px,5vw,46px);font-weight:900;line-height:1.1;letter-spacing:-1px}
.hero .lead{font-size:17px;color:var(--sub);margin-top:14px}
.chips{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}
.chip{font-family:'Outfit';font-size:12.5px;font-weight:700;background:#fff;border:2px solid var(--bdr);border-radius:999px;padding:7px 14px}
.heroimg{display:block;width:100%;max-width:820px;margin:22px auto 0;border-radius:20px;aspect-ratio:16/9;object-fit:cover;box-shadow:0 16px 40px rgba(15,23,42,.12)}
.body{padding:30px 0 10px}
.body h2{font-family:'Outfit';font-size:24px;font-weight:800;letter-spacing:-.4px;margin:34px 0 12px;scroll-margin-top:80px}
.body h2:first-child{margin-top:0}
.body p{font-size:16px;color:#1e293b;margin:0 0 14px}.body p strong{color:var(--ink);font-weight:700}
.body ul{margin:0 0 16px;padding-left:4px;list-style:none}
.body ul li{position:relative;padding:6px 0 6px 26px;font-size:15.5px;color:#1e293b}
.body ul li::before{content:'';position:absolute;left:4px;top:14px;width:8px;height:8px;border-radius:50%;background:linear-gradient(135deg,var(--teal),var(--coral))}
/* ===== Restaurant roundup — editorial "award" layout ===== */
.rhero{background-size:cover;background-position:center;color:#fff;padding:clamp(64px,13vw,128px) 0 clamp(40px,7vw,76px)}
.rhero .wrap{max-width:860px}
.rhero .eyebrow{background:rgba(255,255,255,.16);color:#fff;border:1px solid rgba(255,255,255,.28);backdrop-filter:blur(6px)}
.rhero h1{font-family:'Outfit';font-size:clamp(33px,6.2vw,56px);font-weight:900;line-height:1.07;letter-spacing:-1.2px;text-shadow:0 2px 30px rgba(0,0,0,.4)}
.rhero h1 .hi{color:var(--mango)}.rhero h1 .hi2{color:#fff}
.rhero .lead{color:rgba(255,255,255,.93);font-size:clamp(16px,2.3vw,19px);max-width:700px;margin-top:16px;text-shadow:0 1px 14px rgba(0,0,0,.45)}
.rhero .chips{margin-top:22px}
.rhero .chip{background:rgba(255,255,255,.13);border:1.5px solid rgba(255,255,255,.34);color:#fff;backdrop-filter:blur(6px)}
.qnav{position:sticky;top:60px;z-index:40;background:rgba(255,255,255,.92);backdrop-filter:blur(14px);border-bottom:1px solid var(--bdr)}
.qnav-row{max-width:980px;margin:0 auto;display:flex;gap:8px;overflow-x:auto;padding:11px 20px;scrollbar-width:none}.qnav-row::-webkit-scrollbar{display:none}
.qnav-row a{flex:0 0 auto;display:inline-flex;align-items:center;gap:7px;font-family:'Outfit';font-size:13px;font-weight:600;color:var(--sub);background:var(--soft);border:1px solid var(--bdr);border-radius:999px;padding:6px 14px 6px 7px;white-space:nowrap;transition:.15s}
.qnav-row a:hover{color:var(--teal-dk);border-color:var(--teal);background:#fff}
.qnav-row a b{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;background:linear-gradient(135deg,var(--teal),var(--coral));color:#fff;font-size:11px;font-weight:900}
/* card layout — mirrors hotel-roundup rhythm: header band + fixed image sidebar + flexible text */
.resto{background:#fff;border:1px solid var(--bdr);border-radius:24px;overflow:hidden;margin:0 0 26px;box-shadow:0 10px 30px rgba(15,23,42,.06);transition:box-shadow .25s,transform .25s;scroll-margin-top:128px}
.resto:hover{box-shadow:0 22px 48px -18px rgba(15,23,42,.24);transform:translateY(-3px)}
.resto-head{display:flex;align-items:flex-start;gap:15px;padding:20px 24px 16px;border-bottom:1px solid var(--bdr)}
.resto-rank{width:48px;height:48px;border-radius:15px;background:linear-gradient(135deg,var(--teal),var(--coral));color:#fff;font-family:'Outfit';font-weight:900;font-size:24px;display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 8px 18px rgba(244,63,94,.32)}
.resto-head-info{flex:1;min-width:0}
.resto-type{font-family:'Outfit';font-size:11px;letter-spacing:1.2px;text-transform:uppercase;color:var(--sub);font-weight:700;margin-bottom:3px}
.resto-name{font-family:'Outfit';font-size:clamp(20px,2.8vw,25px);font-weight:900;letter-spacing:-.4px;line-height:1.16;color:var(--ink)}
.resto-meta{display:flex;align-items:center;flex-wrap:wrap;gap:8px 14px;margin-top:9px;font-family:'Outfit';font-size:13px;font-weight:600;color:var(--sub)}
.resto-score{display:inline-flex;align-items:center;gap:4px;background:linear-gradient(135deg,var(--mango),#f59e0b);color:#fff;padding:3px 11px;border-radius:999px;font-size:12.5px;font-weight:800}
.resto-body{display:grid;grid-template-columns:280px 1fr;gap:0}
@media(max-width:720px){.resto-body{grid-template-columns:1fr}}
.resto-media{background:var(--soft);border-right:1px solid var(--bdr);display:flex;flex-direction:column}
@media(max-width:720px){.resto-media{border-right:none;border-bottom:1px solid var(--bdr)}}
.resto-imgwrap{position:relative;aspect-ratio:4/3;overflow:hidden;background:#e6eef2;flex-shrink:0}
.resto-imgwrap img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s}
.resto:hover .resto-imgwrap img{transform:scale(1.04)}
.resto-cred{position:absolute;left:11px;bottom:11px;background:rgba(15,23,42,.62);backdrop-filter:blur(4px);color:#fff;font-family:'Outfit';font-size:10px;font-weight:600;padding:4px 10px;border-radius:999px;max-width:88%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.resto-cred a{color:#fff}
.resto-side{padding:14px 16px 16px;display:flex;flex-direction:column;gap:10px;flex:1}
.resto-price{font-family:'Outfit';line-height:1.15}
.resto-price .pl{display:block;font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:var(--sub);font-weight:700}
.resto-price .pv{font-size:19px;font-weight:900;color:var(--teal-dk);letter-spacing:-.3px}
.resto-act{display:flex;flex-direction:column;gap:8px;margin-top:auto}
.rbtn{font-family:'Outfit';font-weight:800;font-size:13px;padding:11px 14px;border-radius:12px;display:inline-flex;align-items:center;justify-content:center;gap:7px;transition:transform .15s,box-shadow .2s}
.rbtn.stay{background:linear-gradient(135deg,var(--coral),var(--coral-dk));color:#fff;box-shadow:0 6px 16px rgba(244,63,94,.32)}
.rbtn.map{background:linear-gradient(135deg,var(--teal),var(--teal-dk));color:#fff;box-shadow:0 6px 16px rgba(6,182,212,.3)}
.rbtn.fb{background:#fff;border:2px solid var(--bdr);color:var(--ink)}
.rbtn:hover{transform:translateY(-2px)}
.resto-content{padding:20px 24px 22px;min-width:0}
.resto-tags{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:14px}
.resto-tag{font-family:'Outfit';font-size:11.5px;font-weight:700;padding:4px 12px;border-radius:999px;white-space:nowrap}
.resto-tag.c0{background:#cffafe;color:var(--teal-dk)}.resto-tag.c1{background:#fff1f3;color:var(--coral-dk)}.resto-tag.c2{background:#fef6e0;color:#b45309}
.resto-sig{display:flex;gap:9px;align-items:flex-start;background:var(--soft);border-left:4px solid var(--teal);border-radius:0 12px 12px 0;padding:10px 14px;margin-bottom:15px;font-size:13.5px;line-height:1.6;color:#1e293b}
.resto-sig b{font-family:'Outfit';color:var(--teal-dk);font-weight:800}
.resto-desc{font-size:15px;color:#1e293b;line-height:1.8}.resto-desc strong{color:var(--ink);font-weight:700}.resto-desc p{margin:0 0 12px}.resto-desc p:last-child{margin-bottom:0}
.resto-must{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:16px;padding-top:14px;border-top:1px dashed var(--bdr)}
.resto-must .ml{font-family:'Outfit';font-weight:800;font-size:11px;color:var(--teal-dk);text-transform:uppercase;letter-spacing:.6px}
.resto-must .mo{font-family:'Outfit';font-size:12.5px;font-weight:600;background:#fff;border:1px solid var(--bdr);border-radius:999px;padding:5px 12px}
.staycta{background:linear-gradient(125deg,var(--teal-dk),var(--coral));background-size:cover;background-position:center;border-radius:26px;padding:clamp(28px,5vw,46px);margin:clamp(34px,5.5vw,56px) 0;color:#fff;box-shadow:0 24px 54px -16px rgba(244,63,94,.5)}
.staycta-in{max-width:700px}
.staycta h3{font-family:'Outfit';font-weight:900;font-size:clamp(22px,3.5vw,31px);line-height:1.18;letter-spacing:-.4px;text-shadow:0 2px 18px rgba(0,0,0,.28)}
.staycta p{font-size:15.5px;color:rgba(255,255,255,.96);line-height:1.7;margin:12px 0 20px;text-shadow:0 1px 10px rgba(0,0,0,.25)}
.staycta-links{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:22px}@media(max-width:600px){.staycta-links{grid-template-columns:1fr}}
.staycta-links a{display:flex;flex-direction:column;gap:2px;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.32);backdrop-filter:blur(6px);border-radius:14px;padding:12px 16px;font-family:'Outfit';font-weight:700;font-size:14.5px;color:#fff;transition:.15s}
.staycta-links a:hover{background:rgba(255,255,255,.27);transform:translateY(-1px)}
.staycta-links a .ll{display:flex;align-items:center;gap:7px}.staycta-links a small{font-weight:500;font-size:12px;opacity:.86}
.staycta-btn{display:inline-flex;align-items:center;gap:8px;background:#fff;color:var(--coral-dk);font-family:'Outfit';font-weight:800;font-size:15px;padding:14px 28px;border-radius:999px;box-shadow:0 12px 26px rgba(0,0,0,.2);transition:transform .15s}.staycta-btn:hover{transform:translateY(-2px)}
/* global-tourist info badges */
.resto-info{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:15px}
.resto-info .ri{display:inline-flex;align-items:center;gap:5px;font-family:'Outfit';font-size:12px;font-weight:600;color:var(--sub);background:var(--soft);border:1px solid var(--bdr);border-radius:999px;padding:4px 11px}
.resto-info .ri b{font-weight:400}
.resto-info .ri.ok{color:var(--teal-dk);background:#cffafe;border-color:transparent;font-weight:700}
/* food-experience (tours / cooking classes) module */
.foodexp{background:var(--soft);border:1.5px solid var(--bdr);border-radius:24px;padding:clamp(22px,4vw,34px);margin:clamp(30px,5vw,48px) 0}
.foodexp-head{display:flex;gap:14px;align-items:flex-start;margin-bottom:18px}
.foodexp-ic{font-size:34px;line-height:1;flex-shrink:0}
.foodexp-head h3{font-family:'Outfit';font-weight:900;font-size:clamp(19px,2.8vw,24px);letter-spacing:-.3px;line-height:1.2;color:var(--ink)}
.foodexp-head p{font-size:14.5px;color:var(--sub);line-height:1.6;margin-top:6px}
.foodexp-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:11px;margin-bottom:18px}@media(max-width:600px){.foodexp-grid{grid-template-columns:1fr}}
.foodexp-card{position:relative;display:flex;align-items:center;gap:12px;background:#fff;border:1px solid var(--bdr);border-radius:15px;padding:13px 15px 13px 15px;transition:.15s}
.foodexp-card:hover{border-color:var(--teal);box-shadow:0 8px 20px rgba(6,182,212,.14);transform:translateY(-1px)}
.foodexp-emoji{font-size:24px;flex-shrink:0}
.foodexp-body{display:flex;flex-direction:column;gap:2px;min-width:0}
.foodexp-label{font-family:'Outfit';font-weight:700;font-size:14.5px;color:var(--ink);line-height:1.25}
.foodexp-body small{font-size:12px;color:var(--sub)}
.foodexp-prov{position:absolute;top:9px;right:11px;font-family:'Outfit';font-size:9.5px;font-weight:800;letter-spacing:.5px;text-transform:uppercase;color:var(--coral-dk)}
.foodexp-btn{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg,var(--teal),var(--teal-dk));color:#fff;font-family:'Outfit';font-weight:800;font-size:14.5px;padding:13px 26px;border-radius:999px;box-shadow:0 12px 24px rgba(6,182,212,.3);transition:transform .15s}.foodexp-btn:hover{transform:translateY(-2px)}
/* experiences (tours / tickets) module — coral accent to differentiate from the food (teal) module */
.exp{background:linear-gradient(135deg,#fff5f7,#ecfeff)}
.exp .foodexp-btn{background:linear-gradient(135deg,var(--coral),var(--coral-dk));box-shadow:0 12px 24px rgba(244,63,94,.3)}
.exp .foodexp-prov{color:var(--teal-dk)}
/* all-restaurants map (Leaflet / OpenStreetMap) */
.rmap-sec{padding:4px 0 18px}
.rmap-h{font-family:'Outfit';font-weight:900;font-size:clamp(20px,3vw,26px);letter-spacing:-.4px;color:var(--ink)}
.rmap-sub{font-size:14px;color:var(--sub);margin:5px 0 16px}
#rmap{height:clamp(320px,52vw,440px);border-radius:20px;border:1.5px solid var(--bdr);box-shadow:0 14px 36px rgba(15,23,42,.1);position:relative;z-index:1}
/* Leaflet markers/popups are created at RUNTIME → must be :global (scoped styles wouldn't match) */
:global(.rpin){background:none!important;border:none!important}
:global(.rpin span){display:flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:50%;background:#f43f5e;color:#fff;font-family:'Outfit',sans-serif;font-weight:900;font-size:18px;line-height:1;box-shadow:0 4px 12px rgba(0,0,0,.55);border:3px solid #fff;text-shadow:0 1px 2px rgba(0,0,0,.35)}
:global(.leaflet-popup-content){font-family:'Sarabun',sans-serif;font-size:14px;margin:11px 14px}
:global(.leaflet-popup-content b){font-family:'Outfit',sans-serif;font-weight:800}
:global(.leaflet-popup-content a){color:#0891b2;font-weight:700}
/* sticky right-rail of featured hotel roundups (desktop only; hidden on mobile) */
.rgrid{display:grid;grid-template-columns:minmax(0,1fr) 312px;gap:42px;max-width:1184px;align-items:start}
.rgrid .rmain{min-width:0}
/* sticky must be on the grid ITEM (.rrail), whose grid area spans the full article height,
   so it stays pinned while you scroll. (On an inner div it only sticks for its own height.) */
/* no internal scrollbar — whole rail is sticky and follows the page (kept compact to fit the viewport) */
.rrail{min-width:0;position:sticky;top:80px;align-self:start}
.rrail-in{display:flex;flex-direction:column;gap:9px}
.rrail-h{font-family:'Outfit';font-weight:800;font-size:13.5px;color:var(--ink);padding:2px 2px 8px;border-bottom:2px solid var(--bdr)}
.rrail-card{display:flex;background:#fff;border:1px solid var(--bdr);border-radius:14px;overflow:hidden;transition:.15s}
.rrail-card:hover{border-color:var(--teal);box-shadow:0 10px 24px rgba(6,182,212,.16);transform:translateY(-1px)}
.rrail-card img{width:80px;height:auto;align-self:stretch;object-fit:cover;flex-shrink:0;background:#e6eef2}
.rrail-body{display:flex;flex-direction:column;gap:2px;padding:8px 11px;min-width:0}
.rrail-title{font-family:'Outfit';font-weight:700;font-size:12.5px;line-height:1.26;color:var(--ink);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.rrail-body small{font-size:11px;color:var(--sub);line-height:1.35}
.rrail-go{font-family:'Outfit';font-weight:800;font-size:11px;color:var(--teal-dk);margin-top:2px}
.rrail-sec{display:flex;flex-direction:column;gap:9px}
.rrail-sec + .rrail-sec{margin-top:16px}
.rrail-fsub{font-size:11px;color:var(--sub);line-height:1.4;margin:-2px 0 1px}
.rrail-fcard{display:flex;align-items:center;gap:10px;background:#fff;border:1px solid var(--bdr);border-radius:13px;padding:7px 10px 7px 7px;transition:.16s}
.rrail-fcard:hover{border-color:var(--teal);box-shadow:0 9px 22px rgba(6,182,212,.16);transform:translateY(-1px)}
.rrail-ficon{width:42px;height:42px;border-radius:11px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:21px}
.rrail-fcard.c0 .rrail-ficon{background:linear-gradient(135deg,#cffafe,#a5f3fc)}
.rrail-fcard.c1 .rrail-ficon{background:linear-gradient(135deg,#ffe4e6,#fecdd3)}
.rrail-fcard.c2 .rrail-ficon{background:linear-gradient(135deg,#fef3c7,#fde68a)}
.rrail-fcard.c3 .rrail-ficon{background:linear-gradient(135deg,#e0f2fe,#bae6fd)}
.rrail-fbody{display:flex;flex-direction:column;gap:2px;min-width:0;flex:1}
.rrail-ftitle{font-family:'Outfit';font-weight:700;font-size:12.5px;line-height:1.28;color:var(--ink)}
.rrail-fnote{font-size:10.5px;color:var(--sub);line-height:1.35;display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden}
.rrail-fchev{font-family:'Outfit';font-size:18px;font-weight:700;color:var(--sub);flex-shrink:0;transition:.16s}
.rrail-fcard:hover .rrail-fchev{color:var(--teal-dk);transform:translateX(2px)}
.rrail-fcta{display:flex;align-items:center;justify-content:center;gap:6px;background:linear-gradient(135deg,var(--teal),var(--teal-dk));color:#fff;font-family:'Outfit';font-weight:800;font-size:12px;padding:11px;border-radius:12px;margin-top:5px;box-shadow:0 8px 18px rgba(6,182,212,.28)}
.rrail-fcta span{font-size:15px;line-height:1}
.rrail-fcta:hover{filter:brightness(1.06)}
/* ===== v3: ratings, zone, best-for, gallery, local-tips, filters, freshness ===== */
.resto-zone{display:inline-flex;align-items:center;font-family:'Outfit';font-size:12px;font-weight:700;color:var(--teal-dk);background:#cffafe;border-radius:999px;padding:2px 10px}
.resto-bestfor{display:flex;align-items:center;gap:9px;flex-wrap:wrap;background:linear-gradient(135deg,#ecfeff,#fff5f7);border:1px solid var(--bdr);border-radius:12px;padding:8px 13px;margin-bottom:14px}
.resto-bestfor .bf-l{font-family:'Outfit';font-size:10.5px;font-weight:800;letter-spacing:.5px;color:var(--coral-dk);text-transform:uppercase;white-space:nowrap}
.resto-bestfor .bf-v{font-family:'Outfit';font-weight:700;font-size:14px;color:var(--ink)}
.resto-thumbs{display:flex;gap:6px;padding:8px;background:var(--soft);border-top:1px solid var(--bdr)}
.resto-thumb{flex:1;min-width:0;aspect-ratio:1/1;border:2px solid transparent;border-radius:9px;overflow:hidden;padding:0;background:#e6eef2;cursor:pointer;transition:.15s}
.resto-thumb img{width:100%;height:100%;object-fit:cover;display:block}
.resto-thumb:hover{border-color:var(--teal)}
.resto-thumb.on{border-color:var(--coral)}
.localtips{background:linear-gradient(135deg,#fffbeb,#fff5f7);border:1.5px solid var(--bdr);border-radius:22px;padding:clamp(22px,4vw,32px);margin:clamp(30px,5vw,46px) 0}
.lt-h{font-family:'Outfit';font-weight:900;font-size:clamp(19px,2.8vw,24px);letter-spacing:-.3px;color:var(--ink);margin-bottom:16px}
.lt-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:13px}@media(max-width:600px){.lt-grid{grid-template-columns:1fr}}
.lt-card{display:flex;gap:12px;background:#fff;border:1px solid var(--bdr);border-radius:14px;padding:13px 15px}
.lt-ic{font-size:24px;flex-shrink:0;line-height:1.25}
.lt-body b{font-family:'Outfit';font-weight:800;font-size:14px;color:var(--ink);display:block;margin-bottom:3px}
.lt-body p{font-size:13.5px;color:#475569;line-height:1.55}
.rfilter{display:flex;flex-direction:column;gap:9px;margin:0 0 24px;padding:14px 16px;background:var(--soft);border:1px solid var(--bdr);border-radius:16px}
.rfg{display:flex;align-items:center;flex-wrap:wrap;gap:7px}
.rfg-l{font-family:'Outfit';font-weight:800;font-size:11px;color:var(--sub);text-transform:uppercase;letter-spacing:.5px;min-width:50px}
.rchip{font-family:'Outfit';font-weight:700;font-size:12.5px;color:var(--sub);background:#fff;border:1.5px solid var(--bdr);border-radius:999px;padding:6px 13px;cursor:pointer;transition:.15s}
.rchip:hover{border-color:var(--teal);color:var(--teal-dk)}
.rchip.on{background:linear-gradient(135deg,var(--teal),var(--teal-dk));border-color:transparent;color:#fff}
.rchip.veg.on{background:linear-gradient(135deg,#10b981,#059669)}
.rchip.halal.on{background:linear-gradient(135deg,#0891b2,#0e7490)}
.rfilter-count{font-family:'Outfit';font-weight:700;font-size:12px;color:var(--teal-dk)}
.rfresh{font-size:12.5px;color:var(--sub);background:var(--soft);border:1px dashed var(--bdr);border-radius:10px;padding:8px 13px;margin:0 0 18px}
.imgpolicy{font-size:12.5px;color:var(--sub);background:var(--soft);border:1px solid var(--bdr);border-radius:14px;padding:16px 20px;margin-top:10px}
.imgpolicy h4{font-family:'Outfit';font-weight:800;font-size:13px;color:var(--ink);margin-bottom:6px}
.imgpolicy p{line-height:1.7;margin:0}
.imgpolicy a{color:var(--teal-dk);font-weight:700;text-decoration:underline}
/* food module shows in BOTH places on desktop (inline in content + in the sticky rail) per owner */
@media(max-width:1024px){.rgrid{display:block;max-width:820px}.rrail{display:none}}
@media(max-width:760px){.resto{grid-template-columns:1fr;gap:16px;margin:38px 0}.resto-media,.resto.flip .resto-media{order:-1}.resto-rank{top:-12px;left:-6px}}
.figimg{margin:18px 0 20px}.figimg img{width:100%;aspect-ratio:16/10;object-fit:cover;border-radius:18px;box-shadow:0 12px 30px rgba(15,23,42,.10)}
.figimg figcaption{font-family:'Outfit';font-size:12px;color:var(--sub);margin-top:8px;text-align:center;line-height:1.5}
.figimg .cap{display:block;color:#1e293b}.figimg .cred{display:block;font-size:11px;opacity:.85}.figimg .cred a{color:var(--teal-dk);text-decoration:underline}
.atbl-wrap{overflow-x:auto;margin:20px 0;border:1px solid var(--bdr);border-radius:16px;-webkit-overflow-scrolling:touch}
.atbl{width:100%;border-collapse:collapse;font-size:14.5px;min-width:480px}
.atbl caption{caption-side:top;text-align:left;font-family:'Outfit';font-weight:800;font-size:14px;color:var(--teal-dk);padding:12px 16px 0}
.atbl thead th{background:var(--soft);font-family:'Outfit';font-weight:800;font-size:13px;color:var(--ink);text-align:left;padding:11px 16px;border-bottom:2px solid var(--bdr);white-space:nowrap}
.atbl td{padding:11px 16px;border-bottom:1px solid var(--bdr);color:#1e293b;vertical-align:top}
.atbl tbody tr:last-child td{border-bottom:none}
.atbl tbody tr:nth-child(even){background:#fafdff}
.atbl td strong,.atbl td b{color:var(--ink);font-weight:700}
.tip{background:var(--soft);border:2px solid #cffafe;border-radius:18px;padding:18px 20px;margin:18px 0}
.tip h4{font-family:'Outfit';font-weight:800;font-size:15px;color:var(--teal-dk);margin-bottom:5px}.tip p{font-size:14.5px;color:#1e293b;margin:0}
.ranked{display:flex;flex-direction:column;gap:12px;margin:16px 0}
.rk{display:grid;grid-template-columns:auto 1fr;gap:16px;background:#fff;border:1px solid var(--bdr);border-radius:18px;padding:18px;box-shadow:0 8px 22px rgba(15,23,42,.05)}
.rk .n{width:40px;height:40px;border-radius:13px;background:linear-gradient(135deg,var(--teal),var(--teal-dk));color:#fff;font-family:'Outfit';font-weight:900;font-size:17px;display:flex;align-items:center;justify-content:center}
.rk h3{font-family:'Outfit';font-weight:800;font-size:17px;margin-bottom:3px}.rk h3 a:hover{color:var(--teal-dk)}
.rk .m{font-family:'Outfit';font-size:12.5px;color:var(--sub);font-weight:600;margin-bottom:6px}
.rk p{font-size:14.5px;color:#1e293b;margin:0 0 8px}
.rk .tags{display:flex;gap:6px;flex-wrap:wrap}.rk .tag{font-family:'Outfit';font-size:11px;font-weight:700;background:var(--soft);color:var(--teal-dk);padding:4px 10px;border-radius:999px}
.rk .pr{font-family:'Outfit';font-weight:800;color:var(--coral-dk);font-size:14px;margin-top:6px}
.cards{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin:16px 0}@media(max-width:600px){.cards{grid-template-columns:1fr}}
.cd{background:#fff;border:1px solid var(--bdr);border-radius:18px;padding:18px;box-shadow:0 8px 22px rgba(15,23,42,.05)}
.cd .tag{display:inline-block;font-family:'Outfit';font-size:11px;font-weight:800;background:#cffafe;color:var(--teal-dk);padding:3px 9px;border-radius:999px;margin-bottom:8px}
.cd h3{font-family:'Outfit';font-weight:800;font-size:16px;margin-bottom:4px}.cd p{font-size:14px;color:var(--sub);margin:0}
.day{background:#fff;border:1px solid var(--bdr);border-left:5px solid var(--teal);border-radius:16px;padding:18px 20px;margin:14px 0;box-shadow:0 8px 22px rgba(15,23,42,.05)}
.day .dl{font-family:'Outfit';font-weight:900;font-size:13px;color:var(--teal-dk);letter-spacing:.5px;text-transform:uppercase}
.day h3{font-family:'Outfit';font-weight:800;font-size:18px;margin:2px 0 12px}
.day .step{display:grid;grid-template-columns:84px 1fr;gap:12px;padding:9px 0;border-top:1px dashed var(--bdr)}
.day .step:first-of-type{border-top:none}.day .tm{font-family:'Outfit';font-weight:800;font-size:13px;color:var(--coral-dk)}
.day .ac{font-size:15px}.day .ac small{display:block;color:var(--sub);font-size:13px;margin-top:2px}
.ctaband{background:linear-gradient(135deg,var(--teal),var(--coral));border-radius:24px;padding:34px;text-align:center;color:#fff;margin:26px 0}
.ctaband p{font-size:17px;font-weight:600;margin-bottom:16px}
.ctaband a{font-family:'Outfit';font-weight:800;font-size:14px;background:#fff;color:var(--teal-dk);padding:13px 26px;border-radius:999px;display:inline-block}
.faq{margin:30px 0}.faq h2{font-family:'Outfit';font-size:24px;font-weight:800;margin-bottom:14px}
.faq details{background:#fff;border:1px solid var(--bdr);border-radius:14px;padding:14px 18px;margin-bottom:10px}
.faq summary{font-family:'Outfit';font-weight:700;font-size:15.5px;cursor:pointer;list-style:none}.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:'+';float:right;color:var(--teal);font-weight:800}.faq details[open] summary::after{content:'–'}
.faq details p{margin-top:10px;font-size:14.5px;color:#1e293b}
.related{margin:30px 0}.related h2{font-family:'Outfit';font-size:22px;font-weight:800;margin-bottom:14px}
.related .rg{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}@media(max-width:600px){.related .rg{grid-template-columns:1fr}}
.related a{background:#fff;border:1px solid var(--bdr);border-radius:14px;padding:14px 16px;font-family:'Outfit';font-weight:700;font-size:14.5px;box-shadow:0 6px 16px rgba(15,23,42,.04)}
.related a:hover{border-color:var(--teal);color:var(--teal-dk)}
.ft{background:var(--ink);color:#94a3b8;padding:46px 28px 26px;margin-top:30px}
.ftg{max-width:1080px;margin:0 auto;display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:28px}@media(max-width:680px){.ftg{grid-template-columns:1fr 1fr}}
.ftlogo{font-family:'Outfit';font-size:23px;font-weight:800;color:#fff}.ftlogo em{font-style:normal;color:var(--teal)}
.fttag{font-family:'Outfit';font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--mango);margin:6px 0 12px;font-weight:700}
.ft h4{font-family:'Outfit';font-size:11px;letter-spacing:1px;text-transform:uppercase;color:#64748b;margin-bottom:11px;font-weight:700}
.ft a{display:block;font-size:13px;color:#94a3b8;margin-bottom:8px}.ft a:hover{color:#fff}
.ftbar{max-width:1080px;margin:24px auto 0;padding-top:18px;border-top:1px solid rgba(255,255,255,.1);font-family:'Outfit';font-size:12px;color:#64748b}
</style>
</head>
<body>
<nav class="nav">
  <a href={link('/')} class="logo">Thailand<em>Addict</em></a>
  <div class="nmid">
    <a href={link('country-thailand.html')}>{S.nav[0]}</a>
    <a href={link('country-thailand.html#hotels')}>{S.nav[1]}</a>
    <a href={link('country-thailand.html#see')}>{S.nav[2]}</a>
    <a href={link('country-thailand.html#eat')}>{S.nav[3]}</a>
    <a href={link('plan-your-trip.html')}>{isEn ? 'Plan Trip' : 'เตรียมตัว'}</a>
    <a href={link('about.html')}>{S.nav[4]}</a>
  </div>
  <div class="nr">
    <span class="lang"><a href={`/${data.slug}`} class={isEn ? '' : 'on'}>TH</a><a href={`/en/${data.slug}`} class={isEn ? 'on' : ''}>EN</a></span>
    <a href={link('search.html')} aria-label={isEn ? 'Search' : 'ค้นหา'} style="font-size:17px;padding:6px 9px;line-height:1">🔎</a>
    <button class="cta" onclick="window.open('https://www.agoda.com/?cid=1965862','_blank')">{S.cta}</button>
    <button class="hb" id="hb">☰</button>
  </div>
</nav>
<div class="mm" id="mm">
  <div class="mm-top"><a href={link('/')} class="logo">Thailand<em>Addict</em></a><button class="mm-x" id="mmx">✕</button></div>
  <a href={link('/')}>{S.home}</a>
  <a href={link('country-thailand.html')}>{S.nav[0]}</a>
  <a href={link(data.crumbCityHref)}>{data.crumbCity}</a>
  <a href={link('plan-your-trip.html')}>{isEn ? '🧭 Plan Your Trip' : '🧭 เตรียมตัวเที่ยว'}</a>
  <a href={link('search.html')}>{isEn ? '🔎 Search' : '🔎 ค้นหา'}</a>
  <a href={link('about.html')}>{S.nav[4]}</a>
</div>

<div class="crumb"><a href={link('/')}>{S.home}</a> › <a href={link('country-thailand.html')}>{S.th}</a> › <a href={link(data.crumbCityHref)}>{data.crumbCity}</a> › <span>{data.h1}</span></div>

{isResto && data.heroImg ? (
  <section class="rhero" style={`background-image:linear-gradient(177deg,rgba(15,23,42,.12) 0%,rgba(15,23,42,.40) 45%,rgba(15,23,42,.86) 100%),url('${asset(data.heroImg)}')`}>
    <div class="wrap">
      <span class="eyebrow">{data.heroEmoji} {data.eyebrow}</span>
      <h1 set:html={data.h1} />
      <p class="lead" set:html={data.intro} />
      {data.chips && data.chips.length > 0 &&
        <div class="chips">{data.chips.map((c) => <span class="chip" set:html={c} />)}</div>}
    </div>
  </section>
) : (
  <>
    <section class="hero"><div class="wrap">
      <span class="eyebrow">{data.heroEmoji} {data.eyebrow}</span>
      <h1 set:html={data.h1} />
      <p class="lead" set:html={data.intro} />
      {data.chips && data.chips.length > 0 &&
        <div class="chips">{data.chips.map((c) => <span class="chip" set:html={c} />)}</div>}
    </div></section>
    {data.heroImg && <img class="heroimg" src={asset(data.heroImg)} alt={data.h1.replace(/<[^>]+>/g,' ')} onerror="this.remove()" />}
  </>
)}
{isResto &&
  <nav class="qnav"><div class="qnav-row">{restos.map((r) => <a href={`#r${r.rank}`}><b>{r.rank}</b><span set:html={r.name} /></a>)}</div></nav>}

{showMap && <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>}
{showMap && (
  <script define:vars={{ pins: mapPins, nearL: S.nearL }}>
    (function () {
      function init() {
        if (!window.L || !document.getElementById('rmap')) return;
        var map = L.map('rmap', { scrollWheelZoom: false });
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '&copy; OpenStreetMap' }).addTo(map);
        var pts = [];
        pins.forEach(function (p) {
          var icon = L.divIcon({ className: 'rpin', html: '<span>' + p.rank + '</span>', iconSize: [30, 30], iconAnchor: [15, 15] });
          var m = L.marker([p.lat, p.lng], { icon: icon }).addTo(map);
          var html = '<b>' + p.name + '</b>';
          if (p.near) html += '<br><span style="color:#64748b">🚶 ' + nearL + p.near + '</span>';
          if (p.stayHref) html += '<br><a href="' + p.stayHref + '">🏨 ' + p.stayLabel + ' &rarr;</a>';
          m.bindPopup(html);
          pts.push([p.lat, p.lng]);
        });
        if (pts.length) map.fitBounds(pts, { padding: [40, 40], maxZoom: 15 });
      }
      if (document.readyState !== 'loading' && window.L) init();
      else window.addEventListener('load', init);
    })();
  </script>
)}

<article class="body"><div class={hasRail ? 'wrap rgrid' : 'wrap'}>
  <div class="rmain">
  {isResto && data.modifiedDate && (
    <p class="rfresh">🔄 {S.freshL} {fmtDate(data.modifiedDate)}{S.freshNote}</p>
  )}
  {showMap && (
    <section class="rmap-sec">
      <h2 class="rmap-h">📍 {S.mapTitle}</h2>
      <p class="rmap-sub">{S.mapSub}</p>
      <div id="rmap"></div>
    </section>
  )}
  {showFilters && (
    <div class="rfilter" id="rfilter">
      {types.length >= 2 && (
        <div class="rfg"><span class="rfg-l">{S.fType}</span>
          <button class="rchip on" type="button" data-axis="type" data-val="">{S.fAll}</button>
          {types.map((t) => <button class="rchip" type="button" data-axis="type" data-val={t}>{t}</button>)}
        </div>
      )}
      {zones.length >= 2 && (
        <div class="rfg"><span class="rfg-l">{S.fZone}</span>
          <button class="rchip on" type="button" data-axis="zone" data-val="">{S.fAll}</button>
          {zones.map((z) => <button class="rchip" type="button" data-axis="zone" data-val={z}>{'🧭 ' + z}</button>)}
        </div>
      )}
      {prices.length >= 2 && (
        <div class="rfg"><span class="rfg-l">{S.fPrice}</span>
          <button class="rchip on" type="button" data-axis="price" data-val="">{S.fAll}</button>
          {prices.map((p) => <button class="rchip" type="button" data-axis="price" data-val={p}>{p}</button>)}
        </div>
      )}
      {(hasVeg || hasHalal) && (
        <div class="rfg">
          {hasVeg && <button class="rchip veg" type="button" data-toggle="veg">{S.fVeg}</button>}
          {hasHalal && <button class="rchip halal" type="button" data-toggle="halal">{S.fHalal}</button>}
        </div>
      )}
      <span class="rfilter-count" id="rfilter-count" data-tpl={S.fCountTpl}></span>
    </div>
  )}
  {data.blocks.map((b) => (
    b.kind === 'h2' ? <h2 id={b.id} set:html={b.text} /> :
    b.kind === 'p' ? <p set:html={b.html} /> :
    b.kind === 'image' ? <figure class="figimg"><img src={asset(b.src)} alt={b.alt} loading="lazy" onerror="this.closest('figure')?.remove()" />{(b.caption || b.credit) && <figcaption>{b.caption && <span class="cap" set:html={b.caption} />}{b.credit && <span class="cred">{b.creditHref ? <a href={b.creditHref} target="_blank" rel="nofollow noopener" set:html={b.credit} /> : <span set:html={b.credit} />}</span>}</figcaption>}</figure> :
    b.kind === 'restaurant' ? <section class="resto" id={`r${b.rank}`} data-zone={b.zone || ''} data-veg={b.veg ? '1' : '0'} data-type={b.foodType || ''} data-price={priceTier(b.priceUsd)} data-halal={b.halal ? '1' : '0'}>
      <div class="resto-head">
        <span class="resto-rank">{b.rank}</span>
        <div class="resto-head-info">
          {b.cuisine && <div class="resto-type" set:html={b.cuisine} />}
          <h2 class="resto-name" set:html={b.name} />
          {(b.area || b.zone || b.rating || b.score) &&
            <div class="resto-meta">
              {b.area && <span set:html={'📍 ' + b.area} />}
              {b.zone && <span class="resto-zone">{'🧭 ' + b.zone}</span>}
              {b.rating
                ? <span class="resto-score">⭐ {b.rating.toFixed(1)}{b.ratingCount ? ` · ${comma(b.ratingCount)} ${S.reviewsL}` : ''}{b.ratingSrc ? ` (${b.ratingSrc})` : ''}</span>
                : b.score && <span class="resto-score" set:html={'⭐ ' + b.score} />}
            </div>}
        </div>
      </div>
      <div class="resto-body">
        <div class="resto-media">
          <div class="resto-imgwrap">
            <img class="resto-mainimg" src={asset(b.img)} alt={b.alt} loading="lazy" onerror="this.style.visibility='hidden'" />
            {b.credit && <span class="resto-cred">{b.creditHref ? <a href={b.creditHref} target="_blank" rel="nofollow noopener" set:html={'📷 ' + b.credit} /> : <span set:html={'📷 ' + b.credit} />}</span>}
          </div>
          {b.gallery && b.gallery.length > 0 && (
            <div class="resto-thumbs">
              <button class="resto-thumb on" type="button" data-full={asset(b.img)} data-credit={b.credit || ''} data-href={b.creditHref || ''}><img src={asset(b.img)} alt="" loading="lazy" /></button>
              {b.gallery.map((g) => (
                <button class="resto-thumb" type="button" data-full={asset(g.src)} data-credit={g.credit || ''} data-href={g.creditHref || ''}><img src={asset(g.src)} alt={g.alt || ''} loading="lazy" onerror="this.closest('.resto-thumb').remove()" /></button>
              ))}
            </div>
          )}
          <div class="resto-side">
            {b.priceRange && <div class="resto-price"><span class="pl">{S.priceLabel}</span><span class="pv" set:html={b.priceRange} /></div>}
            {(b.stayHref || b.mapHref || b.fbHref) &&
              <div class="resto-act">{b.stayHref && <a class="rbtn stay" href={link(b.stayHref)} set:html={'🏨 ' + (b.stayLabel || S.stayDefault)} />}{b.mapHref && <a class="rbtn map" href={b.mapHref} target="_blank" rel="nofollow noopener">{'📍 ' + S.mapLabel}</a>}{b.fbHref && <a class="rbtn fb" href={b.fbHref} target="_blank" rel="nofollow noopener">{S.fbLabel}</a>}</div>}
          </div>
        </div>
        <div class="resto-content">
          {b.bestFor && <div class="resto-bestfor"><span class="bf-l">{S.bestForL}</span><span class="bf-v" set:html={b.bestFor} /></div>}
          {b.tags && b.tags.length > 0 &&
            <div class="resto-tags">{b.tags.map((t, i) => <span class={`resto-tag c${i % 3}`} set:html={t} />)}</div>}
          {(b.hours || b.priceUsd || b.spice || b.halal || b.veg || b.englishMenu) &&
            <div class="resto-info">
              {b.hours && <span class="ri"><b>🕐</b><span set:html={b.hours} /></span>}
              {b.priceUsd && <span class="ri"><b>💵</b>{S.usdL}&nbsp;<span set:html={b.priceUsd} /></span>}
              {b.spice && <span class="ri"><b>🌶️</b><span set:html={b.spice} /></span>}
              {b.halal && <span class="ri ok"><b>🕌</b>{S.halalL}</span>}
              {b.veg && <span class="ri ok"><b>🥗</b>{S.vegL}</span>}
              {b.englishMenu && <span class="ri ok"><b>📋</b>{S.enMenuL}</span>}
            </div>}
          {b.signature && <div class="resto-sig"><span>🥢</span><span><b>{S.sigLabel} — </b><span set:html={b.signature} /></span></div>}
          <div class="resto-desc" set:html={b.descHtml} />
          {b.mustOrder && b.mustOrder.length > 0 &&
            <div class="resto-must"><span class="ml">{S.mustLabel}</span>{b.mustOrder.map((m) => <span class="mo" set:html={m} />)}</div>}
        </div>
      </div>
    </section> :
    b.kind === 'staycta' ? <section class="staycta" style={b.img ? `background-image:linear-gradient(125deg,rgba(8,145,178,.93),rgba(244,63,94,.9)),url('${asset(b.img)}')` : ''}>
      <div class="staycta-in">
        <h3 set:html={b.title} />
        {b.text && <p set:html={b.text} />}
        <div class="staycta-links">{b.links.map((l) => <a href={link(l.href)}><span class="ll" set:html={l.label} />{l.note && <small set:html={l.note} />}</a>)}</div>
        {b.ctaHref && <a class="staycta-btn" href={b.ctaHref} target="_blank" rel="sponsored nofollow noopener" set:html={b.ctaLabel ?? 'ค้นหาที่พัก'} />}
      </div>
    </section> :
    b.kind === 'foodexp' ? <section class="foodexp">
      <div class="foodexp-head"><span class="foodexp-ic">🍢</span><div><h3 set:html={b.title} />{b.text && <p set:html={b.text} />}</div></div>
      <div class="foodexp-grid">{b.items.map((it) => (
        <a class="foodexp-card" href={it.href} target="_blank" rel="sponsored nofollow noopener">
          <span class="foodexp-emoji">{it.emoji ?? '🥢'}</span>
          <span class="foodexp-body"><span class="foodexp-label" set:html={it.label} />{it.note && <small set:html={it.note} />}</span>
          {it.provider && <span class="foodexp-prov" set:html={it.provider} />}
        </a>))}</div>
      {b.ctaHref && <a class="foodexp-btn" href={b.ctaHref} target="_blank" rel="sponsored nofollow noopener" set:html={b.ctaLabel ?? 'ดูทั้งหมด'} />}
    </section> :
    b.kind === 'experiences' ? <section class="foodexp exp">
      <div class="foodexp-head"><span class="foodexp-ic">🎟️</span><div><h3 set:html={b.title} />{b.text && <p set:html={b.text} />}</div></div>
      <div class="foodexp-grid">{b.items.map((it) => (
        <a class="foodexp-card" href={it.href} target="_blank" rel="sponsored nofollow noopener">
          <span class="foodexp-emoji">{it.emoji ?? '🎟️'}</span>
          <span class="foodexp-body"><span class="foodexp-label" set:html={it.label} />{it.note && <small set:html={it.note} />}</span>
          {it.provider && <span class="foodexp-prov" set:html={it.provider} />}
        </a>))}</div>
      {b.ctaHref && <a class="foodexp-btn" href={b.ctaHref} target="_blank" rel="sponsored nofollow noopener" set:html={b.ctaLabel ?? (isEn ? 'See all activities' : 'ดูกิจกรรมทั้งหมด')} />}
    </section> :
    b.kind === 'localtips' ? <section class="localtips">
      <h3 class="lt-h">💡 <span set:html={b.title} /></h3>
      <div class="lt-grid">{b.items.map((it) => (
        <div class="lt-card"><span class="lt-ic">{it.icon ?? '💡'}</span><div class="lt-body"><b set:html={it.title} /><p set:html={it.text} /></div></div>
      ))}</div>
    </section> :
    b.kind === 'list' ? <ul>{b.items.map((i) => <li set:html={i} />)}</ul> :
    b.kind === 'table' ? <div class="atbl-wrap"><table class="atbl">{b.caption && <caption set:html={b.caption} />}<thead><tr>{b.headers.map((h) => <th set:html={h} />)}</tr></thead><tbody>{b.rows.map((row) => <tr>{row.map((c) => <td set:html={c} />)}</tr>)}</tbody></table></div> :
    b.kind === 'tip' ? <div class="tip">{b.title && <h4 set:html={b.title} />}<p set:html={b.html} /></div> :
    b.kind === 'ranked' ? <div class="ranked">{b.items.map((it) => (
      <div class="rk"><div class="n">{it.rank}</div><div>
        <h3>{it.href ? <a href={it.href} set:html={it.name} /> : <span set:html={it.name} />}</h3>
        {it.meta && <div class="m" set:html={it.meta} />}
        <p set:html={it.blurb} />
        {it.tags && it.tags.length > 0 && <div class="tags">{it.tags.map((t) => <span class="tag" set:html={t} />)}</div>}
        {it.price && <div class="pr" set:html={it.price} />}
      </div></div>))}</div> :
    b.kind === 'cards' ? <div class="cards">{b.items.map((c) => (
      c.href
        ? <a class="cd" href={c.href}>{c.tag && <span class="tag" set:html={c.tag} />}<h3 set:html={c.name} /><p set:html={c.blurb} /></a>
        : <div class="cd">{c.tag && <span class="tag" set:html={c.tag} />}<h3 set:html={c.name} /><p set:html={c.blurb} /></div>))}</div> :
    b.kind === 'day' ? <div class="day"><div class="dl" set:html={b.label} />{b.title && <h3 set:html={b.title} />}
      {b.items.map((s) => <div class="step"><div class="tm" set:html={s.time ?? ''} /><div class="ac">{<span set:html={s.activity} />}{s.note && <small set:html={s.note} />}</div></div>)}</div> :
    b.kind === 'cta' ? <div class="ctaband"><p set:html={b.text} />{/^https?:/.test(b.href) ? <a href={b.href} target="_blank" rel="sponsored nofollow noopener" set:html={b.label ?? S.cta} /> : <a href={b.href} set:html={b.label ?? S.cta} />}</div> :
    null
  ))}
  </div>
  {hasRail && (
    <aside class="rrail"><div class="rrail-in">
      {railItems.length > 0 && (
        <div class="rrail-sec">
          <div class="rrail-h">🏨 {S.railH}</div>
          {railItems.map((r) => (
            <a class="rrail-card" href={link(r.href)}>
              {r.img && <img src={asset(r.img)} alt="" loading="lazy" onerror="this.style.display='none'" />}
              <span class="rrail-body"><span class="rrail-title" set:html={r.title} />{r.note && <small set:html={r.note} />}</span>
            </a>
          ))}
        </div>
      )}
      {foodBlock && (
        <div class="rrail-sec">
          <div class="rrail-h">🍢 {S.railFoodH}</div>
          <p class="rrail-fsub">{S.railFoodSub}</p>
          {foodBlock.items.map((it, i) => (
            <a class={`rrail-fcard c${i % 4}`} href={it.href} target="_blank" rel="sponsored nofollow noopener">
              <span class="rrail-ficon">{it.emoji ?? '🥢'}</span>
              <span class="rrail-fbody">
                <span class="rrail-ftitle" set:html={it.label} />
                {it.note && <small class="rrail-fnote" set:html={it.note} />}
              </span>
              <span class="rrail-fchev">›</span>
            </a>
          ))}
          {foodBlock.ctaHref && <a class="rrail-fcta" href={foodBlock.ctaHref} target="_blank" rel="sponsored nofollow noopener">{S.railFoodAll} <span>›</span></a>}
        </div>
      )}
    </div></aside>
  )}
</div></article>

{isResto && (
  <script is:inline>
  (function () {
    // photo gallery — swap main image + credit on thumbnail click
    document.addEventListener('click', function (e) {
      var t = e.target.closest('.resto-thumb'); if (!t) return;
      var media = t.closest('.resto-media'); if (!media) return;
      var main = media.querySelector('.resto-mainimg');
      if (main) { main.src = t.getAttribute('data-full'); main.style.visibility = 'visible'; }
      var cred = media.querySelector('.resto-cred');
      var c = t.getAttribute('data-credit') || '', h = t.getAttribute('data-href') || '';
      if (cred) { if (c) { cred.style.display = ''; cred.innerHTML = h ? '📷 <a href="' + h + '" target="_blank" rel="nofollow noopener">' + c + '</a>' : '📷 ' + c; } else { cred.style.display = 'none'; } }
      media.querySelectorAll('.resto-thumb').forEach(function (x) { x.classList.remove('on'); });
      t.classList.add('on');
    });
    // multi-axis filters (type / zone / price single-select + veg / halal toggles, AND-combined)
    var fbar = document.getElementById('rfilter');
    if (fbar) {
      var sel = { type: '', zone: '', price: '' }, tog = { veg: false, halal: false };
      var cnt = document.getElementById('rfilter-count');
      function apply() {
        var shown = 0, total = 0, active = sel.type || sel.zone || sel.price || tog.veg || tog.halal;
        document.querySelectorAll('.resto').forEach(function (card) {
          total++;
          var ok = (!sel.type || card.getAttribute('data-type') === sel.type)
            && (!sel.zone || card.getAttribute('data-zone') === sel.zone)
            && (!sel.price || card.getAttribute('data-price') === sel.price)
            && (!tog.veg || card.getAttribute('data-veg') === '1')
            && (!tog.halal || card.getAttribute('data-halal') === '1');
          card.style.display = ok ? '' : 'none'; if (ok) shown++;
        });
        document.querySelectorAll('.qnav-row a').forEach(function (a) {
          var id = a.getAttribute('href'), card = id && document.querySelector(id);
          if (card) a.style.display = card.style.display === 'none' ? 'none' : '';
        });
        if (cnt) cnt.textContent = active ? (cnt.getAttribute('data-tpl') || '').replace('{s}', shown).replace('{t}', total) : '';
      }
      fbar.addEventListener('click', function (e) {
        var b = e.target.closest('button'); if (!b) return;
        if (b.hasAttribute('data-axis')) {
          var ax = b.getAttribute('data-axis');
          sel[ax] = b.getAttribute('data-val');
          b.parentNode.querySelectorAll('[data-axis="' + ax + '"]').forEach(function (x) { x.classList.remove('on'); });
          b.classList.add('on');
        } else if (b.hasAttribute('data-toggle')) {
          var tg = b.getAttribute('data-toggle'); tog[tg] = !tog[tg]; b.classList.toggle('on');
        }
        apply();
      });
    }
  })();
  </script>
)}

{faq.length > 0 &&
  <section class="wrap"><div class="faq"><h2>{S.faqH}</h2>
    {faq.map((f) => <details><summary set:html={f.q} /><p set:html={f.a} /></details>)}
  </div></section>}

{data.related && data.related.length > 0 &&
  <section class="wrap"><div class="related"><h2>{S.relH}</h2>
    <div class="rg">{data.related.map((r) => <a href={link(r.href)} set:html={r.title} />)}</div>
  </div></section>}

<section class="wrap"><div class="imgpolicy">
  <h4>{S.copyTitle}</h4>
  <p>{S.copyA}<a href={link('contact.html')}>{S.copyLink}</a>{S.copyB}</p>
</div></section>

<footer class="ft">
  <div class="ftg">
    <div><div class="ftlogo">Thailand<em>Addict</em></div><div class="fttag">{S.ftTag}</div>
      <p style="font-size:13px;color:rgba(255,255,255,.5);max-width:240px">{S.ftDesc}</p></div>
    <div><h4>{S.ftDestH}</h4><a href={link('country-thailand.html')}>{S.ftThai}</a><a href={link(data.crumbCityHref)}>{data.crumbCity}</a></div>
    <div><h4>{S.ftContentH}</h4><a href={link(data.crumbCityHref + '#eat')}>{S.ftEat}</a><a href={link(data.crumbCityHref + '#see')}>{S.ftSee}</a><a href={link(data.crumbCityHref + '#hotels')}>{S.ftStay}</a></div>
    <div><h4>{S.ftAboutH}</h4><a href={link('about.html')}>{S.ftAboutUs}</a><a href={link('editorial-policy.html')}>{S.ftEditorial}</a><a href={link('contact.html')}>{S.ftContact}</a><a href={link('privacy.html')}>{S.ftPrivacy}</a></div>
  </div>
  <div class="ftbar">{S.ftCopy}</div>
</footer>
<script is:inline>
(function(){var hb=document.getElementById('hb'),mm=document.getElementById('mm'),mmx=document.getElementById('mmx');if(hb&&mm&&mmx){hb.addEventListener('click',function(){mm.classList.add('open')});mmx.addEventListener('click',function(){mm.classList.remove('open')});}})();
</script>
</body>
</html>
