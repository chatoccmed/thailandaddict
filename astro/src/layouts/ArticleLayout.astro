  window.taPlanToast=function(added,name,count){
    if(!toast)return;
    var nm=(name&&name.length>22)?name.slice(0,22)+'…':(name||'ร้านนี้');
    toast.querySelector('.tpt-msg').textContent=added?('✓ เก็บ “'+nm+'” ลงแผนแล้ว ('+count+' ที่)'):('เอา “'+nm+'” ออกจากแผนแล้ว');
