                ? <span class="resto-score">⭐ {b.rating.toFixed(1)}{b.ratingCount ? ` · ${comma(b.ratingCount)} ${S.reviewsL}` : ''}{b.ratingSrc ? ` (${b.ratingSrc})` : ''}</span>
                : b.score && <span class="resto-score" set:html={'⭐ ' + b.score} />}
            </div>}
        </div>
        <button class="resto-save" type="button" data-slug={`${data.slug}-r${b.rank}`} data-name={strip(b.name)} data-type="eat" data-city={data.cluster} data-url={`${link(data.slug + '.html')}#r${b.rank}`} data-img={b.libImg || ''} aria-label="เก็บร้านนี้ลงแผนการเดินทาง"><span class="rs-ico">🔖</span> <span class="rs-label">เก็บลงแผน</span><span class="rs-label-sm">เก็บแผน</span></button>
