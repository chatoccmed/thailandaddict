</div>

<div class="crumb"><a href={link('/')}>{S.home}</a> › <a href={link('country-thailand.html')}>{S.th}</a> › <a href={link(data.crumbCityHref)}>{data.crumbCity}</a> › <span>{data.h1.replace(/<[^>]+>/g,' ').replace(/\s+/g,' ').trim()}</span></div>

{isResto && data.heroImg ? (
  <section class="rhero" style={`background-image:linear-gradient(100deg,rgba(6,46,66,.9) 0%,rgba(11,32,51,.62) 40%,rgba(15,23,42,.32) 72%,rgba(15,23,42,.48) 100%),linear-gradient(0deg,rgba(15,23,42,.72) 0%,rgba(15,23,42,0) 40%),url('${asset(data.heroImg)}')`}>
    <div class="wrap rhero-in">
      <div class="rhero-kick">📍 {data.crumbCity}{data.regionLabel ? ` · ${data.regionLabel}` : ''}{data.eyebrow ? ` · ${data.eyebrow}` : ''}</div>
      <h1 set:html={data.h1} />
      <p class="lead" set:html={data.intro} />
      {data.chips && data.chips.length > 0 &&
        <div class="chips">{data.chips.map((c) => <span class="chip" set:html={c} />)}</div>}
    </div>
