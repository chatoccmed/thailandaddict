<meta charset="UTF-8" />
{/* The shell head: viewport-fit=cover, light + dark theme-color, the hashed
    shell.<hash>.css / shell.<hash>.js pair, the pagereveal direction script and
    the speculation rules — which exclude /go/* and rel=sponsored, so no
    affiliate click is ever fired by a prerender. */}
<Shell part="head" ctx={shellCtx} />
<Analytics />
<title>{data.title}</title>
<meta name="description" content={data.metaDesc} />
{data.keywords && <meta name="keywords" content={data.keywords} />}
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href={favSvg} />
<meta property="og:site_name" content="ThailandAddict" />
<meta property="og:title" content={data.ogTitle ?? data.title} />
<meta property="og:description" content={data.ogDesc ?? data.metaDesc} />
<meta property="og:type" content="article" />
<meta property="og:url" content={canonical} />
{(data.image || data.heroImg) && <meta property="og:image" content={asset(data.image || data.heroImg)} />}
{data.heroImg && <link rel="preload" as="image" href={asset(data.heroImg)} fetchpriority="high" />}
<meta property="og:locale" content={({th:'th_TH',en:'en_US',zh:'zh_CN',ru:'ru_RU',ko:'ko_KR',ja:'ja_JP',hi:'hi_IN',he:'he_IL',ar:'ar_AR'} as Record<string,string>)[lang]} />
{/* hreflang from the SAME availability source the language switcher uses. The
    old block hard-coded th + optional en + only the CURRENT locale, so a /ru/
    article never pointed at its existing /zh/ or /ko/ twin and the cluster was
    asymmetric across 890 zh + 886 ru + 608 ko pages. */}
{LOCS.map((l) => <link rel="alternate" hreflang={l} href={`${SITE}${locHref(l)}`} />)}
<link rel="alternate" hreflang="x-default" href={`${SITE}/${data.slug}`} />
<link rel="preconnect" href={IMG_BASE} crossorigin />
<script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
{showMap && <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />}
<style>
/* body is excluded on purpose. Astro compiles this reset to
   [data-astro-cid-...]{margin:0;padding:0}, specificity (0,1,0) — which beats a
   plain `html body` rule (0,0,2). Leaving body in would silently swallow the
   shell bottom-edge padding declared a few lines below. */
*:not(body){margin:0;padding:0;box-sizing:border-box}
:root{--teal:#06B6D4;--teal-dk:#0891b2;--coral:#FB7185;--coral-dk:#f43f5e;--mango:#FBBF24;--ink:#0F172A;--sub:#64748b;--bg:#ffffff;--soft:#f1fbfd;--bdr:#e6eef2}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{font-family:var(--font-body);background:var(--bg);color:var(--ink);line-height:1.75;-webkit-font-smoothing:antialiased}
/* review.css + roundup.css ship body{overflow-x:hidden}; Astro bundles them into this page's CSS too → body becomes a scroll-container → the sticky rail never pins. Override with higher specificity (html body beats body). No real horizontal overflow on this page (verified docW==viewport). */
html body{overflow:visible}
/* belt-and-braces: clip h-overflow only on full-bleed sections (NOT ancestors of .rrail, so sticky stays intact) */
.hero,.rhero,.qnav{overflow-x:clip}
a{color:inherit;text-decoration:none}img{display:block;max-width:100%}
.wrap{max-width:820px;margin:0 auto;padding:0 24px}
/* App shell integration (blueprint §4.0, §4.3).
   The nav, the mobile drawer, the base64 flag bar and the eight html[dir=rtl]
   overrides that used to live here are gone: <Shell/> emits the chrome now, and
   the RTL rules were Astro-scoped, so they compiled to p[data-astro-cid-...] and
   provably never reached the 71 set:html prose blocks on this page. Everything
   below is logical-property only, so RTL mirrors by construction.

   The four padding re-declarations below are NOT duplication: this file’s reset
   compiles to [data-astro-cid-...]{margin:0;padding:0}, both <body> and <main>
   carry that attribute, and unlayered author CSS beats every @layer shell rule
   regardless of specificity — so the shell’s own bottom-edge and
   topbar-clearance padding would never land. Same tokens, same values. */
html body{padding-block-end:calc(var(--floor) + var(--cta-h) + var(--sp-4))}
@media(min-width:1024px){
  html body{padding-inline-end:var(--rail-w-collapsed)}
  html body:has(.ta-rail[data-open]){padding-inline-end:var(--rail-w)}
}
.ta-main{padding-block-start:calc(var(--topbar-rest) + var(--safe-t))}
.crumb{max-width:820px;margin:0 auto;padding:18px 24px 0;font-family:'Outfit';font-size:12.5px;color:var(--sub)}.crumb a:hover{color:var(--teal)}
.hero{padding:34px 0 26px;position:relative;overflow:hidden;background:linear-gradient(135deg,#ecfeff,#fff 55%,#fff5f7);height:auto;min-height:0}
.hero .eyebrow{display:inline-block;font-family:'Outfit';font-size:12.5px;font-weight:800;letter-spacing:.5px;color:var(--teal-dk);background:#cffafe;padding:6px 14px;border-radius:999px;margin-bottom:14px}
.hero h1{font-family:'Outfit';font-size:clamp(30px,5vw,46px);font-weight:900;line-height:1.1;letter-spacing:-1px}
.hero .lead{font-size:17px;color:var(--sub);margin-top:14px}
.chips{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}
.chip{font-family:'Outfit';font-size:12.5px;font-weight:700;background:#fff;border:2px solid var(--bdr);border-radius:999px;padding:7px 14px}
.heroimg{display:block;width:100%;max-width:820px;margin:22px auto 0;border-radius:20px;aspect-ratio:16/9;object-fit:cover;box-shadow:0 16px 40px rgba(15,23,42,.12)}
.heroimg-fig{margin:0}.heroimg-fig .heroimg{margin-bottom:0}.heroimg-cred{display:block;max-width:820px;margin:5px auto 0;text-align:end;font-size:11px;color:var(--sub)}.heroimg-cred a{color:var(--sub)}
.body{padding:30px 0 10px}
.body h2{font-family:'Outfit';font-size:24px;font-weight:800;letter-spacing:-.4px;margin:34px 0 12px;scroll-margin-top:80px}
.body h2:first-child{margin-top:0}
.body p{font-size:16px;color:#1e293b;margin:0 0 14px}.body p strong{color:var(--ink);font-weight:700}
.body ul{margin:0 0 16px;padding-inline-start:4px;list-style:none}
.body ul li{position:relative;padding-block:6px;padding-inline:26px 0;font-size:15.5px;color:#1e293b}
.body ul li::before{content:'';position:absolute;inset-inline-start:4px;inset-block-start:14px;width:8px;height:8px;border-radius:50%;background:linear-gradient(135deg,var(--teal),var(--coral))}
/* ===== Restaurant roundup — editorial "award" layout ===== */
.quick-answer{background:linear-gradient(180deg,#f1fbfd 0%,#ffffff 100%);border:1px solid #cbeef5;border-inline-start:5px solid #06B6D4;border-radius:18px;padding:18px 22px;margin:6px 0 24px;box-shadow:0 8px 24px rgba(6,182,212,.10)}
.qa-eyebrow{display:inline-block;font-family:'Outfit',sans-serif;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:#0891b2;font-weight:700;background:#fff;padding:3px 11px;border-radius:999px;border:1px solid #cbeef5;margin-bottom:9px}
.qa-body{font-size:15.5px;line-height:1.8;color:#0F172A}
.qa-body strong{color:#0891b2;font-weight:700}
.qa-body a{color:#0891b2}
.rhero{background-size:cover;background-position:center;color:#fff;padding:clamp(72px,12vw,118px) 0 clamp(56px,7vw,76px);position:relative;min-height:clamp(440px,58vh,620px);display:flex;flex-direction:column;justify-content:flex-end}
.rhero-kick{font-family:'Outfit';font-weight:700;font-size:12.5px;letter-spacing:.13em;text-transform:uppercase;color:rgba(255,255,255,.92);margin-bottom:16px;display:flex;align-items:center;gap:9px;text-shadow:0 1px 10px rgba(0,0,0,.4)}
.rhero-kick::before{content:"";width:28px;height:2px;background:var(--mango);border-radius:2px;flex-shrink:0}
.rhero-scroll{position:absolute;inset-block-end:18px;inset-inline-end:clamp(18px,4vw,40px);display:inline-flex;align-items:center;gap:9px;color:#fff;font-family:'Outfit';font-weight:700;font-size:12.5px;opacity:.92;text-shadow:0 1px 10px rgba(0,0,0,.5)}
.rhero-scroll em{font-style:normal;font-size:17px;animation:rhBounce 1.6s ease-in-out infinite}
@keyframes rhBounce{0%,100%{transform:translateY(0)}50%{transform:translateY(5px)}}
.rhero-cred{position:absolute;inset-block-end:8px;inset-inline-start:14px;font-size:10px;color:rgba(255,255,255,.6)}.rhero-cred a{color:rgba(255,255,255,.6);text-decoration:underline}
.rhero .wrap{max-width:860px}
.rhero .eyebrow{background:rgba(255,255,255,.16);color:#fff;border:1px solid rgba(255,255,255,.28);backdrop-filter:blur(6px)}
.rhero h1{font-family:'Outfit';font-size:clamp(33px,6.2vw,56px);font-weight:900;line-height:1.07;letter-spacing:-1.2px;text-shadow:0 2px 30px rgba(0,0,0,.4)}
.rhero h1 .hi{color:var(--mango)}.rhero h1 .hi2{color:#fff}
.rhero .lead{color:rgba(255,255,255,.93);font-size:clamp(16px,2.3vw,19px);max-width:700px;margin-top:16px;text-shadow:0 1px 14px rgba(0,0,0,.45)}
.rhero .chips{margin-top:22px}
.rhero .chip{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.3);color:#fff;backdrop-filter:blur(8px);font-size:12px;padding:6px 13px;font-weight:600}
.qnav{position:sticky;top:var(--topbar-h);z-index:40;background:rgba(255,255,255,.92);backdrop-filter:blur(14px);border-bottom:1px solid var(--bdr)}
.qnav-row{max-width:980px;margin:0 auto;display:flex;gap:8px;overflow-x:auto;padding:11px 20px;scrollbar-width:none}.qnav-row::-webkit-scrollbar{display:none}
.qnav-row a{flex:0 0 auto;display:inline-flex;align-items:center;gap:7px;font-family:'Outfit';font-size:13px;font-weight:600;color:var(--sub);background:var(--soft);border:1px solid var(--bdr);border-radius:999px;padding:6px 14px 6px 7px;white-space:nowrap;transition:.15s}
.qnav-row a:hover{color:var(--teal-dk);border-color:var(--teal);background:#fff}
.qnav-row a b{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;background:linear-gradient(135deg,var(--teal),var(--coral));color:#fff;font-size:11px;font-weight:900}
/* card layout — mirrors hotel-roundup rhythm: header band + fixed image sidebar + flexible text */
.resto{background:#fff;border:1px solid var(--bdr);border-radius:24px;overflow:hidden;margin:0 0 26px;box-shadow:0 10px 30px rgba(15,23,42,.06);transition:box-shadow .25s,transform .25s;scroll-margin-top:128px}
.resto:hover{box-shadow:0 22px 48px -18px rgba(15,23,42,.24);transform:translateY(-3px)}
.resto-head{display:flex;align-items:flex-start;gap:15px;padding:20px 24px 16px;border-bottom:1px solid var(--bdr)}
.resto-save{flex-shrink:0;align-self:center;display:inline-flex;align-items:center;gap:6px;font-family:'Outfit';font-weight:800;font-size:13px;color:#e11d48;background:#fff1f3;border:1.5px solid #fecdd3;border-radius:999px;padding:9px 16px;cursor:pointer;transition:.18s;white-space:nowrap;box-shadow:0 2px 8px rgba(244,63,94,.1)}
.resto-save:hover{background:#ffe4e6;transform:translateY(-1px);box-shadow:0 5px 14px rgba(244,63,94,.22)}
.resto-save.saved{background:linear-gradient(135deg,#fb7185,#f43f5e);color:#fff;border-color:transparent;box-shadow:0 7px 16px rgba(244,63,94,.36)}
.resto-save .rs-ico{font-size:15px;line-height:1}
.resto-save .rs-label-sm{display:none}
@media(max-width:760px){.resto-save .rs-label{display:none}.resto-save .rs-label-sm{display:inline}.resto-save{padding:9px 13px;font-size:12px}}
.resto-rank{width:48px;height:48px;border-radius:15px;background:linear-gradient(135deg,var(--teal),var(--coral));color:#fff;font-family:'Outfit';font-weight:900;font-size:24px;display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 8px 18px rgba(244,63,94,.32)}
.resto-head-info{flex:1;min-width:0}
.resto-type{font-family:'Outfit';font-size:11px;letter-spacing:1.2px;text-transform:uppercase;color:var(--sub);font-weight:700;margin-bottom:3px}
.resto-name{font-family:'Outfit';font-size:clamp(20px,2.8vw,25px);font-weight:900;letter-spacing:-.4px;line-height:1.16;color:var(--ink)}
.resto-meta{display:flex;align-items:center;flex-wrap:wrap;gap:8px 14px;margin-top:9px;font-family:'Outfit';font-size:13px;font-weight:600;color:var(--sub)}
.resto-score{display:inline-flex;align-items:center;gap:4px;background:linear-gradient(135deg,var(--mango),#f59e0b);color:#fff;padding:3px 11px;border-radius:999px;font-size:12.5px;font-weight:800}
.resto-body{display:grid;grid-template-columns:280px 1fr;gap:0}
.resto.emb .resto-body{grid-template-columns:360px 1fr}
@media(max-width:720px){.resto-body,.resto.emb .resto-body{grid-template-columns:1fr}}
.resto-media{background:var(--soft);border-inline-end:1px solid var(--bdr);display:flex;flex-direction:column}
@media(max-width:720px){.resto-media{border-inline-end:none;border-block-end:1px solid var(--bdr)}}
.resto-embed{display:flex;flex-direction:column;height:100%}
.re-tabs{display:flex;gap:5px;padding:10px 10px 0}
.re-tab{flex:1;padding:9px 4px;border:0;background:#e3f6fb;color:var(--teal-dk);font-family:'Outfit';font-weight:800;font-size:12px;border-radius:11px 11px 0 0;cursor:pointer;transition:.15s}
.re-tab:hover{background:#cdeef6}
.re-tab.on{background:var(--teal);color:#fff}
.re-body{flex:1;position:relative;min-height:540px;background:#fff;border-top:2px solid var(--teal)}
.re-pane{display:none;width:100%;height:540px;min-height:540px;border:0}
.re-pane.on{display:block}
.re-pic{position:relative;padding:0}.re-pic img{width:100%;height:540px;object-fit:cover;display:block}
.re-piccred{position:absolute;inset-block-end:8px;inset-inline-end:8px;font-size:9.5px;background:rgba(15,23,42,.6);color:#fff;padding:3px 8px;border-radius:7px}.re-piccred a{color:#fff;text-decoration:underline}
.re-zoom,.resto-mainimg{cursor:zoom-in}
.re-zoomhint{position:absolute;inset-block-end:8px;inset-inline-start:8px;background:rgba(15,23,42,.66);color:#fff;font-size:10px;padding:3px 8px;border-radius:7px;pointer-events:none;z-index:2}
.re-car{position:relative;height:540px;overflow:hidden}
.re-track{display:flex;height:100%;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}.re-track::-webkit-scrollbar{display:none}
.re-cslide{min-width:100%;scroll-snap-align:start;margin:0;position:relative;height:100%}.re-cslide img{width:100%;height:100%;object-fit:cover;display:block}
.re-cbtn{position:absolute;top:50%;transform:translateY(-50%);width:38px;height:38px;border-radius:999px;border:0;background:rgba(255,255,255,.88);color:var(--ink);font-size:22px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:2}.re-cprev{inset-inline-start:8px}.re-cnext{inset-inline-end:8px}
.re-ccount{position:absolute;inset-block-start:10px;inset-inline-start:10px;background:rgba(15,23,42,.66);color:#fff;font-size:11px;padding:3px 9px;border-radius:999px;z-index:2}
@media(max-width:760px){.re-car{height:440px}}
.re-foot{font-size:11px;color:var(--sub);padding:8px 12px;background:#f6fdff;border-top:1px solid var(--bdr)}
@media(max-width:760px){.re-body,.re-pane{height:440px;min-height:440px}.re-pic img{height:440px}}
.resto-imgwrap{position:relative;aspect-ratio:4/3;overflow:hidden;background:#e6eef2;flex-shrink:0}
.resto-imgwrap img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s}
.resto:hover .resto-imgwrap img{transform:scale(1.04)}
.resto-cred{position:absolute;inset-inline-start:11px;inset-block-end:11px;background:rgba(15,23,42,.62);backdrop-filter:blur(4px);color:#fff;font-family:'Outfit';font-size:10px;font-weight:600;padding:4px 10px;border-radius:999px;max-width:88%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.resto-cred a{color:#fff}
.resto-side{padding:14px 16px 16px;display:flex;flex-direction:column;gap:10px;flex:1}
.resto-price{font-family:'Outfit';line-height:1.15}
.resto-price .pl{display:block;font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:var(--sub);font-weight:700}
.resto-price .pv{font-size:19px;font-weight:900;color:var(--teal-dk);letter-spacing:-.3px}
.resto-act{display:flex;flex-direction:column;gap:8px;margin-top:auto}
.rbtn{font-family:'Outfit';font-weight:800;font-size:13px;padding:11px 14px;border-radius:12px;display:inline-flex;align-items:center;justify-content:center;gap:7px;transition:transform .15s,box-shadow .2s}
.rbtn.stay{background:linear-gradient(135deg,var(--coral),var(--coral-dk));color:#fff;box-shadow:0 6px 16px rgba(244,63,94,.32)}
.rbtn.map{background:linear-gradient(135deg,var(--teal),var(--teal-dk));color:#fff;box-shadow:0 6px 16px rgba(6,182,212,.3)}
.rbtn.fb{background:#fff;border:2px solid var(--bdr);color:var(--ink)}
.rbtn.book{background:linear-gradient(135deg,#ff7a00,#ff5b00);color:#fff;box-shadow:0 6px 16px rgba(255,91,0,.34)}
.rbtn:hover{transform:translateY(-2px)}
.resto-content{padding:20px 24px 22px;min-width:0}
.resto-tags{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:14px}
.resto-tag{font-family:'Outfit';font-size:11.5px;font-weight:700;padding:4px 12px;border-radius:999px;white-space:nowrap}
.resto-tag.c0{background:#cffafe;color:var(--teal-dk)}.resto-tag.c1{background:#fff1f3;color:var(--coral-dk)}.resto-tag.c2{background:#fef6e0;color:#b45309}
.resto-sig{display:flex;gap:9px;align-items:flex-start;background:var(--soft);border-inline-start:4px solid var(--teal);border-start-start-radius:0;border-end-start-radius:0;border-start-end-radius:12px;border-end-end-radius:12px;padding:10px 14px;margin-bottom:15px;font-size:13.5px;line-height:1.6;color:#1e293b}
.resto-sig b{font-family:'Outfit';color:var(--teal-dk);font-weight:800}
.resto-desc{font-size:15px;color:#1e293b;line-height:1.8}.resto-desc strong{color:var(--ink);font-weight:700}.resto-desc p{margin:0 0 12px}.resto-desc p:last-child{margin-bottom:0}
/* bookable-activity card: tip · review pros/cons · full-width book button (type:'activity*' cards) */
.resto-cardtip{display:flex;gap:10px;align-items:flex-start;margin:0 24px 4px;padding:14px 18px;background:#fffbeb;border:1px solid #fde68a;border-radius:14px}
.resto-cardtip .rct-i{font-size:18px;flex-shrink:0}.resto-cardtip .rct-b{font-size:14px;line-height:1.7;color:#78350f}.resto-cardtip b{color:#92400e}
.resto-pc{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:16px 0 4px;padding:0 24px 24px}@media(max-width:620px){.resto-pc{grid-template-columns:1fr}}
.resto-pc .pc-col{border-radius:14px;padding:16px 18px}
.resto-pc .pc-pro{background:#ecfdf5;border:1px solid #a7f3d0}.resto-pc .pc-con{background:#fff7ed;border:1px solid #fed7aa}
.resto-pc .pc-h{font-family:'Outfit';font-weight:800;font-size:12.5px;margin-bottom:8px}.resto-pc .pc-pro .pc-h{color:#047857}.resto-pc .pc-con .pc-h{color:#c2410c}
.resto-pc ul{margin:0;padding-inline-start:18px}.resto-pc li{font-size:13.5px;line-height:1.7;color:#1e293b;margin-bottom:4px}
.resto-book{display:flex;gap:12px;flex-wrap:wrap;padding:4px 24px 24px}
.resto-pc + .resto-book,.resto-cardtip + .resto-book{margin-top:-8px}
.resto-book .bk{display:flex;align-items:center;gap:13px;text-decoration:none;border-radius:16px;padding:15px 20px;font-family:'Outfit',sans-serif;transition:transform .14s ease,box-shadow .14s ease}
.resto-book .bk:hover{transform:translateY(-2px)}
.resto-book .bk-klook{flex:3 1 320px;background:linear-gradient(135deg,#ff7e1d,#ff5b00);box-shadow:0 9px 24px rgba(255,91,0,.36);color:#fff}
.resto-book .bk-klook:hover{box-shadow:0 13px 30px rgba(255,91,0,.46)}
.resto-book .kl-badge{background:#fff;color:#ff5b00;font-weight:900;font-size:19px;letter-spacing:-.6px;border-radius:9px;padding:6px 13px 7px;line-height:1;box-shadow:0 2px 7px rgba(0,0,0,.14);flex-shrink:0}
.resto-book .kl-main{display:flex;flex-direction:column;line-height:1.28;flex:1;min-width:0}
.resto-book .kl-main b{font-size:16.5px;font-weight:800;letter-spacing:-.2px}
.resto-book .kl-main small{font-size:12.5px;line-height:1.45;opacity:.94;font-weight:500}
.resto-book .kl-arr{font-size:23px;font-weight:800;flex-shrink:0;transition:transform .14s ease}
.resto-book .bk-klook:hover .kl-arr{transform:translateX(4px)}
html[dir="rtl"] .resto-book .kl-arr{transform:scaleX(-1)}
html[dir="rtl"] .resto-book .bk-klook:hover .kl-arr{transform:scaleX(-1) translateX(4px)}
.resto-book .bk-stay{flex:1 1 200px;justify-content:center;background:#ecfeff;border:1.5px solid #a5f3fc;color:#0e7490;font-weight:800;font-size:14.5px}
.resto-book .bk-stay:hover{background:#cffafe;border-color:#67e8f9}
.resto-book .bks-i{font-size:17px}
@media(max-width:620px){.resto-book{padding:4px 16px 18px}.resto-book .bk-klook,.resto-book .bk-stay{flex:1 1 100%}}
