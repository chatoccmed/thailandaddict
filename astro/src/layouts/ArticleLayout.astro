{isResto && (
  <script is:inline>
  (function () {
    // photo gallery — swap main image + credit on thumbnail click
    document.addEventListener('click', function (e) {
      var t = e.target.closest('.resto-thumb'); if (!t) return;
      var media = t.closest('.resto-media'); if (!media) return;
      var main = media.querySelector('.resto-mainimg');
      if (main) { main.src = t.getAttribute('data-full'); main.style.visibility = 'visible'; }
      var cred = media.querySelector('.resto-cred');
      var c = t.getAttribute('data-credit') || '', h = t.getAttribute('data-href') || '';
      if (cred) { if (c) { cred.style.display = ''; cred.innerHTML = h ? '📷 <a href="' + h + '" target="_blank" rel="nofollow noopener">' + c + '</a>' : '📷 ' + c; } else { cred.style.display = 'none'; } }
      media.querySelectorAll('.resto-thumb').forEach(function (x) { x.classList.remove('on'); });
      t.classList.add('on');
    });
    // tabbed embeds (map / facebook / instagram) — lazy-load iframe src on first activation
    function actPane(p) { if (p && !p.getAttribute('src') && p.getAttribute('data-src')) p.setAttribute('src', p.getAttribute('data-src')); }
    document.querySelectorAll('.resto-embed').forEach(function (box) {
      actPane(box.querySelector('.re-pane.on'));
      box.querySelectorAll('.re-tab').forEach(function (tab) {
        tab.addEventListener('click', function () {
          box.querySelectorAll('.re-tab').forEach(function (x) { x.classList.remove('on'); });
          box.querySelectorAll('.re-pane').forEach(function (x) { x.classList.remove('on'); });
          tab.classList.add('on');
          var p = document.getElementById(tab.getAttribute('data-pane'));
          if (p) { actPane(p); p.classList.add('on'); }
        });
      });
    });
    // in-page lightbox — tap any photo to zoom WITHOUT leaving the page (no IG/FB bounce)
    var ov = document.createElement('div'); ov.className = 'lbx-ov';
    ov.innerHTML = '<span class="lbx-count"></span><button class="lbx-btn lbx-close" type="button" aria-label="ปิด">✕</button><button class="lbx-btn lbx-prev" type="button" aria-label="ก่อนหน้า">‹</button><img class="lbx-img" alt=""><div class="lbx-cap"></div><div class="lbx-cred"></div><button class="lbx-btn lbx-next" type="button" aria-label="ถัดไป">›</button>';
    document.body.appendChild(ov);
    var ovImg = ov.querySelector('.lbx-img'), ovCap = ov.querySelector('.lbx-cap'), ovCred = ov.querySelector('.lbx-cred'), ovCount = ov.querySelector('.lbx-count');
    var ovPrev = ov.querySelector('.lbx-prev'), ovNext = ov.querySelector('.lbx-next');
    var LB = { list: [], i: 0 };
    function lbShow() { var it = LB.list[LB.i]; if (!it) return; ovImg.src = it.src; ovImg.alt = it.cap || ''; ovCap.textContent = it.cap || ''; ovCred.innerHTML = it.cred ? (it.href ? ('📷 <a href="' + it.href + '" target="_blank" rel="nofollow noopener">' + it.cred + '</a>') : ('📷 ' + it.cred)) : ''; var multi = LB.list.length > 1; ovCount.textContent = multi ? (LB.i + 1) + ' / ' + LB.list.length : ''; ovPrev.style.display = multi ? '' : 'none'; ovNext.style.display = multi ? '' : 'none'; }
    function lbOpen(list, i) { LB.list = list; LB.i = i; lbShow(); ov.classList.add('on'); document.body.style.overflow = 'hidden'; }
    function lbClose() { ov.classList.remove('on'); document.body.style.overflow = ''; ovImg.src = ''; }
    function lbGo(d) { LB.i = (LB.i + d + LB.list.length) % LB.list.length; lbShow(); }
    ov.querySelector('.lbx-close').addEventListener('click', lbClose);
    ovPrev.addEventListener('click', lbGo.bind(null, -1));
    ovNext.addEventListener('click', lbGo.bind(null, 1));
    ov.addEventListener('click', function (e) { if (e.target === ov) lbClose(); });
    document.addEventListener('keydown', function (e) { if (!ov.classList.contains('on')) return; if (e.key === 'Escape') lbClose(); else if (e.key === 'ArrowLeft') lbGo(-1); else if (e.key === 'ArrowRight') lbGo(1); });
    document.addEventListener('click', function (e) {
      var z = e.target.closest('.re-zoom, .resto-mainimg'); if (!z) return;
      var card = z.closest('.resto'); if (!card) return;
      var list = [], start = 0;
      var slides = card.querySelectorAll('.re-pic .re-zoom');
      if (slides.length) { slides.forEach(function (s) { list.push({ src: s.getAttribute('data-full') || s.src, cap: s.getAttribute('data-cap') || '', cred: s.getAttribute('data-cred') || '', href: s.getAttribute('data-href') || '' }); }); start = [].indexOf.call(slides, z); if (start < 0) start = 0; lbOpen(list, start); return; }
      var thumbs = card.querySelectorAll('.resto-thumb');
      if (thumbs.length) { thumbs.forEach(function (t) { list.push({ src: t.getAttribute('data-full'), cap: '', cred: t.getAttribute('data-credit') || '', href: t.getAttribute('data-href') || '' }); }); var act = card.querySelector('.resto-thumb.on'); start = act ? [].indexOf.call(thumbs, act) : 0; lbOpen(list, start); return; }
      lbOpen([{ src: z.getAttribute('data-full') || z.src, cap: z.getAttribute('data-cap') || '', cred: z.getAttribute('data-cred') || '', href: z.getAttribute('data-href') || '' }], 0);
    });
    // image carousel arrows (attraction cards with multiple photos)
    document.querySelectorAll('.re-car').forEach(function (car) {
      var track = car.querySelector('.re-track'), count = car.querySelector('.re-ccount'), n = car.querySelectorAll('.re-cslide').length;
      function cur() { return Math.round(track.scrollLeft / track.clientWidth); }
      if (count) track.addEventListener('scroll', function () { count.textContent = (cur() + 1) + '/' + n; });
      car.querySelector('.re-cprev').addEventListener('click', function () { track.scrollTo({ left: (cur() - 1) * track.clientWidth, behavior: 'smooth' }); });
      car.querySelector('.re-cnext').addEventListener('click', function () { track.scrollTo({ left: (cur() + 1) * track.clientWidth, behavior: 'smooth' }); });
    });
    // save-to-trip buttons (per restaurant → ta_wishlist localStorage, shared with /my-list + trip planner)
    document.querySelectorAll('.resto-save').forEach(function (btn) {
      var KEY = 'ta_wishlist', slug = btn.getAttribute('data-slug');
      function get(){ try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) { return []; } }
      function render(){ var on = get().some(function (x) { return x.slug === slug; }); btn.classList.toggle('saved', on); btn.querySelector('.rs-ico').textContent = on ? '✓' : '🔖'; btn.querySelector('.rs-label').textContent = on ? 'เก็บแล้ว' : 'เก็บลงแผน'; var sm = btn.querySelector('.rs-label-sm'); if (sm) sm.textContent = on ? '✓ เก็บแล้ว' : 'เก็บแผน'; }
      render();
      btn.addEventListener('click', function () {
        var l = get(), i = -1; for (var k = 0; k < l.length; k++) { if (l[k].slug === slug) { i = k; break; } }
        var added = i < 0;
        if (i >= 0) l.splice(i, 1); else l.push({ slug: slug, name: btn.getAttribute('data-name'), type: btn.getAttribute('data-type'), city: btn.getAttribute('data-city'), url: btn.getAttribute('data-url'), img: btn.getAttribute('data-img') });
        try { localStorage.setItem(KEY, JSON.stringify(l)); } catch (e) {}
        render();
        if (window.taSyncFab) window.taSyncFab();
        if (window.taPlanToast) window.taPlanToast(added, btn.getAttribute('data-name'), l.length);
      });
    });
    // multi-axis filters (type / zone / price single-select + veg / halal toggles, AND-combined)
    var fbar = document.getElementById('rfilter');
    if (fbar) {
      var sel = { type: '', zone: '', price: '' }, tog = { veg: false, halal: false };
      var cnt = document.getElementById('rfilter-count');
      function apply() {
        var shown = 0, total = 0, active = sel.type || sel.zone || sel.price || tog.veg || tog.halal;
        document.querySelectorAll('.resto').forEach(function (card) {
          total++;
          var ok = (!sel.type || card.getAttribute('data-type') === sel.type)
            && (!sel.zone || card.getAttribute('data-zone') === sel.zone)
            && (!sel.price || card.getAttribute('data-price') === sel.price)
            && (!tog.veg || card.getAttribute('data-veg') === '1')
            && (!tog.halal || card.getAttribute('data-halal') === '1');
          card.style.display = ok ? '' : 'none'; if (ok) shown++;
        });
        document.querySelectorAll('.qnav-row a').forEach(function (a) {
          var id = a.getAttribute('href'), card = id && document.querySelector(id);
          if (card) a.style.display = card.style.display === 'none' ? 'none' : '';
        });
        if (cnt) cnt.textContent = active ? (cnt.getAttribute('data-tpl') || '').replace('{s}', shown).replace('{t}', total) : '';
      }
      fbar.addEventListener('click', function (e) {
        var b = e.target.closest('button'); if (!b) return;
        if (b.hasAttribute('data-axis')) {
          var ax = b.getAttribute('data-axis');
          sel[ax] = b.getAttribute('data-val');
          b.parentNode.querySelectorAll('[data-axis="' + ax + '"]').forEach(function (x) { x.classList.remove('on'); });
          b.classList.add('on');
        } else if (b.hasAttribute('data-toggle')) {
          var tg = b.getAttribute('data-toggle'); tog[tg] = !tog[tg]; b.classList.toggle('on');
        }
        apply();
      });
    }
  })();
  </script>
)}

