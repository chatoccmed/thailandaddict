    {data.heroCredit && <span class="rhero-cred">{data.heroCreditHref ? <a href={data.heroCreditHref} target="_blank" rel="nofollow noopener">{data.heroCredit}</a> : data.heroCredit}</span>}
  </section>
) : (
  <>
    <section class="hero"><div class="wrap">
      <span class="eyebrow">{data.heroEmoji} {data.eyebrow}</span>
      <h1 set:html={data.h1} />
      <p class="lead" set:html={data.intro} />
      {data.chips && data.chips.length > 0 &&
        <div class="chips">{data.chips.map((c) => <span class="chip" set:html={c} />)}</div>}
    </div></section>
    {data.heroImg && (data.heroCredit
      ? <figure class="heroimg-fig">{hasWebp(data.heroImg) ? <picture><source srcset={asset(webpOf(data.heroImg))} type="image/webp" /><img class="heroimg" src={asset(data.heroImg)} alt={data.h1.replace(/<[^>]+>/g,' ')} onerror="this.closest('figure')?.remove()" /></picture> : <img class="heroimg" src={asset(data.heroImg)} alt={data.h1.replace(/<[^>]+>/g,' ')} onerror="this.closest('figure')?.remove()" />}<figcaption class="heroimg-cred">{data.heroCreditHref ? <a href={data.heroCreditHref} target="_blank" rel="nofollow noopener" set:html={data.heroCredit} /> : <span set:html={data.heroCredit} />}</figcaption></figure>
      : hasWebp(data.heroImg) ? <picture><source srcset={asset(webpOf(data.heroImg))} type="image/webp" /><img class="heroimg" src={asset(data.heroImg)} alt={data.h1.replace(/<[^>]+>/g,' ')} onerror="this.remove()" /></picture> : <img class="heroimg" src={asset(data.heroImg)} alt={data.h1.replace(/<[^>]+>/g,' ')} onerror="this.remove()" />)}
  </>
)}
{isResto &&
  <nav class="qnav"><div class="qnav-row">{restos.map((r) => <a href={`#r${r.rank}`}><b>{r.rank}</b><span set:html={r.name} /></a>)}</div></nav>}

{showMap && <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>}
{showMap && (
  <script define:vars={{ pins: mapPins, nearL: S.nearL }}>
    (function () {
      function init() {
        if (!window.L || !document.getElementById('rmap')) return;
        var map = L.map('rmap', { scrollWheelZoom: false });
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '&copy; OpenStreetMap' }).addTo(map);
        var pts = [];
        pins.forEach(function (p) {
          var icon = L.divIcon({ className: 'rpin', html: '<span>' + p.rank + '</span>', iconSize: [30, 30], iconAnchor: [15, 15] });
          var m = L.marker([p.lat, p.lng], { icon: icon }).addTo(map);
          var html = '<b>' + p.name + '</b>';
          if (p.near) html += '<br><span style="color:#64748b">🚶 ' + nearL + p.near + '</span>';
          if (p.stayHref) html += '<br><a href="' + p.stayHref + '">🏨 ' + p.stayLabel + ' &rarr;</a>';
          m.bindPopup(html);
          pts.push([p.lat, p.lng]);
        });
        if (pts.length) map.fitBounds(pts, { padding: [40, 40], maxZoom: 15 });
      }
      if (document.readyState !== 'loading' && window.L) init();
      else window.addEventListener('load', init);
    })();
  </script>
)}

<article class="body"><div class={hasRail ? 'wrap rgrid' : 'wrap'}>
  <div class="rmain">
  <p class="byline">✍️ {S.byLabel}{byName}</p>
