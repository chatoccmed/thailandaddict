import webpManifest from '../data/webp-manifest.json';
import { localizedSlugSet, ROOT_ONLY_SLUGS } from '../lib/locales';
import { stampAffiliate } from '../lib/affiliate';
const { data, lang = 'th', hasEn = true, availableLocales }: {
  data: any;
  lang?: 'th' | 'en' | 'zh' | 'ru' | 'ko' | 'ja' | 'hi' | 'he' | 'ar';
  hasEn?: boolean;
  availableLocales?: string[];
} = Astro.props;
const isTh = lang === 'th';
const pfx = isTh ? '' : `/${lang}`;               // URL locale prefix: '' | /en | /zh | /ru
// slugs with an in-locale page — link() routes to /<loc>/ only when the target exists there, else /en/
// (a bare cross-link like "getting-around-thailand" has no /<loc>/ twin → must go /en/, not /ar/…404).
const localSlugs = (!isTh && lang !== 'en') ? await localizedSlugSet(lang) : null;
const enSlugs = localSlugs ? await localizedSlugSet('en') : null;   // to tell /en/ pages from root-only ones (/trip)
const isRtl = lang === 'he' || lang === 'ar';     // right-to-left locales
// Language switcher — the locales this page actually exists in (routes pass availableLocales; default th/en).
const LOCS = (availableLocales && availableLocales.length) ? availableLocales : (hasEn ? ['th', 'en'] : ['th']);
const LOCLBL: Record<string, string> = { th: 'ไทย', en: 'EN', zh: '中文', ru: 'Рус', ko: '한국', ja: '日本', hi: 'हिं', he: 'עב', ar: 'ع' };
const LANGNAME: Record<string, string> = { th: 'ไทย', en: 'English', zh: '中文', ru: 'Русский', ko: '한국어', ja: '日本語', hi: 'हिन्दी', he: 'עברית', ar: 'العربية' };
const locHref = (l: string) => (l === 'th' ? `/${data.slug}` : `/${l}/${data.slug}`);
const SITE = 'https://thailandaddict.com';
const IMG_BASE = import.meta.env.PUBLIC_IMG_BASE || 'https://pub-65cf98dcb15e4c06a7a465ec411b870a.r2.dev';   // R2 public bucket (override via PUBLIC_IMG_BASE env)
const link = (href: string) => {
  // absolute URLs pass straight through — except booking.com, which must still earn via the /go/b CJ route
  // (belt-and-braces: no entry routes a booking.com URL through link() today, but nothing should silently bypass CJ).
  if (/^(https?:)?\/\//.test(href) || href.startsWith('#')) return goB(href);
  // normalise: strip any existing locale prefix (with OR without a leading slash — some content stores
  // "en/top10-hotels-x" which otherwise became /en/en/…) + .html, then re-prefix for this locale
  const c = href.replace(/\.html$/, '').replace(/^\/?(?:en|zh|ru|ko|ja|hi|he|ar)\//, '/').replace(/^\//, '');
  if (ROOT_ONLY_SLUGS.has(c.split(/[#?]/)[0])) return `/${c}`.replace(/\/+/g, '/');   // /trip etc. — root only
  if (isTh) return `/${c}`.replace(/\/+/g, '/');
  if (lang === 'en') return `/en/${c}`.replace(/\/+/g, '/');
  const slug = c.split(/[#?]/)[0];                            // 3-way: in-locale twin → /<loc>/, EN page → /en/, root-only → /
  const p = localSlugs && localSlugs.has(slug) ? pfx : (enSlugs && enSlugs.has(slug) ? '/en' : '');
  return `${p}/${c}`.replace(/\/+/g, '/');
};
const asset = (p: string) => (!p ? p : (/^(https?:)?\/\//.test(p) ? p : IMG_BASE + (p.startsWith('/') ? p : `/${p}`)));
// Booking.com (Thailand publishers) pays ONLY via CJ. Rather than baking the CJ pid/ad-id into every page,
// booking.com links are routed through the /go/b worker route, which 302s to the CJ click URL — so the
// affiliate ids live in ONE place (worker.js) and a CJ format change is a 10-line edit, not a site-wide rebuild.
// sid = locale + page slug → per-page revenue attribution in CJ Reports. Non-booking.com URLs pass through untouched.
const cjSid = ((isTh ? '' : lang + '-') + String(data.slug || 'site')).replace(/[^a-zA-Z0-9_-]/g, '').slice(0, 60);
// Every outbound link goes through here: tag OTA urls first, then route Booking.com through CJ.
const goB = (u: string) => {
  const t = stampAffiliate(u);
  return t && String(t).includes('booking.com') ? '/go/b?u=' + encodeURIComponent(t) + '&sid=' + encodeURIComponent(cjSid) : t;
};
