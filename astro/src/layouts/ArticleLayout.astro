/* THE SHELL RESET GUARD — do not delete without deleting its cause first.
   astro/src/styles/review.css:4 and roundup.css:4 ship an UNSCOPED
   `*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}`, and Astro
   bundles all three layouts of the [slug] route into ONE stylesheet — so that
   reset is live on article pages too. Unlayered author CSS beats every @layer
   rule regardless of specificity, which would strip the shell chrome of all its
   padding and margin and break the tab bar’s content-box safe-area contract.
   revert-layer hands those three properties back to the layered cascade
   (shell.css) without restating a single value. Verified in a browser: without
   this rule .ta-tab computes padding 0 / margin 0; with it, the shell values.
   Its permanent home is an unlayered preamble in shell.css once all three
   layouts are migrated; it lives here so this migration is self-contained. */
:is(.ta-skip,.ta-sprite,.ta-topbar,.ta-tabbar,.ta-rail,.ta-more,.lang-menu,.ta-sheet,.ta-toast,.ta-foot),
:is(.ta-topbar,.ta-tabbar,.ta-rail,.ta-more,.lang-menu,.ta-sheet,.ta-toast,.ta-foot) *{
  margin:revert-layer;padding:revert-layer;box-sizing:revert-layer;
}
/* revert-layer walks past @layer shell to the UA sheet for any property the shell
   never declares. shell.css styles p/h1-h4/ul/hr/dd margins, so those come back
   correct — but it says nothing about <form>, whose UA margin-block-end:1em then
   reappeared and made the topbar 91px instead of 74px, knocking its controls out
   of vertical alignment. Measured, not guessed. Zero the block-level elements the
   shell does not style; every one of them is a container, never a text block. */
:is(.ta-topbar,.ta-tabbar,.ta-rail,.ta-more,.lang-menu,.ta-sheet,.ta-toast,.ta-foot) :is(form,fieldset,figure,blockquote,menu,pre,table){
  margin:0;
}
</style>
<script is:inline define:vars={{ TWT: { thisPlace: S.thisPlace, toastAdded: S.toastAdded, toastRemoved: S.toastRemoved } }}>(function(){
  var KEY='ta_wishlist';
  function read(){try{return JSON.parse(localStorage.getItem(KEY)||'[]')}catch(e){return[]}}
  // The FAB is gone; its count moved to the shell's always-present Trip badge.
  // Same number, same source (ta_wishlist) — shell.js reads that legacy key too,
  // it just cannot know about a write this page made after it booted.
  window.taSyncFab=function(){
    var n=read().length, els=document.querySelectorAll('.ta-badge,[data-trip-count]');
    for(var i=0;i<els.length;i++){els[i].textContent=n;els[i].setAttribute('data-count',n);}
  };
  taSyncFab();
  var toast=document.getElementById('taPlanToast'),tHide;
  window.taPlanToast=function(added,name,count){
    if(!toast)return;
    var nm=(name&&name.length>22)?name.slice(0,22)+'…':(name||TWT.thisPlace);
    toast.querySelector('.tpt-msg').textContent=added?TWT.toastAdded.replace('{n}',nm).replace('{c}',count):TWT.toastRemoved.replace('{n}',nm);
    toast.querySelector('.tpt-link').style.display=read().length?'inline-block':'none';
    toast.classList.add('show');clearTimeout(tHide);
    tHide=setTimeout(function(){toast.classList.remove('show')},added?3800:2600);
  };
})();</script>
