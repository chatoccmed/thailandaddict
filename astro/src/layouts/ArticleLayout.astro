  var fab=document.getElementById('taTripFab'),nEl=document.getElementById('taTripN');
  window.taSyncFab=function(){var n=read().length;if(nEl)nEl.textContent=n;if(fab)fab.style.display=n?'flex':'none';};
  taSyncFab();
  var toast=document.getElementById('taPlanToast'),tHide;
  window.taPlanToast=function(added,name,count){
    if(!toast)return;
    var nm=(name&&name.length>22)?name.slice(0,22)+'…':(name||'ร้านนี้');
    toast.querySelector('.tpt-msg').textContent=added?('✓ เก็บ “'+nm+'” ลงแผนแล้ว ('+count+' ที่)'):('เอา “'+nm+'” ออกจากแผนแล้ว');
    toast.querySelector('.tpt-link').style.display=read().length?'inline-block':'none';
    toast.classList.add('show');clearTimeout(tHide);
    tHide=setTimeout(function(){toast.classList.remove('show')},added?3800:2600);
  };
