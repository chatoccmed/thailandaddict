.related .rg{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}@media(max-width:600px){.related .rg{grid-template-columns:1fr}}
.related a{background:#fff;border:1px solid var(--bdr);border-radius:14px;padding:14px 16px;font-family:'Outfit';font-weight:700;font-size:14.5px;box-shadow:0 6px 16px rgba(15,23,42,.04)}
.related a:hover{border-color:var(--teal);color:var(--teal-dk)}
</style>
<link rel="stylesheet" href="/css/premium.css">
</head>
<body>
<Shell part="top" ctx={shellCtx} />

<main class="ta-main" id="main">

<div class="crumb"><a href={link('/')}>{S.home}</a> › <a href={link('country-thailand.html')}>{S.th}</a> › <a href={link(data.crumbCityHref)}>{data.crumbCity}</a> › <span>{data.h1.replace(/<[^>]+>/g,' ').replace(/\s+/g,' ').trim()}</span></div>

{isResto && data.heroImg ? (
  <section class="rhero" style={`background-image:linear-gradient(100deg,rgba(6,46,66,.9) 0%,rgba(11,32,51,.62) 40%,rgba(15,23,42,.32) 72%,rgba(15,23,42,.48) 100%),linear-gradient(0deg,rgba(15,23,42,.72) 0%,rgba(15,23,42,0) 40%),url('${asset(data.heroImg)}')`}>
    <div class="wrap rhero-in">
      <div class="rhero-kick">📍 {data.crumbCity}{data.regionLabel ? ` · ${data.regionLabel}` : ''}{data.eyebrow ? ` · ${data.eyebrow}` : ''}</div>
      <h1 set:html={data.h1} />
      <p class="lead" set:html={data.intro} />
      {data.chips && data.chips.length > 0 &&
        <div class="chips">{data.chips.map((c) => <span class="chip" set:html={c} />)}</div>}
    </div>
    <a class="rhero-scroll" href="#r1"><span>{isActivity ? A.scrollAll(restos.length) : (!isTh ? 'Explore all 10' : 'เลื่อนดูทั้ง 10 ร้าน')}</span><em>↓</em></a>
    {data.heroCredit && <span class="rhero-cred">{data.heroCreditHref ? <a href={data.heroCreditHref} target="_blank" rel="nofollow noopener">{data.heroCredit}</a> : data.heroCredit}</span>}
  </section>
) : (
  <>
    <section class="hero"><div class="wrap">
      <span class="eyebrow">{data.heroEmoji} {data.eyebrow}</span>
      <h1 set:html={data.h1} />
      <p class="lead" set:html={data.intro} />
      {data.chips && data.chips.length > 0 &&
        <div class="chips">{data.chips.map((c) => <span class="chip" set:html={c} />)}</div>}
    </div></section>
    {data.heroImg && (data.heroCredit
      ? <figure class="heroimg-fig">{hasWebp(data.heroImg) ? <picture><source srcset={asset(webpOf(data.heroImg))} type="image/webp" /><img class="heroimg" src={asset(data.heroImg)} alt={data.h1.replace(/<[^>]+>/g,' ')} onerror="this.closest('figure')?.remove()" /></picture> : <img class="heroimg" src={asset(data.heroImg)} alt={data.h1.replace(/<[^>]+>/g,' ')} onerror="this.closest('figure')?.remove()" />}<figcaption class="heroimg-cred">{data.heroCreditHref ? <a href={data.heroCreditHref} target="_blank" rel="nofollow noopener" set:html={data.heroCredit} /> : <span set:html={data.heroCredit} />}</figcaption></figure>
      : hasWebp(data.heroImg) ? <picture><source srcset={asset(webpOf(data.heroImg))} type="image/webp" /><img class="heroimg" src={asset(data.heroImg)} alt={data.h1.replace(/<[^>]+>/g,' ')} onerror="this.remove()" /></picture> : <img class="heroimg" src={asset(data.heroImg)} alt={data.h1.replace(/<[^>]+>/g,' ')} onerror="this.remove()" />)}
  </>
)}
{isResto &&
  <nav class="qnav"><div class="qnav-row">{restos.map((r) => <a href={`#r${r.rank}`}><b>{r.rank}</b><span set:html={r.name} /></a>)}</div></nav>}

{showMap && <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>}
{showMap && (
  <script define:vars={{ pins: mapPins, nearL: S.nearL }}>
    (function () {
      function init() {
        if (!window.L || !document.getElementById('rmap')) return;
        var map = L.map('rmap', { scrollWheelZoom: false });
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '&copy; OpenStreetMap' }).addTo(map);
        var pts = [];
        pins.forEach(function (p) {
          var icon = L.divIcon({ className: 'rpin', html: '<span>' + p.rank + '</span>', iconSize: [30, 30], iconAnchor: [15, 15] });
          var m = L.marker([p.lat, p.lng], { icon: icon }).addTo(map);
          var html = '<b>' + p.name + '</b>';
          if (p.near) html += '<br><span style="color:#64748b">🚶 ' + nearL + p.near + '</span>';
          if (p.stayHref) html += '<br><a href="' + p.stayHref + '">🏨 ' + p.stayLabel + ' &rarr;</a>';
          m.bindPopup(html);
          pts.push([p.lat, p.lng]);
        });
        if (pts.length) map.fitBounds(pts, { padding: [40, 40], maxZoom: 15 });
      }
      if (document.readyState !== 'loading' && window.L) init();
      else window.addEventListener('load', init);
    })();
  </script>
)}

<article class="body"><div class={hasRail ? 'wrap rgrid' : 'wrap'}>
  <div class="rmain">
  <p class="byline">✍️ {S.byLabel}{byName}</p>
  {isResto ? (
    factChecked
      ? <p class="rfresh">📝 {S.writtenL} {fmtDate(published)} · ✅ {S.factCheckL} {fmtDate(factChecked)}{S.freshNote}</p>
      : <p class="rfresh">🔄 {S.freshL} {fmtDate(updated)}{S.freshNote}</p>
  ) : (
    <p class="updated">🔄 {S.updatedL} {fmtDate(updated)}</p>
  )}
  {showMap && (
    <section class="rmap-sec">
      <h2 class="rmap-h">📍 {S.mapTitle}</h2>
      <p class="rmap-sub">{S.mapSub}</p>
      <div id="rmap"></div>
    </section>
  )}
  {showFilters && (
    <div class="rfilter" id="rfilter">
      {types.length >= 2 && (
        <div class="rfg"><span class="rfg-l">{S.fType}</span>
          <button class="rchip on" type="button" data-axis="type" data-val="">{S.fAll}</button>
          {types.map((t) => <button class="rchip" type="button" data-axis="type" data-val={t}>{t}</button>)}
        </div>
      )}
      {zones.length >= 2 && (
        <div class="rfg"><span class="rfg-l">{S.fZone}</span>
          <button class="rchip on" type="button" data-axis="zone" data-val="">{S.fAll}</button>
          {zones.map((z) => <button class="rchip" type="button" data-axis="zone" data-val={z}>{'🧭 ' + z}</button>)}
        </div>
      )}
      {prices.length >= 2 && (
        <div class="rfg"><span class="rfg-l">{S.fPrice}</span>
          <button class="rchip on" type="button" data-axis="price" data-val="">{S.fAll}</button>
          {prices.map((p) => <button class="rchip" type="button" data-axis="price" data-val={p}>{p}</button>)}
        </div>
      )}
      {(hasVeg || hasHalal) && (
        <div class="rfg">
          {hasVeg && <button class="rchip veg" type="button" data-toggle="veg">{S.fVeg}</button>}
          {hasHalal && <button class="rchip halal" type="button" data-toggle="halal">{S.fHalal}</button>}
        </div>
      )}
      <span class="rfilter-count" id="rfilter-count" data-tpl={S.fCountTpl}></span>
    </div>
  )}
  {quickAnswerHtml && (
    <aside class="quick-answer">
      <div class="qa-eyebrow">{S.quickAnswerEyebrow}</div>
      <div class="qa-body" set:html={quickAnswerHtml}></div>
    </aside>
  )}
  {bodyBlocks.map((b) => (
    b.kind === 'h2' ? <h2 id={b.id} set:html={b.text} /> :
    b.kind === 'p' ? <p set:html={b.html} /> :
    b.kind === 'image' ? <figure class="figimg"><img src={asset(b.src)} alt={b.alt} loading="lazy" onerror="this.closest('figure')?.remove()" />{(b.caption || b.credit) && <figcaption>{b.caption && <span class="cap" set:html={b.caption} />}{b.credit && <span class="cred">{b.creditHref ? <a href={b.creditHref} target="_blank" rel="nofollow noopener" set:html={b.credit} /> : <span set:html={b.credit} />}</span>}</figcaption>}</figure> :
    b.kind === 'restaurant' ? <section class={(b.igPost || b.fbPage || b.libImg || !b.img) ? 'resto emb' : 'resto'} id={`r${b.rank}`} data-zone={b.zone || ''} data-veg={b.veg ? '1' : '0'} data-type={b.foodType || ''} data-price={priceTier(b.priceUsd)} data-halal={b.halal ? '1' : '0'}>
      <div class="resto-head">
        <span class="resto-rank">{b.rank}</span>
        <div class="resto-head-info">
          {b.cuisine && <div class="resto-type" set:html={b.cuisine} />}
          <h2 class="resto-name" set:html={b.name} />
          {(b.area || b.zone || b.rating || b.score) &&
            <div class="resto-meta">
              {b.area && <span set:html={'📍 ' + b.area} />}
              {b.zone && <span class="resto-zone">{'🧭 ' + b.zone}</span>}
              {b.rating
                ? <span class="resto-score">⭐ {b.rating.toFixed(1)}{b.ratingCount ? ` · ${comma(b.ratingCount)} ${S.reviewsL}` : ''}{b.ratingSrc ? ` (${b.ratingSrc})` : ''}</span>
                : b.score && <span class="resto-score" set:html={'⭐ ' + b.score} />}
            </div>}
        </div>
        <button class="resto-save" type="button" data-slug={`${data.slug}-r${b.rank}`} data-name={strip(b.name)} data-type={isActivity ? 'activity' : 'eat'} data-city={data.cluster} data-url={`${link(data.slug + '.html')}#r${b.rank}`} data-img={b.libImg || ''} aria-label={isActivity ? (A.saveAria || S.saveEatAria) : S.saveEatAria}><span class="rs-ico">🔖</span> <span class="rs-label">{S.save}</span><span class="rs-label-sm">{S.saveSm}</span></button>
      </div>
      <div class="resto-body">
        <div class="resto-media">
          {(b.igPost || b.fbPage || b.libImg || !b.img) ? (
            <div class="resto-embed">
              <div class="re-tabs">
                {realLib(b.libImg) && <button class="re-tab on" type="button" data-pane={`emb${b.rank}-pic`}>{S.picTab}</button>}
                <button class={realLib(b.libImg) ? 're-tab' : 're-tab on'} type="button" data-pane={`emb${b.rank}-map`}>{S.mapTab}</button>
                {b.igPost && <button class="re-tab" type="button" data-pane={`emb${b.rank}-ig`}>📷 IG</button>}
                {b.fbPage && <button class="re-tab" type="button" data-pane={`emb${b.rank}-fb`}>📘 FB</button>}
              </div>
              <div class="re-body">
                {realLib(b.libImg) && <div id={`emb${b.rank}-pic`} class="re-pane re-pic on">
                  {(b.gallery && b.gallery.length) ? (
                    <div class="re-car">
                      <div class="re-track">
                        {[{ src: b.libImg, credit: b.libCredit, href: b.libCreditHref }, ...b.gallery].map((g) => (
                          <figure class="re-cslide"><img class="re-zoom" src={asset(g.src)} alt={realAlt(b.alt) || b.name} loading="lazy" data-full={asset(g.src)} data-cap={strip(b.name)} data-cred={g.credit || ''} data-href={g.href || g.creditHref || ''} onerror="this.closest('.re-cslide')?.remove()" />{g.credit && <span class="re-piccred">{(g.href || g.creditHref) ? <a href={g.href || g.creditHref} target="_blank" rel="nofollow noopener" set:html={g.credit} /> : <span set:html={g.credit} />}</span>}</figure>
                        ))}
                      </div>
                      <button class="re-cbtn re-cprev" type="button" aria-label={S.prevImg}>‹</button>
                      <button class="re-cbtn re-cnext" type="button" aria-label={S.nextImg}>›</button>
                      <span class="re-ccount">1/{b.gallery.length + 1}</span>
                      <span class="re-zoomhint">{S.zoomHint}</span>
                    </div>
                  ) : (
                    <Fragment>{hasWebp(b.libImg) ? <picture><source srcset={asset(webpOf(b.libImg))} type="image/webp" /><img class="re-zoom" src={asset(b.libImg)} alt={realAlt(b.alt) || b.name} loading="lazy" data-full={asset(b.libImg)} data-cap={strip(b.name)} data-cred={b.libCredit || ''} data-href={b.libCreditHref || ''} /></picture> : <img class="re-zoom" src={asset(b.libImg)} alt={realAlt(b.alt) || b.name} loading="lazy" data-full={asset(b.libImg)} data-cap={strip(b.name)} data-cred={b.libCredit || ''} data-href={b.libCreditHref || ''} />}{b.libCredit && <span class="re-piccred">{b.libCreditHref ? <a href={b.libCreditHref} target="_blank" rel="nofollow noopener" set:html={b.libCredit} /> : <span set:html={b.libCredit} />}</span>}<span class="re-zoomhint">{S.zoomHint}</span></Fragment>
                  )}
                </div>}
                <iframe id={`emb${b.rank}-map`} class={realLib(b.libImg) ? 're-pane' : 're-pane on'} loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Google Maps" data-src={`https://maps.google.com/maps?q=${encodeURIComponent(b.name + ' ' + (data.crumbCity || ''))}&z=15&hl=th&output=embed`}></iframe>
                {b.igPost && <iframe id={`emb${b.rank}-ig`} class="re-pane" loading="lazy" title="Instagram" scrolling="no" frameborder="0" data-src={`https://www.instagram.com/p/${b.igPost}/embed/`}></iframe>}
                {b.fbPage && <iframe id={`emb${b.rank}-fb`} class="re-pane" loading="lazy" title="Facebook" scrolling="no" frameborder="0" allowfullscreen data-src={`https://www.facebook.com/plugins/page.php?href=${encodeURIComponent(b.fbPage)}&tabs=timeline&width=500&height=540&small_header=true&adapt_container_width=true&hide_cover=false&show_facepile=false`}></iframe>}
              </div>
              <div class="re-foot">{S.embedFoot}</div>
            </div>
          ) : (
            <Fragment>
              <div class="resto-imgwrap">
                {hasWebp(b.img) ? <picture><source srcset={asset(webpOf(b.img))} type="image/webp" /><img class="resto-mainimg" src={asset(b.img)} alt={realAlt(b.alt) || strip(b.name)} loading="lazy" data-full={asset(b.img)} onerror="this.style.visibility='hidden'" /></picture> : <img class="resto-mainimg" src={asset(b.img)} alt={realAlt(b.alt) || strip(b.name)} loading="lazy" data-full={asset(b.img)} onerror="this.style.visibility='hidden'" />}
                <span class="re-zoomhint">{S.zoomHint}</span>
                {b.credit && <span class="resto-cred">{b.creditHref ? <a href={b.creditHref} target="_blank" rel="nofollow noopener" set:html={'📷 ' + b.credit} /> : <span set:html={'📷 ' + b.credit} />}</span>}
              </div>
              {b.gallery && b.gallery.length > 0 && (
                <div class="resto-thumbs">
                  {/* The thumb's alt is what names the button for a screen reader — leaving it empty
                      made these read as an unlabelled "button". Number them so they're tellable apart. */}
                  <button class="resto-thumb on" type="button" data-full={asset(b.img)} data-credit={b.credit || ''} data-href={b.creditHref || ''}><img src={asset(b.img)} alt={`${strip(b.name)} 1`} loading="lazy" /></button>
                  {b.gallery.map((g, gi) => (
                    <button class="resto-thumb" type="button" data-full={asset(g.src)} data-credit={g.credit || ''} data-href={g.creditHref || ''}><img src={asset(g.src)} alt={realAlt(g.alt) || `${strip(b.name)} ${gi + 2}`} loading="lazy" onerror="this.closest('.resto-thumb').remove()" /></button>
                  ))}
                </div>
              )}
            </Fragment>
          )}
          <div class="resto-side">
            {b.duration && <div class="resto-price"><span class="pl">{S.durationL}</span><span class="pv" set:html={b.duration} /></div>}
            {b.priceRange && <div class="resto-price"><span class="pl">{S.priceLabel}</span><span class="pv" set:html={b.priceRange} /></div>}
            {/* when the card has a book button, the stay link moves into the wide .resto-book row below — don't render it twice */}
            {((b.stayHref && !b.bookHref) || b.mapHref || b.fbHref) &&
              <div class="resto-act">{b.stayHref && !b.bookHref && <a class="rbtn stay" href={link(b.stayHref)} set:html={'🏨 ' + (b.stayLabel || S.stayDefault)} />}{b.mapHref && <a class="rbtn map" href={b.mapHref} target="_blank" rel="nofollow noopener">{'📍 ' + S.mapLabel}</a>}{b.fbHref && <a class="rbtn fb" href={b.fbHref} target="_blank" rel="nofollow noopener">{S.fbLabel}</a>}</div>}
          </div>
        </div>
        <div class="resto-content">
          {b.bestFor && <div class="resto-bestfor"><span class="bf-l">{S.bestForL}</span><span class="bf-v" set:html={b.bestFor} /></div>}
          {b.tags && b.tags.length > 0 &&
            <div class="resto-tags">{b.tags.map((t, i) => <span class={`resto-tag c${i % 3}`} set:html={t} />)}</div>}
          {(b.hours || b.priceUsd || b.spice || b.halal || b.veg || b.englishMenu) &&
            <div class="resto-info">
              {b.hours && <span class="ri"><b>🕐</b><span set:html={b.hours} /></span>}
              {b.priceUsd && <span class="ri"><b>💵</b>{S.usdL}&nbsp;<span set:html={b.priceUsd} /></span>}
              {b.spice && <span class="ri"><b>🌶️</b><span set:html={b.spice} /></span>}
              {b.halal && <span class="ri ok"><b>🕌</b>{S.halalL}</span>}
              {b.veg && <span class="ri ok"><b>🥗</b>{S.vegL}</span>}
              {b.englishMenu && <span class="ri ok"><b>📋</b>{S.enMenuL}</span>}
            </div>}
          {b.signature && <div class="resto-sig"><span>🥢</span><span><b>{S.sigLabel} — </b><span set:html={b.signature} /></span></div>}
          <div class="resto-desc" set:html={b.descHtml} />
          {b.mustOrder && b.mustOrder.length > 0 &&
            <div class="resto-must"><span class="ml">{S.mustLabel}</span>{b.mustOrder.map((m) => <span class="mo" set:html={m} />)}</div>}
        </div>
      </div>
      {b.tipHtml && <div class="resto-cardtip"><span class="rct-i">💡</span><div class="rct-b" set:html={b.tipHtml} /></div>}
      {((b.pros && b.pros.length) || (b.cons && b.cons.length)) &&
        <div class="resto-pc">
          {b.pros && b.pros.length > 0 && <div class="pc-col pc-pro"><div class="pc-h">✅ {S.prosL}</div><ul>{b.pros.map((p) => <li set:html={p} />)}</ul></div>}
          {b.cons && b.cons.length > 0 && <div class="pc-col pc-con"><div class="pc-h">⚠️ {S.consL}</div><ul>{b.cons.map((c) => <li set:html={c} />)}</ul></div>}
        </div>}
      {b.bookHref &&
        <div class="resto-book">
          <a class="bk bk-klook" href={goB(b.bookHref)} target="_blank" rel="nofollow noopener sponsored">
            <span class="kl-badge">{(b.bookProvider || 'Klook').toLowerCase()}</span>
            <span class="kl-main"><b set:html={bookWideL(b)} />{isActivity && <small set:html={A.bookSub} />}</span>
            <span class="kl-arr">→</span>
          </a>
          {b.stayHref && <a class="bk bk-stay" href={link(b.stayHref)}><span class="bks-i">🏨</span><span class="bks-t" set:html={b.stayLabel || (isActivity ? A.stayWide : S.stayDefault)} /></a>}
        </div>}
    </section> :
    b.kind === 'embed' ? <section class="resembed" style="margin:28px 0;padding:18px;border:1px solid #e6eef2;border-radius:18px;background:#f6fdff">
      {b.title && <h3 style="margin:0 0 4px;font-family:'Outfit',sans-serif;font-weight:800;font-size:18px;color:#0f172a" set:html={b.title} />}
      {b.note && <p style="margin:0 0 14px;color:#64748b;font-size:13.5px;line-height:1.6" set:html={b.note} />}
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px">
        {((b.lat && b.lng) || b.gmapsQuery) &&
          <div style="display:flex;flex-direction:column;gap:6px">
            <div style="font-weight:700;font-size:13px;color:#0891b2">🗺️ Google Maps — ที่ตั้ง + รูป/รีวิวจริง</div>
            <iframe loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Google Maps" style="width:100%;height:420px;border:0;border-radius:14px;background:#fff" src={`https://maps.google.com/maps?q=${b.gmapsQuery ? encodeURIComponent(b.gmapsQuery) : (b.lat + ',' + b.lng)}&z=16&hl=th&output=embed`}></iframe>
          </div>}
        {b.fbPage &&
          <div style="display:flex;flex-direction:column;gap:6px">
            <div style="font-weight:700;font-size:13px;color:#0891b2">📘 Facebook — รูป & โพสต์จริงจากร้าน</div>
            <iframe loading="lazy" title="Facebook" scrolling="no" frameborder="0" allowfullscreen style="width:100%;height:420px;border:0;border-radius:14px;background:#fff" src={`https://www.facebook.com/plugins/page.php?href=${encodeURIComponent(b.fbPage)}&tabs=timeline&width=380&height=420&small_header=false&adapt_container_width=true&hide_cover=false&show_facepile=true`}></iframe>
          </div>}
        {b.igPost &&
          <div style="display:flex;flex-direction:column;gap:6px">
            <div style="font-weight:700;font-size:13px;color:#0891b2">📷 Instagram — โพสต์จริง</div>
            <iframe loading="lazy" title="Instagram" scrolling="no" frameborder="0" style="width:100%;height:480px;border:0;border-radius:14px;background:#fff" src={`https://www.instagram.com/p/${b.igPost}/embed/`}></iframe>
          </div>}
      </div>
      {b.mapsLink && <a style="display:inline-block;margin-top:14px;color:#0891b2;font-weight:700;font-size:14px;text-decoration:none" href={b.mapsLink} target="_blank" rel="nofollow noopener">📍 ดูรูป &amp; รีวิวจริงทั้งหมดบน Google →</a>}
    </section> :
    b.kind === 'staycta' ? <section class="staycta" style={b.img ? `background-image:linear-gradient(125deg,rgba(8,145,178,.93),rgba(244,63,94,.9)),url('${asset(b.img)}')` : ''}>
      <div class="staycta-in">
        <h3 set:html={b.title} />
        {b.text && <p set:html={b.text} />}
