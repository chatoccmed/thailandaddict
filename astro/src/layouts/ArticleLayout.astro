<div id="taPlanToast" class="ta-plantoast" role="status" aria-live="polite"><span class="tpt-msg"></span><a href="/trip" class="tpt-link">{S.viewPlan}</a></div>
<style>
/* Save-confirmation toast. The .ta-tripfab FAB that used to sit beside it is
