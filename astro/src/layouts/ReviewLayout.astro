<script is:inline define:vars={{ tsLabel: S.tsLabel, tsLocale: S.locale, fromSuffix: S.pwFromSuffix }}>
(function(){
  var hb=document.getElementById('hb'),mm=document.getElementById('mm'),mmx=document.getElementById('mmx');
  if(hb&&mm&&mmx){hb.addEventListener('click',function(){mm.classList.add('open')});mmx.addEventListener('click',function(){mm.classList.remove('open')});}
  document.querySelectorAll('.pw-opt').forEach(function(el){
    el.addEventListener('click',function(){
      document.querySelectorAll('.pw-opt').forEach(function(o){o.classList.remove('sel')});
      el.classList.add('sel');
      document.getElementById('cur-price').textContent=el.dataset.price;
      var ct=document.getElementById('cur-type');
      if(ct)ct.textContent=el.dataset.type+fromSuffix;
    });
  });
  document.querySelectorAll('.pw-btn').forEach(function(el){
    el.addEventListener('click',function(){window.open(el.dataset.href,'_blank');});
  });
  function updateTs(){
    var now=new Date();
    var d=now.toLocaleDateString(tsLocale,{day:'numeric',month:'short',year:'numeric'});
    var t=String(now.getHours()).padStart(2,'0')+':'+String(now.getMinutes()).padStart(2,'0');
    var el=document.getElementById('price-ts');
    if(el)el.textContent=tsLabel+d+' '+t;
  }
  updateTs();setInterval(updateTs,60000);
  var io=new IntersectionObserver(function(entries){
    entries.forEach(function(e){if(e.isIntersecting){e.target.style.animation='fadeUp .65s ease forwards';io.unobserve(e.target);}});
  },{threshold:0.08});
  document.querySelectorAll('.fade-up').forEach(function(el){io.observe(el);});
  var bo=new IntersectionObserver(function(entries){
    entries.forEach(function(e){if(e.isIntersecting){e.target.querySelectorAll('.rbar-fill').forEach(function(b){var w=b.style.width;b.style.width='0';setTimeout(function(){b.style.width=w;},120);});bo.unobserve(e.target);}});
  },{threshold:0.3});
  document.querySelectorAll('.rating-box').forEach(function(el){bo.observe(el);});
})();
</script>
</body>
</html>
