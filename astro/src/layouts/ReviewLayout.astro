---
import '../styles/review.css';
import Analytics from '../components/Analytics.astro';
import Shell from '../components/Shell.astro';
import editorial from '../data/editorial.json';
import webpManifest from '../data/webp-manifest.json';
import { localizedSlugSet, ROOT_ONLY_SLUGS } from '../lib/locales';
import { stampAffiliate } from '../lib/affiliate';

interface Props {
  // Raw JSON entry, read from disk by the route (src/lib/content-fs.ts). Shape is enforced before the
  // build by _internal/qa/validate-content.mjs against reviewSchema in src/lib/schemas.mjs.
  data: any;
  lang?: 'th' | 'en' | 'zh' | 'ru' | 'ko' | 'ja' | 'hi' | 'he' | 'ar';
  availableLocales?: string[];
}
const { data, lang = 'th', availableLocales } = Astro.props;
const isTh = lang === 'th';
const isEn = !isTh;   // legacy flag: "not Thai" — chrome text not covered by a language-specific S block falls back to English (established site convention)
const isRtl = lang === 'he' || lang === 'ar';
const pfx = isTh ? '' : `/${lang}`;
// slugs that have an in-locale page (localized content + hub) — link() routes to /<loc>/ only when the
// target exists there, else /en/ (avoids /<loc>/<slug> 404s for TH/EN-only cross-links). null for th/en.
const localSlugs = (!isTh && lang !== 'en') ? await localizedSlugSet(lang) : null;
const enSlugs = localSlugs ? await localizedSlugSet('en') : null;   // /en/ pages vs root-only (/trip)
const LOCS = (availableLocales && availableLocales.length) ? availableLocales : (isTh ? ['th', 'en'] : ['th', 'en']);
const OG_LOCALE: Record<string, string> = { th: 'th_TH', en: 'en_US', zh: 'zh_CN', ru: 'ru_RU', ko: 'ko_KR', ja: 'ja_JP', hi: 'hi_IN', he: 'he_IL', ar: 'ar_AR' };
const LANGNAME: Record<string, string> = { th: 'ไทย', en: 'English', zh: '中文', ru: 'Русский', ko: '한국어', ja: '日本語', hi: 'हिन्दी', he: 'עברית', ar: 'العربية' };
const locHref = (l: string) => (l === 'th' ? `/${data.slug}` : `/${l}/${data.slug}`);

const SITE = 'https://thailandaddict.com';
const IMG_BASE = import.meta.env.PUBLIC_IMG_BASE || 'https://pub-65cf98dcb15e4c06a7a465ec411b870a.r2.dev';   // R2 public bucket (override via PUBLIC_IMG_BASE env)
const base = `${SITE}${pfx}`;
const url = `${base}/${(data as any).canonicalSlug || data.slug}`;
const imgAbs = `${IMG_BASE || SITE}/${data.image}`;
// Prefer a real per-review date over the shared fallback — every review otherwise showed the identical stamp.
// NOTE: this fallback is a SITE date, not a per-hotel check date. It may format a stamp, but it must never be
// used to assert that THIS review was re-checked — see `_modDate` below, which gates every such claim.
const today = (data as any).modifiedDate || '2026-05-17';
// Honest static "last checked" stamp from the content date (was a live new Date() clock that falsely implied a real-time price check).
const _tdParts = today.split('-');
const TS_MON_TH = ['ม.ค.','ก.พ.','มี.ค.','เม.ย.','พ.ค.','มิ.ย.','ก.ค.','ส.ค.','ก.ย.','ต.ค.','พ.ย.','ธ.ค.'];
const TS_MON_EN = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const priceTs = (isTh ? TS_MON_TH : TS_MON_EN)[(+_tdParts[1] || 1) - 1] + ' ' + _tdParts[0];

// Honest "last updated" chip (LOCKED editorial rule — never fabricate a "verified on <date>" claim):
// show a real "last checked" date ONLY when the review actually carries a modifiedDate; otherwise show a
// neutral price-estimate disclaimer. `today`/`priceTs` above fall back to a shared site date, so they must
// never be used to assert that THIS hotel's price was re-checked.
// th/en/ru are hand-written; every other locale falls back to English (the isEn = !isTh chrome convention).
const _modDate = (data as any).modifiedDate;
const UPDATE_CHIP_EN = _modDate
  ? `📅 Last checked ${_modDate}`
  : '📅 Prices shown are estimates — tap a link below for live pricing &amp; availability';
const UPDATE_CHIP: Record<string, string> = {
  th: _modDate
    ? `📅 ตรวจสอบข้อมูลล่าสุด ${_modDate}`
    : '📅 ราคาที่แสดงเป็นราคาโดยประมาณ กดลิงก์ด้านล่างเพื่อดูราคาจริงและห้องว่างล่าสุด',
  ru: _modDate
    ? `📅 Последняя проверка ${_modDate}`
    : '📅 Указанные цены ориентировочные — актуальную цену и наличие смотрите по ссылке ниже',
  en: UPDATE_CHIP_EN, zh: UPDATE_CHIP_EN, ko: UPDATE_CHIP_EN,
  ja: UPDATE_CHIP_EN, hi: UPDATE_CHIP_EN, he: UPDATE_CHIP_EN, ar: UPDATE_CHIP_EN,
};
const updateChipHtml = UPDATE_CHIP[lang] || UPDATE_CHIP_EN;

// Internal-link helper: Thai keeps the raw href, every other locale gets its
// own prefix (/en/, /zh/, /ru/...) and the .html suffix stripped (clean URL).
// Same robust form as RoundupLayout: strip any already-present locale prefix and normalise the leading
// slash before adding a single prefix, so inputs stored as "/en/review-x", "/review-x" or "review-x.html"
// never produce a /en//en/… double-prefix or //double-slash broken link. (Was diverged from RoundupLayout.)
const ALL_LOCS = ['en', 'zh', 'ru', 'ko', 'ja', 'hi', 'he', 'ar'];
const link = (h: string) => {
  if (h === '/' || h === '') return isTh ? '/' : `${pfx}/`;
  if (/^(https?:)?\/\//.test(h) || h.startsWith('#')) return h;
  if (isTh) return h.replace(/\.html$/, '');   // clean URL — no .html→extensionless 307 redirect
  let p = h.replace(/\.html$/, '');
  for (const l of ALL_LOCS) p = p.replace(new RegExp(`^/${l}/`), '/');
  if (!p.startsWith('/')) p = '/' + p;
  if (ROOT_ONLY_SLUGS.has(p.slice(1).split(/[#?]/)[0])) return p;   // /trip etc. — root only, never locale-prefixed
  if (lang === 'en') return pfx + p;                          // pfx = /en
  const slug = p.slice(1).split(/[#?]/)[0];                   // in-locale page only if it exists, else /en
  return (localSlugs && localSlugs.has(slug) ? pfx : (enSlugs && enSlugs.has(slug) ? '/en' : '')) + p;
};

// Asset (image) helper: force a root-absolute path so images resolve
// correctly from both / (Thai) and /en/ (English) pages.
const asset = (p: string) => (!p ? p : (/^(https?:)?\/\//.test(p) ? p : IMG_BASE + (/^\//.test(p) ? p : `/${p}`)));
// Serve a webp twin when one exists (pilot: top 150 most-referenced images site-wide — see
// _internal/DEVELOPMENT-PLAN-v4-revenue.md). Gated on the manifest so unconverted images render exactly as before.
const hasWebp = (p: string) => !!(p && (webpManifest as Record<string, number>)[String(p).replace(/^\//, '')]);
const webpOf = (p: string) => p.replace(/\.(jpg|jpeg|png)$/i, '.webp');

// Booking.com (Thailand publishers) pays ONLY via CJ (Commission Junction) — the legacy ?aid= programme
// does not credit. Content JSON keeps canonical booking.com URLs; rather than baking a CJ deep link into
// every rendered page, we route through the /go/b worker route: the affiliate ids live in ONE place
// (worker.js), so a CJ programme/format change is a 10-line edit there — not a 13,000-page rebuild.
// worker.js validates the destination host (open-redirect guard) and 302s to the CJ click URL.
// sid = locale + page slug → CJ Reports "Performance by SID" shows exactly which page earned each booking.
const cjSid = ((isTh ? '' : lang + '-') + String(data.slug || 'site')).replace(/[^a-zA-Z0-9_-]/g, '').slice(0, 60);
// Every outbound link goes through here: tag OTA urls first, then route Booking.com through CJ.
const goB = (u: string) => {
  const t = stampAffiliate(u);
  return t && String(t).includes('booking.com') ? '/go/b?u=' + encodeURIComponent(t) + '&sid=' + encodeURIComponent(cjSid) : t;
};

// Domain-aware booking buttons (honesty-first): the label must match where the link actually goes.
// A minority of rural stays are not on any OTA and carry their real channel (Facebook page / own site /
// Traveloka / Trivago) in the booking fields — label each by its destination and de-duplicate identical
// hrefs. OTA hotels render exactly as before (Agoda / Booking.com / Trip.com). `S` is defined below and
// only read at render time (after init), so referencing it here is safe.
const REAL_OTA = /(agoda\.com|booking\.com|trip\.com|traveloka)/;
const bookButtons = (d: any) => {
  const out: any[] = [], seen = new Set();
  for (const u of [d.bookingAgoda, d.bookingBooking, d.bookingTrip]) {
    if (!u) continue;
    let b;
    if (/agoda\.com/.test(u))         b = { href: goB(u), brand: 'Agoda',       cls: 'agoda',   mark: 'a',  markCls: 'pw-mark r' };
    else if (/booking\.com/.test(u))  b = { href: goB(u), brand: 'Booking.com', cls: 'booking', mark: 'B.', markCls: 'pw-mark sq' };
    else if (/trip\.com/.test(u))     b = { href: goB(u), brand: 'Trip.com',    cls: 'trip',    mark: 't',  markCls: 'pw-mark sq' };
    else {
      const brand = /facebook\.com/.test(u) ? (S as any).btnFacebook
                  : /tripadvisor/.test(u)   ? 'Tripadvisor'
                  : /trivago/.test(u)       ? 'Trivago'
                  : /choowap/.test(u)       ? 'Choowap'
                  : /traveloka/.test(u)     ? 'Traveloka'
                  : (S as any).btnDirect;
      b = { href: u, brand, cls: 'trip', mark: '↗', markCls: 'pw-mark sq' };
    }
    if (seen.has(b.href)) continue;
    seen.add(b.href);
    out.push(b);
  }
  return out;
};
const hasRealOTA = [data.bookingAgoda, data.bookingBooking, data.bookingTrip].some((u: string) => u && REAL_OTA.test(u));

// Browser-tab title: lead with the hotel name so the tab is identifiable.
// Many titles are benefit-led with the hotel name buried at the end — the tab
// truncates before reaching it. Reorder to "{name} — {hook} | ThailandAddict",
// dropping the trailing segment that already carries the name to avoid repeats.
const tabTitle = (() => {
  const raw = (data.title || data.name || '').trim();
  const brand = /\|\s*ThailandAddict\s*$/i.test(raw) ? ' | ThailandAddict' : '';
  const core = raw.replace(/\s*\|\s*ThailandAddict\s*$/i, '').trim();
  const baseName = (data.name || '').replace(/\s*[\(（].*?[\)）]\s*$/, '').trim();
  if (!baseName || core.startsWith(baseName)) return core + brand;
  const parts = core.split(' — ');
  const hookParts = parts.filter((p) => !p.includes(baseName));
  const hook = (hookParts.length ? hookParts : parts).join(' — ');
  return `${baseName} — ${hook}${brand}`;
})();

// AEO answer block — derive an extractable, Speakable answer from structured data when no hand-written quickAnswerHtml.
const _qaCat = (isEn ? (data.typeEn || '') : (data.type || '')).trim();
const _qaPrice = data.qiPrice || data.priceRange || '';
const _qaUnit = isEn ? (String(data.qiPriceUnit || '').includes('คืน') ? '/night' : (data.qiPriceUnit || '')) : (data.qiPriceUnit || '');
const _derivedQA = (data.name && Number(data.score) > 0)
  ? (isEn
      ? `<strong>${data.name}</strong>${_qaCat ? ` · ${_qaCat}` : ''} · ${data.score}/10 guest review score${_qaPrice ? ` · from ${_qaPrice}${_qaUnit}` : ''}`
      : `<strong>${data.name}</strong>${_qaCat ? ` · ${_qaCat}` : ''} · คะแนนรีวิวรวม ${data.score}/10${_qaPrice ? ` · ราคาเริ่ม ${_qaPrice}${_qaUnit}` : ''}`)
  : '';
const qaHtml = (data as any).quickAnswerHtml || _derivedQA;

// EEAT — named editor (gated: falls back to the Organization author until editorial.json holds a real name).
const _ed = (editorial as any).editor || {};
const hasEditor = !!String(_ed.name || _ed.nameEn || '').trim();
const _edName = (isEn ? (_ed.nameEn || _ed.name) : (_ed.name || _ed.nameEn)) || '';
const _edRole = (isEn ? (_ed.roleEn || _ed.role) : (_ed.role || _ed.roleEn)) || '';
const authorNode: any = hasEditor
  ? { '@type': 'Person', name: _edName, jobTitle: _edRole, url: `${base}/about`, worksFor: { '@id': `${SITE}/#org` },
      ...(String(_ed.image || '').trim() ? { image: asset(_ed.image) } : {}),
      ...(Array.isArray(_ed.sameAs) && _ed.sameAs.length ? { sameAs: _ed.sameAs } : {}) }
  : { '@type': 'Organization', name: 'ThailandAddict Editorial', url: SITE };
const bylineName = hasEditor ? (isEn ? `Reviewed by ${_edName}` : `รีวิวโดย ${_edName}`) : '';

// UI strings
