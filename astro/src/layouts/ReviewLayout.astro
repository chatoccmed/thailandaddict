const ratingCountText = isEn
  ? `Based on ${data.ratingCount}+ reviews`
  : `รวม ${data.ratingCount}+ รีวิว`;
const guestH2 = isEn ? 'Summary from <em>Booking &amp; Agoda</em>' : 'สรุปจาก <em>Booking &amp; Agoda</em>';

// ── Interleave the review's own photos through the body, so the long review
// text isn't a wall of words. We reuse the images the review already ships
// (no new data needed): gallery shots first, then the hero sub-images and the
// map thumb. Images are de-duplicated, so the same photo is never repeated in
// the body, and we only interleave when there are at least 2 distinct photos.
const bodyImgPool = [...new Set([
  ...(data.gallery ?? []),
  data.heroSub2, data.heroSub1, data.mapImg,
].filter(Boolean))];
const altForBodyImg = (src) => {
  const gi = (data.gallery ?? []).indexOf(src);
  if (gi >= 0 && data.galleryAlts?.[gi]) return data.galleryAlts[gi];
  if (src === data.heroSub1 && data.galleryAlts?.[0]) return data.galleryAlts[0];
  if (src === data.heroSub2 && data.galleryAlts?.[1]) return data.galleryAlts[1];
  return data.name;
};
const bodyFlow = [];
{
  const blocks = data.body ?? [];
  const canImg = bodyImgPool.length >= 2 && blocks.length >= 3;
  // roughly one photo every two paragraphs, capped by how many distinct photos exist
  const nImgs = canImg ? Math.min(bodyImgPool.length, Math.max(1, Math.floor(blocks.length / 2))) : 0;
  const afterIdx = new Set();
  for (let i = 1; i <= nImgs; i++) {
    let a = Math.round((i * blocks.length) / (nImgs + 1)) - 1; // 0-based block to insert AFTER
    a = Math.min(Math.max(a, 0), blocks.length - 2);           // never after the final block
    afterIdx.add(a);
  }
  let pi = 0;
  blocks.forEach((b, idx) => {
    bodyFlow.push({ kind: b.kind, html: b.html });
    if (afterIdx.has(idx) && pi < bodyImgPool.length) {
      const src = bodyImgPool[pi++];
      bodyFlow.push({ kind: 'img', src, alt: altForBodyImg(src) });
    }
  });
}

