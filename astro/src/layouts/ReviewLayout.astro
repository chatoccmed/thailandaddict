const favSvg = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%2306B6D4'/%3E%3Ctext x='50' y='66' font-family='Georgia,serif' font-size='58' font-weight='bold' fill='white' text-anchor='middle'%3EW%3C/text%3E%3C/svg%3E";

/* ===========================================================================
   APP SHELL (blueprint §4.0 · §4.1 · §4.2 · §4.3 · §4.8)

   One header, one tab bar, one rail, one footer, one icon sprite, all of them
   emitted by _internal/lib/chrome.mjs through <Shell/> — the same module
   _internal/gen-hubs.mjs consumes, so this layout and the ~476 hub snapshots
   cannot drift apart again. That drift is how the audit found five navs.

   THIS STAGE MOVES MARKUP, NEVER WORDS. Every string below already exists in
   the S table above, in all nine locales; nothing is re-keyed and nothing is
   translated here.
   ======================================================================== */

/* Destinations go through link(), never chrome.mjs's raw defaults: link() owns
   the clean-URL rewrite, the ROOT_ONLY_SLUGS rule (/trip must never become
   /en/trip) and the per-locale availability fallback. chrome.mjs's default
   /saved does not exist yet — blueprint §5.7 builds it — so the Saved row
   points at the my-list page that ships today. */
const shellHref = {
  home: link('/'),
  places: link(data.regionHref ?? 'country-thailand.html'),
  search: link('search.html'),
  trip: link('/trip'),
  saved: link('my-list.html'),
  nearMe: link('near-me.html'),
};

/* chrome.mjs ships shell labels for th + en only; the other seven fall back to
   English until blueprint §7d. This layout ALREADY owns three of those words in
   all nine locales, so hand them over rather than let a zh/ru/ko reader meet an
   English topbar. Each is an existing string kept on its existing destination:
   mmHome -> the / tab, navDest -> the destinations tab. `trip` is the exact
   literal the deleted nav and drawer used, so the wording does not move either. */
const shellLabels = {
  explore: S.mmHome,
  places: S.navDest,
  trip: isEn ? 'Plan trip' : 'วางแผนทริป',
};

/* Footer copy is this layout's own S table, verbatim. chrome.mjs would
   otherwise fall back to ui.<lang>.json, whose wording differs — and copy is
   frozen until blueprint §7d. Dropped in the swap: four placeholder social
   links that all pointed at "#", and the duplicate Privacy / Editorial Policy
   pair in the bottom strip, which the About column already carries.
   The header CTA the shell has no slot for is kept as a real <a> in the
   Content column: same href, same cid=1965862, same translated label, now with
   rel="sponsored" instead of <button onclick="window.open(...)">. */
const shellFooter = {
  tagline: 'Thailand, Done Right',
  blurb: S.ftDesc,
  columns: [
    { title: S.ftDest, links: [
      { href: link(data.regionHref ?? 'country-thailand.html'), label: data.regionLabel ?? '🇹🇭 Thailand' },
      { href: link(data.countryHref ?? 'country-thailand.html'), label: data.countryLabel ?? '🇹🇭 Thailand' },
    ] },
    { title: S.ftContent, links: [
      { href: link(data.parentHref), label: data.parentShort },
      { href: link(data.crumbCityHref ?? 'country-thailand.html'), label: data.crumbCityName ?? 'เที่ยวไทย' },
      { href: link(data.countryHref ?? 'country-thailand.html'), label: data.countryGuideLabel ?? 'Thailand Guide' },
      { href: 'https://www.agoda.com/?cid=1965862', label: S.navCta, rel: 'sponsored nofollow noopener' },
    ] },
    { title: S.ftAbout, links: [
      { href: link('about.html'), label: 'About ThailandAddict' },
      { href: link('editorial-policy.html'), label: 'Editorial Policy' },
      { href: link('contact.html'), label: 'Contact' },
      { href: link('privacy.html'), label: 'Privacy Policy' },
    ] },
  ],
  legal: S.ftAff,
  note: S.ftBottom,
};

/* THE REVIEW-PAGE HOOK IS `rv-page`, NOT `rl-page` (§4.3, shell.css §9).
   `rl-page` was already taken twice before the shell existed:
     astro/src/styles/roundup.css  `.rl-page .hero`, `.rl-page .hero-sub`
     astro/public/css/premium.css  `.rl-page .quick-answer`, the hero word-mask
   In both it means "ROUNDup Layout page". Astro bundles review.css and
   roundup.css into ONE stylesheet that every [slug] page links, so putting
   `rl-page` on a review page's <html> would let
   `.rl-page .hero{display:flex;height:60vh}` (0,2,0) beat review.css's
   `.hero{height:86vh}` (0,1,0) and collapse the three-tile hero on ~7,200
   pages — silently, with nothing in any log. shell.css answers to both names.
   It goes on <html>, not <body>: shell.css's rule is `.rv-page body`. */

/* tab:null — a hotel review is not one of the five tab destinations, so no
   control in the bar gets aria-current. kind:'review' is what takes the
   bottom-edge exception of §4.3: the tab bar is suppressed by `html.rv-page`
   and .ta-cta owns the bottom edge with Save merged in beside the OTA cards. */
const shellCtx = {
  locale: lang,
  dir: isRtl ? 'rtl' : 'ltr',
  tab: null,
  kind: 'review',
  path: locHref(lang),
  brand: 'ThailandAddict',
  labels: shellLabels,
  // availability-driven — exactly the locales the old flag bar listed, no more.
  locales: LOCS.map((l) => ({ code: l, href: locHref(l), label: LANGNAME[l] || l })),
  href: shellHref,
  footer: shellFooter,
  railHref: link('/trip'),
};
---
<!DOCTYPE html>
<html lang={lang} dir={isRtl ? 'rtl' : 'ltr'} class="rv-page">
<head>
<meta charset="UTF-8" />
<Analytics />
{/* The shell head: viewport-fit=cover (without it every env(safe-area-inset-*)
    is 0 and the bottom-edge contract silently collapses), the light + dark
    theme-color pair shell.js keeps in step with the theme, the hashed
    shell.<hash>.css / shell.<hash>.js pair read from shell-manifest.json, the
    pagereveal direction script and the speculation rules — which exclude /go/*
    and rel=sponsored, so no affiliate click is ever fired by a prerender.
    It also carries the fonts, which is why the two render-blocking
    fonts.googleapis.com stylesheet links that used to sit below are gone. */}
<Shell part="head" ctx={shellCtx} />
<title>{tabTitle}</title>
<meta name="description" content={data.metaDesc} />
<meta name="keywords" content={data.keywords} />
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
<link rel="canonical" href={url} />
{LOCS.map((l) => <link rel="alternate" hreflang={l} href={`${SITE}${l === 'th' ? '' : '/' + l}/${data.slug}`} />)}
<link rel="alternate" hreflang="x-default" href={`${SITE}/${data.slug}`} />
<meta property="og:title" content={data.ogTitle} />
<meta property="og:description" content={data.ogDesc} />
<meta property="og:url" content={url} />
<meta property="og:type" content="article" />
<meta property="og:site_name" content="ThailandAddict" />
<meta property="og:image" content={imgAbs} />
<meta property="og:locale" content={OG_LOCALE[lang] || 'th_TH'} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={`${data.name} ${S.twSuffix}`} />
<meta name="twitter:description" content={data.twDesc} />
<link rel="preconnect" href={IMG_BASE} crossorigin />
<link rel="icon" type="image/svg+xml" href={favSvg} />
<link rel="preload" as="image" href={hasWebp(data.heroImg) ? asset(webpOf(data.heroImg)) : asset(data.heroImg)} fetchpriority="high" />
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<style>
/* The flag bar is gone (blueprint §4.8). It shipped nine 24px targets — under the
   44px floor — inside a 38,023-byte base64 stylesheet triplicated across the three
   layouts, and it degraded to bare letters on platforms with no regional-indicator
   glyphs. The switcher is now the .lang-menu popover in the shell, keyed on language
   NAMES and built from the same availability-driven LOCS list. The flag SVGs also
   still exist at /images/flags/*.svg if they are ever wanted again. */
/* FAQ section — placed after main review body, before footer */
.rv-faq{background:linear-gradient(180deg,#ffffff 0%,#f1fbfd 100%);padding:54px 24px 60px;border-top:1px solid #e6eef2}
.rv-faq-wrap{max-width:880px;margin:0 auto}
.rv-faq-title{font-family:'Outfit',sans-serif;font-size:32px;font-weight:800;color:#0F172A;line-height:1.2;margin-bottom:26px;text-align:center}
@media(max-width:560px){.rv-faq{padding:38px 18px 44px}.rv-faq-title{font-size:24px;margin-bottom:18px}}
.rv-faq-list{display:flex;flex-direction:column;gap:12px}
.rv-faq-item{background:#ffffff;border:1px solid #e6eef2;border-radius:18px;padding:0;overflow:hidden;transition:box-shadow .2s,border-color .2s}
.rv-faq-item[open]{border-color:#06B6D4;box-shadow:0 8px 24px rgba(6,182,212,.18)}
.rv-faq-q{cursor:pointer;list-style:none;padding:18px 22px;display:flex;align-items:center;justify-content:space-between;gap:14px;font-family:'Sarabun','Outfit',sans-serif;font-size:16.5px;font-weight:600;color:#0F172A;line-height:1.45}
.rv-faq-q::-webkit-details-marker{display:none}
.rv-faq-q-text{flex:1}
.rv-faq-q-icon{font-family:'Outfit',sans-serif;font-size:22px;font-weight:300;color:#06B6D4;flex-shrink:0;transition:transform .25s}
.rv-faq-item[open] .rv-faq-q-icon{transform:rotate(45deg)}
.rv-faq-a{padding:0 22px 20px;font-family:'Sarabun',sans-serif;font-size:15.5px;line-height:1.75;color:#64748b}
.rv-faq-a strong{color:#0F172A}
.rv-faq-a a{color:#06B6D4;text-decoration:underline;text-underline-offset:2px}
.rv-faq-a a:hover{color:#0891b2}
@media(max-width:560px){.rv-faq-q{padding:15px 18px;font-size:15.5px}.rv-faq-a{padding:0 18px 16px;font-size:14.5px}}
/* Inline body photos — break up the long review text */
.rv-body-fig{margin:30px 0;border-radius:18px;overflow:hidden;box-shadow:var(--sh);background:#e6eef2}
.rv-body-fig .rv-body-img{width:100%;aspect-ratio:16/10;object-fit:cover;object-position:center;display:block}
.rv-body-fig figcaption{font-family:'Sarabun',sans-serif;font-size:12.5px;color:var(--sub);padding:9px 14px;background:#ffffff;border-top:1px solid var(--bdr);line-height:1.5}
@media(max-width:560px){.rv-body-fig{margin:22px 0}.rv-body-fig .rv-body-img{aspect-ratio:4/3}}
.rv-body-imgwrap{position:relative;display:block}
.rv-body-fig .rv-body-book{position:absolute;inset:0;z-index:2;display:flex;align-items:flex-end;justify-content:flex-end;padding:11px;text-decoration:none}
.rv-body-fig .rv-body-book span{background:rgba(255,255,255,.95);color:#06B6D4;font-family:'Outfit',sans-serif;font-size:11.5px;font-weight:800;padding:6px 12px;border-radius:999px;box-shadow:0 2px 10px rgba(6,182,212,.22);transition:transform .15s,box-shadow .2s}
.rv-body-fig .rv-body-book:hover span{transform:translateY(-2px);box-shadow:0 5px 16px rgba(0,0,0,.26)}
</style>
<!-- ad/monetization tag removed — add ThailandAddict's own here later -->
<link rel="stylesheet" href="/css/premium.css">
<script src="/js/premium-motion.js" defer></script>
</head>
<body>

{/* The old <nav class="nav"> and its slide-in .mm drawer are gone. Everything
    they carried lives on: Destinations and the review index are the shell
    topbar's Places tab and the footer Content column, About/Contact are the
    footer About column, the language flag bar is the §4.8 .lang-menu popover,
    and the "Find a Hotel" CTA is a real <a rel="sponsored"> in the footer.
    Nothing here is a literal chrome tag: every byte comes from chrome.mjs. */}
<Shell part="top" ctx={shellCtx} />

{/* One <main class="ta-main" id="main"> per document — the skip link's target,
    and the element whose padding-block-start clears the fixed topbar. The old
    inner <main> inside .page-body's grid is now <div class="rv-main">; a second
    <main> would have made the skip link ambiguous. */}
<main class="ta-main" id="main">
<div class="breadcrumb"><a href={link('/')}>{S.bcHome}</a> › <a href={link(data.crumbCityHref ?? 'country-thailand.html')}>{data.crumbCityName ?? S.bcTaiwan}</a> › <a href={link(data.parentHref)}>{data.parentShort}</a> › <span>{data.name}</span></div>

<!-- HERO -->
<div class="hero">
  <div class="hero-grid">
    <div class="hero-main">
      <a href={goB(data.bookingAgoda)} target="_blank" rel="noopener" class="rv-overlay"></a>
      {hasWebp(data.heroImg) ? (
        <picture>
          <source srcset={asset(webpOf(data.heroImg))} type="image/webp" />
          <img src={asset(data.heroImg)} alt={data.name} class="rv-fill" />
        </picture>
      ) : (
        <img src={asset(data.heroImg)} alt={data.name} class="rv-fill" />
      )}
      <div class="hero-main-ov"></div>
      {/* 44 reviews carry a photo credit for a hero image taken from the hotel's own site or an OTA.
          The data was authored to be shown and never was — ArticleLayout has rendered its equivalent
          all along. Sits above the whole-tile booking link so the credit stays clickable. */}
      {data.heroCredit && (
        <span class="rv-credit">
          {data.heroCreditHref
            ? <a href={goB(data.heroCreditHref)} target="_blank" rel="nofollow noopener" set:html={data.heroCredit} />
            : <span set:html={data.heroCredit} />}
        </span>
      )}
      <div class="hero-badges">
        <span class="htag mid">{data.badgeMid}</span>
        <span class="htag loc">{data.badgeLoc}</span>
      </div>
      <div class="hero-rating"><span class="s">★</span> {data.score} / 10</div>
      <div class="hero-info">
        <div class="hi-loc">{data.hiLoc}</div>
        <div class="hi-name">{data.name}</div>
        <div class="hi-tag">{data.hiTag}</div>
      </div>
    </div>
    <div class="hero-sub">
      <a href={goB(data.bookingAgoda)} target="_blank" rel="noopener" class="rv-overlay"></a>
      {hasWebp(data.heroSub1) ? (
        <picture><source srcset={asset(webpOf(data.heroSub1))} type="image/webp" />
          <img src={asset(data.heroSub1)} alt={data.galleryAlts?.[0] || data.name} class="rv-fill" />
        </picture>
      ) : (
        <img src={asset(data.heroSub1)} alt={data.galleryAlts?.[0] || data.name} class="rv-fill" />
      )}
    </div>
    <div class="hero-sub-2">
      <a href={goB(data.heroSub2Href)} target="_blank" rel="noopener nofollow sponsored" class="rv-overlay"></a>
      {hasWebp(data.heroSub2) ? (
        <picture><source srcset={asset(webpOf(data.heroSub2))} type="image/webp" />
          <img src={asset(data.heroSub2)} alt={data.galleryAlts?.[1] || data.name} class="rv-fill" />
        </picture>
      ) : (
        <img src={asset(data.heroSub2)} alt={data.galleryAlts?.[1] || data.name} class="rv-fill" />
      )}
      <a class="hero-more-btn" href="#gallery">{S.heroMore}</a>
    </div>
  </div>
</div>

<!-- Quick Info Bar -->
<div class="quick-bar">
  <div class="qi-row">
    <div class="qi">
      <div class="qi-lbl">{S.qiType}</div>
      <div class="qi-val qi-val-s">{data.qiType}</div>
    </div>
    <div class="qi">
      <div class="qi-lbl">{S.qiScore}</div>
      <div class="qi-val">{data.score} <small>/ 10</small></div>
    </div>
    <div class="qi">
      <div class="qi-lbl">{S.qiPrice}</div>
      <div class="qi-val">{data.qiPrice} <small>{data.qiPriceUnit}</small></div>
    </div>
    <div class="qi">
      <div class="qi-lbl">{S.qiRooms}</div>
      <div class="qi-val qi-val-xs">{data.qiRooms}</div>
    </div>
    <div class="qi">
      <div class="qi-lbl">{data.qiCol5Label}</div>
      <div class="qi-val qi-val-xs" set:html={data.qiCol5Value + (data.qiCol5Small ? ` <small>${data.qiCol5Small}</small>` : '')}></div>
    </div>
    <div class="qi">
      <a href="#book" class="btn-book">{S.qiBook}</a>
      <button class="btn-wish" data-slug={data.slug} data-name={data.name} data-img={asset(data.heroImg)} data-url={url} data-type="stay" data-city={data.cluster} data-province={data.crumbCityName} data-word={S.qiWish.replace(/^\S+\s/, '')} data-saved={S.qiWishSaved}>{S.qiWish}</button>
    </div>
  </div>
</div>

<!-- MAIN CONTENT -->
<div class="page-body">
<div class="rv-main">

  <div class="fade-up rv-gap-b">
    <div class="sec-label">{S.secReview}</div>
    <div class="update-chip" set:html={updateChipHtml}></div>
    <h1 class="sec-title" set:html={data.h1}></h1>
    <p class="review-intro" set:html={data.intro}></p>
  </div>

  {qaHtml && (
    <aside class="quick-answer rv">
      <span class="qa-eyebrow">{isEn ? 'Quick answer' : 'คำตอบสั้น ๆ'}</span>
      {(data as any).quickAnswerH2 && <h2>{(data as any).quickAnswerH2}</h2>}
      <div class="qa-body" set:html={qaHtml}></div>
    </aside>
  )}
  <style>
    .quick-answer{background:linear-gradient(180deg,#f1fbfd 0%,#ffffff 100%);border:1px solid #cbeef5;border-inline-start:5px solid #06B6D4;border-radius:18px;padding:20px 24px;margin:0 0 30px;box-shadow:0 8px 24px rgba(6,182,212,.10)}
    .qa-eyebrow{display:inline-block;font-family:'Outfit',sans-serif;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:#0891b2;font-weight:700;background:#fff;padding:3px 11px;border-radius:999px;border:1px solid #cbeef5;margin-bottom:10px}
    .quick-answer h2{font-family:'Outfit',sans-serif;font-size:21px;font-weight:800;color:#0F172A;line-height:1.25;margin-bottom:10px}
    .qa-body{font-size:15.5px;line-height:1.8;color:#0F172A}
    .qa-body strong{color:#0891b2;font-weight:700}
  </style>

  <div class="fade-up byline">
    <div class="byline-av">{hasEditor && String(_ed.image || '').trim()
      ? <img src={asset(_ed.image)} alt={_edName} loading="lazy" />
      : (hasEditor ? (_edName.trim()[0] || 'T') : 'T')}</div>
    <div>
      <div class="byline-name">{hasEditor ? bylineName : S.bylineName} <span class="byline-badge">{S.bylineBadge}</span></div>
      <div class="byline-text"><Fragment set:html={S.bylineText} /><a href={link('editorial-policy.html')}>{S.bylineLink}</a></div>
    </div>
  </div>

  <!-- Gallery -->
  <div class="gallery fade-up" id="gallery">
    <div class="sec-label" set:html={S.secGallery}></div>
    <div class="gal-main">
      <div class="gp main-gp">
        {hasWebp(data.heroImg) ? (
          <picture><source srcset={asset(webpOf(data.heroImg))} type="image/webp" />
            <img src={asset(data.heroImg)} alt={data.name} class="rv-fill" />
          </picture>
        ) : (
          <img src={asset(data.heroImg)} alt={data.name} class="rv-fill" />
        )}
        <a href={goB(data.bookingTrip)} target="_blank" rel="noopener nofollow sponsored" aria-label={data.name} class="rv-overlay"></a>
      </div>
      {data.gallery.map((g, i) => (
        <div class="gp">
          {hasWebp(g) ? (
            <picture><source srcset={asset(webpOf(g))} type="image/webp" />
              <img src={asset(g)} alt={data.galleryAlts?.[i] || data.name} class="rv-fill" />
            </picture>
          ) : (
            <img src={asset(g)} alt={data.galleryAlts?.[i] || data.name} class="rv-fill" />
          )}
          <a href={goB(data.bookingTrip)} target="_blank" rel="noopener nofollow sponsored" aria-label={data.name} class="rv-overlay"></a>
        </div>
      ))}
      <a class="gp-more" href={goB(data.bookingTrip)} target="_blank" rel="noopener nofollow sponsored">
        <div class="n">+30</div>
        <div>{S.galleryMore}</div>
      </a>
    </div>
  </div>

  <!-- Review Body -->
  <div class="fade-up rv-gap-t">
    <div class="sec-label">{S.secBody}</div>
    <div class="review-body">
      {bodyFlow.map((blk) => (
        blk.kind === 'quote'
          ? <div class="pull-quote"><p set:html={blk.html}></p></div>
          : blk.kind === 'img'
            ? (
              <figure class="rv-body-fig">
                <div class="rv-body-imgwrap">
                  <img class="rv-body-img" src={asset(blk.src)} alt={blk.alt} loading="lazy" />
                  <a class="rv-body-book" href={goB(data.bookingTrip)} target="_blank" rel="noopener nofollow sponsored" aria-label={data.name}><span>{S.imgBook}</span></a>
                </div>
                {blk.alt ? <figcaption>{blk.alt}</figcaption> : null}
              </figure>
            )
            : <p set:html={blk.html}></p>
      ))}
    </div>
  </div>

  <!-- Highlights -->
  <div class="highlights fade-up">
    {data.highlights.map((h) => (
      <div class="hl-card"><div class="hl-icon">{h.icon}</div><div class="hl-title">{h.title}</div><div class="hl-text">{h.text}</div></div>
    ))}
  </div>

  <!-- Rating -->
  <div class="rating-box fade-up">
    <div class="sec-label">{S.secRating}</div>
    <div class="rating-top">
      <div class="rating-big">
        <div class="r-num" set:html={data.score.toFixed(1).replace(/\.(\d)/, '.<span>$1</span>')}></div>
        <div class="r-stars">{Array.from({ length: data.starRating }).map(() => <span class="s">★</span>)}</div>
        <div class="r-out">{S.ratingOut}</div>
        <div class="r-count">{ratingCountText}</div>
      </div>
      <div class="r-bars">
        {data.ratingBars.map((b) => (
          <div class="rbar"><div class="rbar-lbl">{b.label}</div><div class="rbar-track"><div class="rbar-fill" style={`width:${b.width}%`}></div></div><div class="rbar-v">{b.value}</div></div>
        ))}
      </div>
    </div>
  </div>

  <!-- Platform Reviews -->
  <div class="fade-up">
    <div class="sec-label">{S.secGuest}</div>
    <h2 class="sec-title sec-title-s" set:html={guestH2}></h2>
    <div class="pr-grid">
      <div class="pr-card">
        <div class="pr-head">
          <div class="pr-logo-row">
            <div class="pr-logo booking">B.</div>
            <div><div class="pr-nm">Booking.com</div><div class="pr-ct">{S.prCount}</div></div>
          </div>
          <div class="pr-sc">{data.booking.score} <small>/ 10</small></div>
        </div>
        <div class="pr-pos-lbl">{S.prPros}</div>
        <ul class="pr-ul">
          {data.booking.pros.map((p) => <li><span class="ic-g">✓</span> {p}</li>)}
        </ul>
        <div class="pr-neg-lbl">{S.prCons}</div>
        <ul class="pr-ul">
          {data.booking.cons.map((c) => <li><span class="ic-n">!</span> {c}</li>)}
        </ul>
      </div>
      <div class="pr-card">
        <div class="pr-head">
          <div class="pr-logo-row">
            <div class="pr-logo agoda">A</div>
            <div><div class="pr-nm">Agoda</div><div class="pr-ct">{S.prCount}</div></div>
          </div>
          <div class="pr-sc">{data.agoda.score} <small>/ 10</small></div>
        </div>
        <div class="pr-pos-lbl">{S.prPros}</div>
        <ul class="pr-ul">
          {data.agoda.pros.map((p) => <li><span class="ic-g">✓</span> {p}</li>)}
        </ul>
        <div class="pr-neg-lbl">{S.prCons}</div>
        <ul class="pr-ul">
          {data.agoda.cons.map((c) => <li><span class="ic-n">!</span> {c}</li>)}
        </ul>
      </div>
    </div>
  </div>

  <!-- Honest Take -->
  <div class="fade-up rv-gap-t-s">
    <div class="sec-label">{S.secHonest}</div>
    <div class="ht-box">
      <div class="ht-head">
        <div class="ht-icon">🎯</div>
        <div class="ht-title" set:html={S.htTitle}></div>
      </div>
      <div class="ht-summary" set:html={'✅ <strong>' + data.honestSummary + '</strong>'}></div>
      <div class="ht-checks-lbl">{S.htChecksLbl}</div>
      <div class="ht-checks-sub">{S.htChecksSub}</div>
      <ul class="ht-list">
        {data.honestChecks.map((c) => <li><span class="ic">💡</span><span set:html={c}></span></li>)}
      </ul>
    </div>
  </div>

  <!-- Price Widget -->
  <div id="book" class="pw fade-up">
    <div class="pw-lbl"><span class="pw-dot"></span> {S.pwLbl}</div>
    <div class="pw-price-row">
      <div class="pw-price" id="cur-price">{data.rooms[0].price}</div>
      <div class="pw-per">{S.pwPer}</div>
    </div>
    <div class="pw-from" id="cur-type">{data.rooms[0].full}{S.pwFromSuffix}</div>
    <div class="pw-opts">
      {data.rooms.map((r, i) => (
        <div class={i === 0 ? 'pw-opt sel' : 'pw-opt'} data-price={r.price} data-type={r.full}>
          <div class="pw-opt-nm">{r.name}</div>
          <div class="pw-opt-pr">{r.price}</div>
        </div>
      ))}
    </div>
    <div class="pw-cta-h">{hasRealOTA ? S.pwCtaH : S.pwCtaDirect}</div>
    <div class="pw-btns">
      {bookButtons(data).map((b) => (
        <button class={`pw-btn ${b.cls}`} data-href={b.href}><span class="pw-brand"><span class={b.markCls}>{b.mark}</span>{b.brand}</span><small>{S.pwCheck}</small></button>
      ))}
    </div>
    {_modDate && <div class="pw-ts" id="price-ts">{S.tsLabel}{priceTs}</div>}
  </div>

  <!-- Tips -->
  <div class="fade-up rv-gap-t-s">
    <div class="sec-label">{S.secTips}</div>
    <div class="tips-grid">
      {data.tips.map((t) => (
        <div class="tip-card"><div class="tip-icon">{t.icon}</div><div class="tip-title">{t.title}</div><div class="tip-body">{t.body}</div></div>
      ))}
    </div>
  </div>

  {wc && (
  <div class="fade-up rv-wc">
    <div class="rv-wc-eyebrow">⚽ FIFA World Cup 2026</div>
    <h3>{isEn ? `Heading to ${wc.en} for the World Cup?` : `มา${wc.th}ช่วงฟุตบอลโลก 2026?`}</h3>
    <p>{isEn ? `${wc.en} is a 2026 host city — see our full World Cup guide (matches, where to stay, tickets, visa) plus how to reach ${wc.stn} on match day.` : `${wc.th}เป็นเมืองเจ้าภาพฟุตบอลโลก 2026 — ดูคู่มือฉบับเต็ม (แมตช์ ที่พัก ตั๋ว วีซ่า) พร้อมวิธีไปสนาม ${wc.stn} วันแข่ง`}</p>
    <div class="rv-wc-btns">
      <a href={link(`city-${data.cluster}-world-cup.html`)} class="rv-wc-btn">{isEn ? `📋 ${wc.en} World Cup guide →` : `📋 คู่มือ${wc.th} ฟุตบอลโลก →`}</a>
      <a href={link(`getting-to-${wc.st}.html`)} class="rv-wc-btn rv-wc-btn2">{isEn ? `🚆 Getting to ${wc.stn}` : `🚆 วิธีไป ${wc.stn}`}</a>
    </div>
  </div>
  )}

</div>

<!-- SIDEBAR -->
<aside class="rv-side">
  <div class="side-card">
    <div class="side-title">{S.sideInfo}</div>
    {data.info.map((row) => (
      <div class="info-row"><span class="ik">{row.k}</span><span class="iv">{row.v}</span></div>
    ))}
  </div>

  <div class="side-card">
    <div class="side-title">{S.sideLoc}</div>
    {data.mapImg &&
      <div class="map-thumb">
        <img src={asset(data.mapImg)} alt={S.mapAlt} class="rv-fill" />
      </div>}
    {/* No per-hotel map image? Link the address to the real coordinates rather than show a stand-in map. */}
    <div class="rv-mapaddr">
      {(!data.mapImg && data.lat && data.lng)
        ? <a href={`https://www.google.com/maps/search/?api=1&query=${data.lat},${data.lng}`} target="_blank" rel="nofollow noopener">📍 {data.mapAddr}</a>
        : data.mapAddr}
    </div>
    <div class="side-title rv-gap-t-xs">{S.sideNearby}</div>
    <ul class="nearby-list">
      {data.nearby.map((n) => (
        <li><span class="nb-n">{n.n}</span><span class="nb-d">{n.d}</span></li>
      ))}
    </ul>
  </div>

  <div class="side-card">
    <div class="side-title">{data.relatedTitle}</div>
    {data.related.map((rel) => (
      <a class="related-a" href={link(rel.href)}>
        <img class="rel-img" src={asset(rel.img)} alt={rel.name} />
        <div><div class="rel-name">{rel.name}</div><div class="rel-loc">{rel.loc}</div><div class="rel-price">{rel.price}</div></div>
      </a>
    ))}
  </div>
</aside>
</div>

{data.faq && data.faq.length > 0 && (
  <section class="rv-faq" aria-labelledby="rv-faq-h">
    <div class="rv-faq-wrap">
      <h2 id="rv-faq-h" class="rv-faq-title">{data.faqTitle || 'คำถามที่พบบ่อย'}</h2>
      <div class="rv-faq-list">
        {data.faq.map((item, i) => (
          <details class="rv-faq-item" name="rv-faq-acc" open={i === 0}>
            <summary class="rv-faq-q">
              <span class="rv-faq-q-text">{item.q}</span>
              <span class="rv-faq-q-icon" aria-hidden="true">＋</span>
            </summary>
            <div class="rv-faq-a" set:html={item.a} />
          </details>
        ))}
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    'mainEntity': data.faq.map((item) => ({
      '@type': 'Question',
      'name': item.q,
      'acceptedAnswer': { '@type': 'Answer', 'text': item.a.replace(/<[^>]+>/g, '') }
    }))
  })} />
)}

<!-- Article Footer (prev/next are optional — render placeholders keep the share row centred) -->
<div class="art-footer">
  {data.prevHref ? (
    <a class="af-link" href={link(data.prevHref)}>
      <div class="af-lbl">{data.prevLabel}</div>
      <div class="af-nm">{data.prevName}</div>
    </a>
  ) : <span class="af-link" aria-hidden="true"></span>}
  {/* data-share, not onclick="": same three destinations, same labels, now bound
      from the page's own script. Inline handlers are what block a strict
      script-src CSP (the audit counted 7,299 of them site-wide). */}
  <div class="share-row">
    <button class="share-btn" type="button" data-share="fb" title="แชร์ Facebook" aria-label="แชร์ Facebook">f</button>
    <button class="share-btn" type="button" data-share="x" title="แชร์ X" aria-label="แชร์ X">𝕏</button>
    <button class="share-btn" type="button" data-share="copy" title="คัดลอกลิงก์" aria-label="คัดลอกลิงก์">🔗</button>
  </div>
  {data.nextHref ? (
    <a class="af-link af-r" href={link(data.nextHref)}>
      <div class="af-lbl">{data.nextLabel}</div>
      <div class="af-nm">{data.nextName}</div>
    </a>
  ) : <span class="af-link af-r" aria-hidden="true"></span>}
</div>
</main>

{/* THE BOTTOM EDGE — blueprint §4.3, the review-page exception.
    Was <div class="rvbar">, one of FIVE fixed elements fighting for the bottom of
    the viewport. The container is now the shell's own .ta-cta, which owns
    position, --z-cta, the auto-hide (data-autohide, driven by shell.js) and the
    view-transition name; .rv-cta composes only what goes INSIDE it. html.rv-page
    suppresses the tab bar and re-bases --floor, so there is exactly one bar here
    and no z-index arithmetic. The .ta-tripfab is deleted outright and Save is
    merged in beside the booking buttons — which is what stops the FAB covering
    the Trip.com card, and puts Save where the decision is actually made. */}
<div class="ta-cta rv-cta" data-autohide>
  <div class="rv-top">
    <div class="rv-price">💰 <span class="rv-pf">{S.rvFrom}</span> <b>{data.qiPrice}</b><span class="rv-pu"> {data.qiPriceUnit}</span><span class="rv-ref">{S.rvRef}</span></div>
    <button class="btn-wish" data-slug={data.slug} data-name={data.name} data-img={asset(data.heroImg)} data-url={url} data-type="stay" data-city={data.cluster} data-province={data.crumbCityName} data-word={S.qiWish.replace(/^\S+\s/, '')} data-saved={S.qiWishSaved}>{S.qiWish}</button>
  </div>
  <div class="rv-cards">
    <a class="rv-card rv-ag" href={goB(data.bookingAgoda)} target="_blank" rel="noopener nofollow sponsored"><span class="rv-mark">a</span><span class="rv-tx"><b>Agoda</b><small>{S.rvAgoda} →</small></span></a>
    <a class="rv-card rv-bk" href={goB(data.bookingBooking)} target="_blank" rel="noopener nofollow sponsored"><span class="rv-mark">B.</span><span class="rv-tx"><b>Booking.com</b><small>{S.rvBooking} →</small></span></a>
    <a class="rv-card rv-tp" href={goB(data.bookingTrip)} target="_blank" rel="noopener nofollow sponsored"><span class="rv-mark">T</span><span class="rv-tx"><b>Trip.com</b><small>{S.rvTrip} →</small></span></a>
  </div>
</div>

{/* The site footer, the desktop Trip Rail, the tab bar (suppressed here by
    html.rv-page) and the popover/sheet host — all of them chrome.mjs' bytes.
    Dropped in the swap: four placeholder social links that all pointed at "#",
    and the duplicate Privacy / Editorial Policy pair in the bottom strip, which
    the About column already carries. */}
<Shell part="bottom" ctx={shellCtx} />

<script is:inline define:vars={{ tsLabel: S.tsLabel, tsLocale: S.locale, fromSuffix: S.pwFromSuffix }}>
(function(){
  // The #hb / #mm hamburger and its slide-in drawer are gone with the old nav:
  // the shell ships the bottom tab bar, the More popover and a topbar that
  // condenses itself (scroll-driven in Chromium, IntersectionObserver fallback
  // from shell.js).
  document.querySelectorAll('.pw-opt').forEach(function(el){
    el.addEventListener('click',function(){
      document.querySelectorAll('.pw-opt').forEach(function(o){o.classList.remove('sel')});
      el.classList.add('sel');
      document.getElementById('cur-price').textContent=el.dataset.price;
      var ct=document.getElementById('cur-type');
      if(ct)ct.textContent=el.dataset.type+fromSuffix;
    });
  });
  document.querySelectorAll('.pw-btn').forEach(function(el){
    el.addEventListener('click',function(){window.open(el.dataset.href,'_blank');});
  });
  /* price-ts is now rendered statically server-side (honest content-date stamp, not a live clock) */
  var io=new IntersectionObserver(function(entries){
    entries.forEach(function(e){if(e.isIntersecting){e.target.style.animation='fadeUp .65s ease forwards';io.unobserve(e.target);}});
  },{threshold:0.08});
  document.querySelectorAll('.fade-up').forEach(function(el){io.observe(el);});
  var bo=new IntersectionObserver(function(entries){
    entries.forEach(function(e){if(e.isIntersecting){e.target.querySelectorAll('.rbar-fill').forEach(function(b){var w=b.style.width;b.style.width='0';setTimeout(function(){b.style.width=w;},120);});bo.unobserve(e.target);}});
  },{threshold:0.3});
  document.querySelectorAll('.rating-box').forEach(function(el){bo.observe(el);});
  // Share row — one listener, replacing three inline onclick="" handlers.
  document.querySelectorAll('[data-share]').forEach(function(b){
    b.addEventListener('click',function(){
      var k=b.getAttribute('data-share'), u=encodeURIComponent(location.href);
      if(k==='fb'){window.open('https://www.facebook.com/sharer/sharer.php?u='+u,'_blank','noopener');return;}
      if(k==='x'){window.open('https://twitter.com/intent/tweet?url='+u,'_blank','noopener');return;}
      navigator.clipboard.writeText(location.href).then(function(){var o=b.textContent;b.textContent='✓';setTimeout(function(){b.textContent=o},1500)});
    });
  });
})();
</script>
<script is:inline>
(function(){
  // TWO save buttons now, not one: the quick-bar button and the copy merged into
  // .ta-cta by §4.3 (the FAB it replaces is gone). Same slug, same ta_wishlist
  // entry — so bind both and re-render both, or the bottom bar would go on saying
  // "เก็บลงแผน" after the top one had already saved.
  var KEY='ta_wishlist', btns=[].slice.call(document.querySelectorAll('.btn-wish'));
  if(!btns.length)return;
  var slug=btns[0].dataset.slug;
  function get(){try{return JSON.parse(localStorage.getItem(KEY)||'[]')}catch(e){return[]}}
  function has(){return get().some(function(x){return x.slug===slug})}
  function render(){var s=has();btns.forEach(function(b){b.classList.toggle('saved',s);b.innerHTML=s?b.dataset.saved:('🔖 '+b.dataset.word)})}
  render();
  btns.forEach(function(btn){
    btn.addEventListener('click',function(){
      var l=get(), added=!has();
      if(!added){l=l.filter(function(x){return x.slug!==slug})}
      else{l.push({slug:slug,name:btn.dataset.name,img:btn.dataset.img,url:btn.dataset.url,type:btn.dataset.type||'stay',city:btn.dataset.city||'',province:btn.dataset.province||''})}
      localStorage.setItem(KEY,JSON.stringify(l)); render();
      if(window.taSyncFab)window.taSyncFab();
      if(window.taPlanToast)window.taPlanToast(added,btn.dataset.name,l.length);
    });
  });
})();
</script>
<div id="taPlanToast" class="ta-plantoast" role="status" aria-live="polite"><span class="tpt-msg"></span><a href="/trip" class="tpt-link"></a></div>
<style>
/* Save-confirmation toast. The .ta-tripfab FAB that used to sit beside it is
   gone (§4.3): it was position:fixed at z-index 9000 over the bottom-right
   corner, which is exactly where .ta-cta puts the Trip.com card — untappable
   for anyone who had ever saved anything. The shell tab bar carries an
   always-present Trip badge instead, which is the affordance the FAB only
   revealed AFTER the first save, and Save itself is merged into .ta-cta.
   Already re-based on the bottom-edge contract and on logical properties, so
   the rule body below is unchanged. */
/* z-index is --z-popover, not the budget’s --z-toast (80), for one reason only:
   the legacy currency bar #cv-bar is still position:fixed at z-index 120 on this
   page and would clip a toast that sits at 80. Blueprint §4.3 moves #cv-bar into
   the More popover in Phase 3 — drop this back to var(--z-toast) then. */
/* TOPBAR CLEARANCE — the same re-declaration ArticleLayout carries, and for the
   same reason. This file's Astro reset compiles to an UNLAYERED
   `*, ::before, ::after { padding: 0 }`, and unlayered author CSS beats every
   @layer shell rule regardless of specificity, so shell.css's own
   `.ta-main { padding-block-start: … }` never landed here.

   Measured on production 2026-09-12 before the fix: computed padding 0px, and
   the breadcrumb plus the "🏆 อันดับ 1" badge row rendered at y=12 and y=68
   underneath a 72px fixed topbar, on every one of the 4,802 review URLs.
   ArticleLayout was given this block during the shell migration; Review and
   Roundup were not. Same tokens, same values, no new number. */
.ta-main{padding-block-start:calc(var(--topbar-rest) + var(--safe-t))}
.ta-plantoast{position:fixed;inset-inline:var(--sp-3);inset-block-end:calc(var(--floor) + var(--cta-h) + var(--sp-3));margin-inline:auto;transform:translateY(18px);z-index:var(--z-popover);display:flex;align-items:center;gap:12px;max-inline-size:min(92vw,430px);background:#0F172A;color:#fff;font-family:'Outfit',system-ui,sans-serif;font-size:14px;font-weight:600;padding:12px 16px;border-radius:14px;box-shadow:0 16px 40px -10px rgba(15,23,42,.6);opacity:0;visibility:hidden;transition:opacity .25s,transform .25s}
.ta-plantoast.show{opacity:1;visibility:visible;transform:translateY(0)}
.ta-plantoast .tpt-msg{flex:1;line-height:1.35;min-width:0}
.ta-plantoast .tpt-link{flex-shrink:0;background:linear-gradient(135deg,#06B6D4,#0891b2);color:#fff;text-decoration:none;font-weight:800;font-size:13px;padding:7px 13px;border-radius:999px;white-space:nowrap}</style>
<script>(function(){
  var KEY='ta_wishlist', EN=(document.documentElement.lang||'').slice(0,2).toLowerCase()==='en';
  function read(){try{return JSON.parse(localStorage.getItem(KEY)||'[]')}catch(e){return[]}}
  // The FAB is gone; its count moved to the shell's always-present Trip badge.
  // Same number, same source (ta_wishlist) — shell.js reads that legacy key too,
  // it just cannot know about a write this page made after it booted.
  window.taSyncFab=function(){
    var n=read().length, els=document.querySelectorAll('.ta-badge,[data-trip-count]');
    for(var i=0;i<els.length;i++){els[i].textContent=n;els[i].setAttribute('data-count',n);}
  };
  taSyncFab();
  var toast=document.getElementById('taPlanToast'),lk=toast&&toast.querySelector('.tpt-link'),tHide;
  if(lk)lk.textContent=EN?'View plan →':'ดูแผนเที่ยว →';
  window.taPlanToast=function(added,name,count){
    if(!toast)return;
    var nm=(name&&name.length>24)?name.slice(0,24)+'…':(name||(EN?'this place':'ที่นี่'));
    toast.querySelector('.tpt-msg').textContent=added?(EN?('✓ Saved “'+nm+'” to your plan ('+count+')'):('✓ เก็บ “'+nm+'” ลงแผนแล้ว ('+count+' ที่)')):(EN?('Removed “'+nm+'” from plan'):('เอา “'+nm+'” ออกจากแผนแล้ว'));
    lk.style.display=read().length?'inline-block':'none';
    toast.classList.add('show');clearTimeout(tHide);
    tHide=setTimeout(function(){toast.classList.remove('show')},added?3800:2600);
  };
})();</script>
<script src="/js/currency.js" defer></script>
</body>
</html>
