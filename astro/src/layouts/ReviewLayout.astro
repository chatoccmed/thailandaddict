  {wc && (
  <div class="fade-up" style="margin-top:34px;background:linear-gradient(135deg,#0891b2 0%,#06B6D4 100%);border-radius:22px;padding:26px 28px;color:#fff">
    <div style="font-family:'Outfit',sans-serif;font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#FBBF24;margin-bottom:8px">⚽ FIFA World Cup 2026</div>
    <h3 style="font-family:'Outfit',sans-serif;font-size:22px;font-weight:800;margin:0 0 8px;color:#fff;line-height:1.25">{isEn ? `Heading to ${wc.en} for the World Cup?` : `มา${wc.th}ช่วงฟุตบอลโลก 2026?`}</h3>
    <p style="font-size:14.5px;line-height:1.7;margin:0 0 16px;color:rgba(255,255,255,.9);max-width:640px">{isEn ? `${wc.en} is a 2026 host city — see our full World Cup guide (matches, where to stay, tickets, visa) plus how to reach ${wc.stn} on match day.` : `${wc.th}เป็นเมืองเจ้าภาพฟุตบอลโลก 2026 — ดูคู่มือฉบับเต็ม (แมตช์ ที่พัก ตั๋ว วีซ่า) พร้อมวิธีไปสนาม ${wc.stn} วันแข่ง`}</p>
    <div style="display:flex;gap:10px;flex-wrap:wrap">
      <a href={link(`city-${data.cluster}-world-cup.html`)} style="display:inline-block;background:#FB7185;color:#fff;font-family:'Outfit',sans-serif;font-size:13px;font-weight:700;padding:12px 22px;border-radius:12px">{isEn ? `📋 ${wc.en} World Cup guide →` : `📋 คู่มือ${wc.th} ฟุตบอลโลก →`}</a>
      <a href={link(`getting-to-${wc.st}.html`)} style="display:inline-block;background:rgba(255,255,255,.12);border:1.5px solid rgba(255,255,255,.5);color:#fff;font-family:'Outfit',sans-serif;font-size:13px;font-weight:700;padding:12px 22px;border-radius:12px">{isEn ? `🚆 Getting to ${wc.stn}` : `🚆 วิธีไป ${wc.stn}`}</a>
    </div>
  </div>
  )}

</main>

<!-- SIDEBAR -->
