---
/**
 * GA4 + Search Console. Shared across all Astro layouts (reviews/articles/roundups).
 * Same Measurement ID as _internal/gen-hubs.mjs (city hubs) and the standalone
 * homepage/trip static HTML files — update all of them together if this ever changes.
 */
const GA_ID = 'G-JDXCTEMMFB';
const SC_VERIFY = '';          // ← optional: Search Console <meta> verification token
const enabled = /^G-[A-Z0-9]{8,}$/.test(GA_ID) && !GA_ID.includes('XXXX');
---
{SC_VERIFY && <meta name="google-site-verification" content={SC_VERIFY} />}
{enabled && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','${GA_ID}',{anonymize_ip:true});
// affiliate-click tracking: any <a>/<button> to Agoda/Trip/Klook/12Go fires an outbound event
document.addEventListener('click',function(e){var a=e.target.closest('a[href],button[onclick]');if(!a)return;var u=(a.getAttribute('href')||a.getAttribute('onclick')||'');var m=u.match(/agoda|trip\\.com|klook|12go|getyourguide/i);if(m)gtag('event','affiliate_click',{partner:m[0].toLowerCase(),page_path:location.pathname});},true);`}></script>
  </>
)}
