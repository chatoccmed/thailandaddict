---
import { getCollection } from 'astro:content';
import ReviewLayout from '../../layouts/ReviewLayout.astro';
import RoundupLayout from '../../layouts/RoundupLayout.astro';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const reviews = await getCollection('reviewsRu');
  const roundups = await getCollection('roundupsRu');
  const articles = await getCollection('articlesRu');
  return [
    ...reviews.map((r) => ({
      params: { slug: r.data.slug },
      props: { kind: 'review' as const, data: r.data },
    })),
    ...roundups.map((r) => ({
      params: { slug: r.data.slug },
      props: { kind: 'roundup' as const, data: r.data },
    })),
    ...articles.map((r) => ({
      params: { slug: r.data.slug },
      props: { kind: 'article' as const, data: r.data },
    })),
  ];
}

const { kind, data } = Astro.props;
---
{kind === 'review'
  ? <ReviewLayout data={data} lang="ru" />
  : kind === 'roundup'
  ? <RoundupLayout data={data} lang="ru" />
  : <ArticleLayout data={data} lang="ru" />}
