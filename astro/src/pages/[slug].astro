---
// Thai pages, served at the site root. Reads its one entry from disk at render time —
// content collections were retired 2026-09-09 (_internal/BUILD-ROOTCAUSE-2026-09.md §5).
// props carry only what is needed to LOCATE the entry; putting `data` back in props
// re-materialises all 19,530 entries in memory and brings the build ceiling back.
import { slugsOf, readEntry } from '../lib/content-fs';
import ReviewLayout from '../layouts/ReviewLayout.astro';
import RoundupLayout from '../layouts/RoundupLayout.astro';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import { extraLocalesBySlug, extraReviewLocalesBySlug, extraRoundupLocalesBySlug } from '../lib/locales';

export async function getStaticPaths() {
  const enArt = new Set(slugsOf('articles-en'));
  const extra = await extraLocalesBySlug();
  const extraRv = await extraReviewLocalesBySlug();
  const extraRd = await extraRoundupLocalesBySlug();
  return [
    ...slugsOf('reviews').map((slug) => ({
      params: { slug },
      props: { kind: 'review' as const, dir: 'reviews', availableLocales: ['th', 'en', ...(extraRv[slug] || [])] },
    })),
    ...slugsOf('roundups').map((slug) => ({
      params: { slug },
      props: { kind: 'roundup' as const, dir: 'roundups', availableLocales: ['th', 'en', ...(extraRd[slug] || [])] },
    })),
    ...slugsOf('articles').map((slug) => ({
      params: { slug },
      props: { kind: 'article' as const, dir: 'articles', hasEn: enArt.has(slug),
        availableLocales: [...(enArt.has(slug) ? ['th', 'en'] : ['th']), ...(extra[slug] || [])] },
    })),
  ];
}

const { kind, dir, hasEn, availableLocales } = Astro.props;
const data = readEntry(dir, Astro.params.slug!);   // one entry live at a time
---
{kind === 'review' ? <ReviewLayout data={data} availableLocales={availableLocales} />
  : kind === 'roundup' ? <RoundupLayout data={data} availableLocales={availableLocales} />
  : <ArticleLayout data={data} hasEn={hasEn} availableLocales={availableLocales} />}
