# thailandaddict — Cloudflare Pages Headers
# https://developers.cloudflare.com/pages/configuration/headers/

# ── Global headers (ทุกหน้า) ──
# Cache-Control อยู่ตรงนี้ด้วย เพราะหน้าเสิร์ฟแบบ clean-URL (ไม่มี .html) — ถ้าพึ่งกฎ /*.html
# อย่างเดียวจะไม่ match แล้วได้ max-age=0. asset ที่มีนามสกุลเจาะจงด้านล่าง (.css/.js/.webp/.json)
# มีกฎเฉพาะที่ specific กว่า → override ค่านี้เสมอ
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  Content-Security-Policy: object-src 'none'; base-uri 'self'; frame-ancestors 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# ── HTML pages (คำขอที่มี .html ตรง ๆ) ──
/*.html
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Content-Type: text/html; charset=utf-8
# (JSON feeds/search-index inherit Cache-Control from the /* rule above — no separate /*.json
#  rule, otherwise both match and Cloudflare emits a duplicated Cache-Control header)

# ── Homepage ── cache 30 นาที ── (the site serves clean URLs, so the homepage is "/" not "/index.html";
#    the /index.html rule below never matched a real request — the "/" rule is the one that actually applies)
/
  Cache-Control: public, max-age=1800, stale-while-revalidate=3600
/index.html
  Cache-Control: public, max-age=1800, stale-while-revalidate=3600

# ── Sitemap + Robots — cache 1 วัน ──
/sitemap.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

# ── Hand-authored, STABLE-NAMED assets (premium.css/proto3.css/*-motion.js) ──
# These live under /css/ and /js/ with fixed filenames and DO change on redeploy, so they must
# NOT be immutable — otherwise a design change is invisible to returning visitors (and the edge)
# for up to a year. A more-specific path rule (/css/*, /js/*) overrides the /*.css /*.js wildcards
# below. Short fresh window + long SWR = fast, but a redeploy is picked up within the hour.
# (The content-hashed Astro bundles live under /_astro/ and correctly stay immutable via /*.css.)
/css/*
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

/js/*
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

# ── Static assets — cache 1 ปี (hashed bundles under /_astro/, images, fonts) ──
/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable
